<http://w3id.org/lambda/mdrepo/MDR00021021/workflow> a lambdaber:WorkflowRun ;
    lambdaber:description """MD simulation of Tyrosine-protein kinase JAK3 (Uniprot: P52333), in complex with a ligand. The simulation is based on the structure from PDB entry 3zc6.
This is part of a collection containing molecular dynamics simulations of 59 kinases both in their apo form and in complex with a total 220 ligands  (average of ~4 ligands per kinase). All-atom simulations were performed using GROMACS v2024 with the CHARMM36 force field (July 2020 version), and ligand parameters were generated with SwissParam. The protein was solvated in a periodic dodecahedron box with TIP3P water and neutralized with Na+/Cl− ions at 150 mM. Protonation states were assigned at pH 7 based on pKa values from propKa. Systems were energy minimized using the steepest descent algorithm for 5000 steps, followed by equilibration consisting of 1 ns with heavy-atom restraints (1000 kJ/mol/nm2) and 10 ns without restraints. Production simulations were carried out in the NPT ensemble for 500 ns in four replicates with different velocity seeds. A timestep of 2 fs was used, and coordinates were saved every 10 ps. Bonds involving hydrogens were constrained using LINCS. Electrostatics were treated with the Particle-Mesh Ewald method (grid spacing 0.12 nm, cubic interpolation), and van der Waals and electrostatic cutoffs were set to 1.0 nm. A long-range dispersion correction for energy and pressure was applied. Periodic boundary conditions were applied in all directions. The dataset also includes RMSD, RMSF, binding pocket analysis, kinase conformational states, residue-residue correlations, and distance measurements as detailed in the accompanying README_analysis.txt.""" ;
    lambdaber:md_simulation_params [ a lambdaber:MDSimulationParameters ;
            lambdaber:duration_ns [ a nmdc:QuantityValue ;
                    lambdaber:numeric_value "500.0"^^xsd:float ;
                    lambdaber:unit "ns" ] ;
            lambdaber:simulation_engine "GROMACS" ;
            lambdaber:simulation_engine_version "2024" ;
            lambdaber:temperature [ a nmdc:QuantityValue ;
                    lambdaber:numeric_value "300.0"^^xsd:float ;
                    lambdaber:unit "kelvin" ] ;
            lambdaber:timestep [ a nmdc:QuantityValue ;
                    lambdaber:numeric_value "2.0"^^xsd:float ;
                    lambdaber:unit "femtosecond" ] ;
            lambdaber:trajectory_output_interval [ a nmdc:QuantityValue ;
                    lambdaber:numeric_value "5000.0"^^xsd:float ;
                    lambdaber:unit "steps" ] ] ;
    lambdaber:processing_parameters "{\"contributor\": {\"first_name\": \"Amitava\", \"full_name\": \"Amitava Roy\", \"id\": 6, \"institution\": null, \"last_name\": \"Roy\", \"orcid\": \"0000-0002-9100-4108\", \"username\": \"amitroy\"}, \"creation_date\": \"2026-03-02T19:53:32.841361Z\", \"creators\": [{\"email\": \"amitava.roy@umontana.edu\", \"institution\": \"University of Montana\", \"name\": \"Amitava Roy\", \"orcid\": \"0000-0002-9100-4108\"}], \"duration\": 500.0, \"duration_unit\": \"ns (source entry value; may aggregate replicates)\", \"external_links\": [], \"forcefield\": \"CHARMM36\", \"forcefield_comments\": null, \"is_coarse_grained\": false, \"is_deprecated\": false, \"is_embargoed\": false, \"is_placeholder\": false, \"num_replicates\": 1, \"pdb\": {\"classification\": \"TRANSFERASE\", \"id\": 8098, \"num_simulations\": 0, \"pdb_id\": \"3zc6\", \"title\": \"Crystal structure of JAK3 kinase domain in complex with an indazole substituted pyrrolopyrazine inhibitor\"}, \"protonation_method\": \"PropKa\", \"pub\": [], \"run_commands\": \"gmx_mpi mdrun -s fname.tpr -deffnm fname -v -c fname.pdb -cpi fname.cpt -maxh clock_time -noappend -update gpu -bonded gpu -pme gpu -pmefft gpu -nb gpu\", \"sampling_frequency\": 0.01, \"sampling_frequency_unit\": \"ns between saved frames\", \"solutes\": [{\"concentration\": 0.15, \"name\": \"Na+\"}, {\"concentration\": 0.15, \"name\": \"Cl-\"}], \"source_url\": \"https://mdrepo.org/explore/MDR00021021\", \"superseding_simulation_id\": null, \"water_density\": null}" ;
    lambdaber:software_name "GROMACS" ;
    lambdaber:software_version "2024" ;
    lambdaber:workflow_code "MDR00021021" ;
    lambdaber:workflow_type "md_production" .
