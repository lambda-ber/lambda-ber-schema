@base <http://example.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lambdaber: <http://w3id.org/lambda/> .
@prefix nmdc: <https://w3id.org/nmdc/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lambdaber:exp_microed_lysozyme_001 a lambdaber:ExperimentRun ;
    dcterms:title "MicroED data collection from lysozyme nanocrystals" ;
    lambdaber:camera_length [ a nmdc:QuantityValue ;
            lambdaber:numeric_value "920.0"^^xsd:float ;
            lambdaber:unit "mm" ] ;
    lambdaber:description "Micro-electron diffraction data collection for atomic structure determination" ;
    lambdaber:experiment_code "PNNL-MICROED-LYS-2024-001" ;
    lambdaber:experiment_date "2024-07-10" ;
    lambdaber:operator_id "microed_specialist_001" ;
    lambdaber:oscillation_angle [ a nmdc:QuantityValue ;
            lambdaber:numeric_value "0.6"^^xsd:float ;
            lambdaber:unit "degrees" ] ;
    lambdaber:rotation_rate [ a nmdc:QuantityValue ;
            lambdaber:numeric_value "0.3"^^xsd:float ;
            lambdaber:unit "degrees per second" ] ;
    lambdaber:sweep_end [ a nmdc:QuantityValue ;
            lambdaber:numeric_value "35.0"^^xsd:float ;
            lambdaber:unit "degrees" ] ;
    lambdaber:sweep_start [ a nmdc:QuantityValue ;
            lambdaber:numeric_value "-35.0"^^xsd:float ;
            lambdaber:unit "degrees" ] ;
    lambdaber:technique "microed" ;
    lambdaber:tilting_scheme "continuous" ;
    lambdaber:total_rotation [ a nmdc:QuantityValue ;
            lambdaber:numeric_value "70.0"^^xsd:float ;
            lambdaber:unit "degrees" ] .

