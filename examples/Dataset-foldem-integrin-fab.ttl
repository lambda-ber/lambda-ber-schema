@base <http://example.org/> .
@prefix CHMO: <http://purl.obolibrary.org/obo/CHMO_> .
@prefix NCBITaxon: <http://purl.obolibrary.org/obo/NCBITaxon_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lambdaber: <http://w3id.org/lambda/> .
@prefix nmdc: <https://w3id.org/nmdc/> .
@prefix uniprot: <http://purl.uniprot.org/uniprot/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lambdaber:dataset-foldem-integrin-fab a lambdaber:Dataset ;
    dcterms:title "Integrin a5b1-BIIG2 Fab - atomic model from 1,000 particles" ;
    lambdaber:data_files lambdaber:file-9b9j-map,
        lambdaber:file-af3-integrin-fab-model,
        lambdaber:file-empiar-12552-particles,
        lambdaber:file-foldem-integrin-fab-model,
        lambdaber:file-foldem-integrin-fab-poses ;
    lambdaber:description "Worked example of particle_to_model_inference: a model inferred from a small subset of the EMPIAR-12552 particles with an AlphaFold3 prior, beside the deposited full-stack reconstruction." ;
    lambdaber:experiment_runs lambdaber:exp-empiar-12552 ;
    lambdaber:experiment_sample_associations [ a lambdaber:ExperimentSampleAssociation ;
            lambdaber:experiment_id lambdaber:exp-empiar-12552 ;
            lambdaber:role "target" ;
            lambdaber:sample_id lambdaber:sample-integrin-a5b1-biig2 ] ;
    lambdaber:keywords "cryo-EM",
        "integrin",
        "structure prediction" ;
    lambdaber:proteins uniprot:P05556,
        uniprot:P08648,
        lambdaber:protein-biig2-fab-heavy,
        lambdaber:protein-biig2-fab-light ;
    lambdaber:sample_protein_associations [ a lambdaber:SampleProteinAssociation ;
            lambdaber:copy_number 1 ;
            lambdaber:protein_id uniprot:P08648 ;
            lambdaber:role "subunit" ;
            lambdaber:sample_id lambdaber:sample-integrin-a5b1-biig2 ],
        [ a lambdaber:SampleProteinAssociation ;
            lambdaber:copy_number 1 ;
            lambdaber:protein_id uniprot:P05556 ;
            lambdaber:role "subunit" ;
            lambdaber:sample_id lambdaber:sample-integrin-a5b1-biig2 ],
        [ a lambdaber:SampleProteinAssociation ;
            lambdaber:copy_number 1 ;
            lambdaber:protein_id lambdaber:protein-biig2-fab-heavy ;
            lambdaber:role "binding_partner" ;
            lambdaber:sample_id lambdaber:sample-integrin-a5b1-biig2 ],
        [ a lambdaber:SampleProteinAssociation ;
            lambdaber:copy_number 1 ;
            lambdaber:protein_id lambdaber:protein-biig2-fab-light ;
            lambdaber:role "binding_partner" ;
            lambdaber:sample_id lambdaber:sample-integrin-a5b1-biig2 ] ;
    lambdaber:samples lambdaber:sample-integrin-a5b1-biig2 ;
    lambdaber:studies lambdaber:study-foldem-integrin ;
    lambdaber:study_experiment_associations [ a lambdaber:StudyExperimentAssociation ;
            lambdaber:experiment_id lambdaber:exp-empiar-12552 ;
            lambdaber:study_id lambdaber:study-foldem-integrin ] ;
    lambdaber:study_sample_associations [ a lambdaber:StudySampleAssociation ;
            lambdaber:role "target" ;
            lambdaber:sample_id lambdaber:sample-integrin-a5b1-biig2 ;
            lambdaber:study_id lambdaber:study-foldem-integrin ] ;
    lambdaber:study_workflow_associations [ a lambdaber:StudyWorkflowAssociation ;
            lambdaber:study_id lambdaber:study-foldem-integrin ;
            lambdaber:workflow_id lambdaber:workflow-af3-integrin-fab ],
        [ a lambdaber:StudyWorkflowAssociation ;
            lambdaber:study_id lambdaber:study-foldem-integrin ;
            lambdaber:workflow_id lambdaber:workflow_foldem_integrin_abinitio ],
        [ a lambdaber:StudyWorkflowAssociation ;
            lambdaber:study_id lambdaber:study-foldem-integrin ;
            lambdaber:workflow_id lambdaber:workflow-9b9j-deposited-refinement ] ;
    lambdaber:workflow_experiment_associations [ a lambdaber:WorkflowExperimentAssociation ;
            lambdaber:experiment_id lambdaber:exp-empiar-12552 ;
            lambdaber:workflow_id lambdaber:workflow_foldem_integrin_abinitio ],
        [ a lambdaber:WorkflowExperimentAssociation ;
            lambdaber:experiment_id lambdaber:exp-empiar-12552 ;
            lambdaber:workflow_id lambdaber:workflow-9b9j-deposited-refinement ] ;
    lambdaber:workflow_input_associations [ a lambdaber:WorkflowInputAssociation ;
            lambdaber:file_id lambdaber:file-af3-integrin-fab-model ;
            lambdaber:input_type "structure_prior" ;
            lambdaber:workflow_id lambdaber:workflow_foldem_integrin_abinitio ],
        [ a lambdaber:WorkflowInputAssociation ;
            lambdaber:file_id lambdaber:file-empiar-12552-particles ;
            lambdaber:input_type "particles" ;
            lambdaber:workflow_id lambdaber:workflow-9b9j-deposited-refinement ],
        [ a lambdaber:WorkflowInputAssociation ;
            lambdaber:file_id lambdaber:file-empiar-12552-particles ;
            lambdaber:input_type "particles" ;
            lambdaber:workflow_id lambdaber:workflow_foldem_integrin_abinitio ] ;
    lambdaber:workflow_output_associations [ a lambdaber:WorkflowOutputAssociation ;
            lambdaber:file_id lambdaber:file-foldem-integrin-fab-poses ;
            lambdaber:output_type "particle_assignments" ;
            lambdaber:workflow_id lambdaber:workflow_foldem_integrin_abinitio ],
        [ a lambdaber:WorkflowOutputAssociation ;
            lambdaber:file_id lambdaber:file-af3-integrin-fab-model ;
            lambdaber:output_type "model" ;
            lambdaber:workflow_id lambdaber:workflow-af3-integrin-fab ],
        [ a lambdaber:WorkflowOutputAssociation ;
            lambdaber:file_id lambdaber:file-9b9j-map ;
            lambdaber:output_type "map" ;
            lambdaber:workflow_id lambdaber:workflow-9b9j-deposited-refinement ],
        [ a lambdaber:WorkflowOutputAssociation ;
            lambdaber:file_id lambdaber:file-foldem-integrin-fab-model ;
            lambdaber:output_type "model" ;
            lambdaber:workflow_id lambdaber:workflow_foldem_integrin_abinitio ] ;
    lambdaber:workflow_runs lambdaber:workflow-9b9j-deposited-refinement,
        lambdaber:workflow-af3-integrin-fab,
        lambdaber:workflow_foldem_integrin_abinitio .

uniprot:P05556 a lambdaber:Protein ;
    lambdaber:gene_name "ITGB1" ;
    lambdaber:organism NCBITaxon:9606 ;
    lambdaber:organism_name "Homo sapiens" ;
    lambdaber:pdb_entries "pdb:9B9J"^^xsd:anyURI ;
    lambdaber:protein_name "Integrin beta-1" ;
    lambdaber:uniprot_id "uniprot:P05556"^^xsd:anyURI .

uniprot:P08648 a lambdaber:Protein ;
    lambdaber:gene_name "ITGA5" ;
    lambdaber:organism NCBITaxon:9606 ;
    lambdaber:organism_name "Homo sapiens" ;
    lambdaber:pdb_entries "pdb:9B9J"^^xsd:anyURI ;
    lambdaber:protein_name "Integrin alpha-5" ;
    lambdaber:uniprot_id "uniprot:P08648"^^xsd:anyURI .

lambdaber:file-9b9j-map a lambdaber:DataFile ;
    dcterms:title "Deposited 9B9J map" ;
    lambdaber:data_type "volume" ;
    lambdaber:file_format "mrc" ;
    lambdaber:file_name "9b9j_map.mrc" .

lambdaber:file-foldem-integrin-fab-model a lambdaber:DataFile ;
    dcterms:title "Fold'EM model of integrin a5b1-BIIG2 Fab" ;
    lambdaber:data_type "model" ;
    lambdaber:description "RMSD 2.49 A and TM-score 0.956 against 9B9J" ;
    lambdaber:file_format "mmcif" ;
    lambdaber:file_name "foldem_integrin_biig2_1k.cif" .

lambdaber:file-foldem-integrin-fab-poses a lambdaber:DataFile ;
    dcterms:title "Fold'EM per-particle poses" ;
    lambdaber:data_type "particle_assignments" ;
    lambdaber:file_format "star" ;
    lambdaber:file_name "foldem_integrin_biig2_1k_poses.star" .

lambdaber:protein-biig2-fab-heavy a lambdaber:Protein ;
    lambdaber:pdb_entries "pdb:9B9J"^^xsd:anyURI ;
    lambdaber:protein_name "BIIG2 Fab heavy chain" .

lambdaber:protein-biig2-fab-light a lambdaber:Protein ;
    lambdaber:pdb_entries "pdb:9B9J"^^xsd:anyURI ;
    lambdaber:protein_name "BIIG2 Fab light chain" .

lambdaber:file-af3-integrin-fab-model a lambdaber:DataFile ;
    dcterms:title "AlphaFold3 model of integrin a5b1-BIIG2 Fab" ;
    lambdaber:data_type "predicted_model" ;
    lambdaber:file_format "mmcif" ;
    lambdaber:file_name "af3_integrin_biig2_model.cif" .

lambdaber:file-empiar-12552-particles a lambdaber:DataFile ;
    dcterms:title "EMPIAR-12552 particle stack" ;
    lambdaber:data_type "particles" ;
    lambdaber:file_format "mrcs" ;
    lambdaber:file_name "integrin_biig2_particles.mrcs" .

lambdaber:workflow-af3-integrin-fab a lambdaber:WorkflowRun ;
    dcterms:title "AlphaFold3 prediction of integrin a5b1-BIIG2 Fab" ;
    lambdaber:description "Prediction from sequence alone. Both components are predicted, but the Fab is placed at the wrong site (TM-score 0.78 against 9B9J); antibody-antigen pairs carry little coevolutionary signal." ;
    lambdaber:software_name "AlphaFold3" ;
    lambdaber:workflow_code "WF-AF3-9B9J" ;
    lambdaber:workflow_type "structure_prediction" .

lambdaber:exp-empiar-12552 a lambdaber:ExperimentRun ;
    dcterms:title "Single-particle cryo-EM of integrin a5b1-BIIG2 Fab" ;
    lambdaber:experiment_code "EMPIAR-12552" ;
    lambdaber:raw_data_location "https://www.ebi.ac.uk/empiar/EMPIAR-12552/" ;
    lambdaber:technique CHMO:0002413 .

lambdaber:workflow-9b9j-deposited-refinement a lambdaber:WorkflowRun ;
    dcterms:title "Deposited reconstruction of 9B9J" ;
    lambdaber:deposited_to_pdb true ;
    lambdaber:number_of_particles 374814 ;
    lambdaber:pdb_id "9B9J" ;
    lambdaber:refinement_params [ a lambdaber:RefinementParameters ;
            lambdaber:resolution_0_143 [ a nmdc:QuantityValue ;
                    lambdaber:numeric_value "2.6"^^xsd:float ;
                    lambdaber:unit "Angstroms" ] ] ;
    lambdaber:software_name "RELION" ;
    lambdaber:workflow_code "WF-9B9J-REFINE" ;
    lambdaber:workflow_type "refinement" .

lambdaber:study-foldem-integrin a lambdaber:Study ;
    dcterms:title "Fold'EM benchmark on integrin a5b1-BIIG2 Fab" ;
    lambdaber:description "Low-particle-count structure inference against the deposited 9B9J reconstruction" .

lambdaber:sample-integrin-a5b1-biig2 a lambdaber:Sample ;
    dcterms:title "Integrin a5b1 headpiece bound to BIIG2 Fab" ;
    lambdaber:sample_code "ITGA5B1-BIIG2-001" ;
    lambdaber:sample_type "complex" .

lambdaber:workflow_foldem_integrin_abinitio a lambdaber:WorkflowRun ;
    dcterms:title "Fold'EM ab initio inference of integrin a5b1-BIIG2 Fab" ;
    lambdaber:additional_software "AlphaFold3" ;
    lambdaber:description "Model inferred from 1,000 particles (0.26% of the deposited stack) with ab initio poses and the AlphaFold3 prediction as prior. Against 9B9J: RMSD 2.49 A, TM-score 0.956, FSC 3.52 A. Variable loops at the interface are not recovered at atomic accuracy." ;
    lambdaber:number_of_particles 1000 ;
    lambdaber:processing_parameters "ab initio poses; guidance on intermediate Pairformer states; particle-level likelihood" ;
    lambdaber:software_name "Fold'EM" ;
    lambdaber:workflow_code "WF-FOLDEM-9B9J-1K" ;
    lambdaber:workflow_type "particle_to_model_inference" .

