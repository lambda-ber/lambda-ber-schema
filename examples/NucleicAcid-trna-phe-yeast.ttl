@base <http://example.org/> .
@prefix NCBITaxon: <http://purl.obolibrary.org/obo/NCBITaxon_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lambdaber: <http://w3id.org/lambda/> .
@prefix nmdc: <https://w3id.org/nmdc/> .
@prefix ns1: <http://w3id.org/lambda/functional_annotation/> .
@prefix rnacentral: <https://rnacentral.org/rna/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rnacentral:URS000011107D a lambdaber:NucleicAcid ;
    dcterms:title "Yeast phenylalanine tRNA" ;
    lambdaber:cross_references [ a ns1:DatabaseCrossReference ;
            ns1:database_id "tRNA-Phe-GAA-Saccharomyces_cerevisiae" ;
            ns1:database_name "modomics" ],
        [ a ns1:DatabaseCrossReference ;
            ns1:database_id "tRNA-Phe-GAA-1-1" ;
            ns1:database_name "gtrnadb" ;
            ns1:database_url "https://gtrnadb.ucsc.edu/genomes/eukaryota/Scere3/genes/tRNA-Phe-GAA-1-1.html"^^xsd:anyURI ] ;
    lambdaber:description "Mature cytoplasmic tRNA-Phe of Saccharomyces cerevisiae, 76 nucleotides. The first tRNA structure solved and the reference L-shaped fold. Carries fourteen modified nucleosides, among them D16, D17, m2,2G26, Cm32, Gm34, wybutosine at 37, m5C40, m7G46, m5C49, T54, psi55 and m1A58; each is written as its parent base in nucleotide_sequence." ;
    lambdaber:function_description "Adaptor that reads UUC and UUU codons and delivers phenylalanine to the ribosome." ;
    lambdaber:gene_name "tF(GAA)" ;
    lambdaber:go_terms "GO:0006414"^^xsd:anyURI,
        "GO:0030533"^^xsd:anyURI ;
    lambdaber:molecular_weight_theoretical [ a nmdc:QuantityValue ;
            lambdaber:numeric_value "24.6"^^xsd:float ;
            lambdaber:unit "kilodaltons" ] ;
    lambdaber:nucleic_acid_name "tRNA-Phe (GAA)" ;
    lambdaber:nucleic_acid_type "rna" ;
    lambdaber:nucleotide_sequence "GCGGAUUUAGCUCAGUUGGGAGAGCGCCAGACUGAAGAUCUGGAGGUCCUGUGUUCGAUCCACAGAAUUCGCACCA" ;
    lambdaber:organism NCBITaxon:4932 ;
    lambdaber:organism_name "Saccharomyces cerevisiae" ;
    lambdaber:pdb_entries "pdb:1EHZ"^^xsd:anyURI,
        "pdb:4TNA"^^xsd:anyURI,
        "pdb:6TNA"^^xsd:anyURI ;
    lambdaber:rfam_families "rfam:RF00005"^^xsd:anyURI ;
    lambdaber:rnacentral_id "rnacentral:URS000011107D"^^xsd:anyURI ;
    lambdaber:sequence_length 76 .

