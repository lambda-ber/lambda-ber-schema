      "raw_data_location": "https://www.ebi.ac.uk/empiar/EMPIAR-13396/"
    }
  ],
  "workflow_runs": [
    {
      "id": "lambdaber:workflow-brecovar-uvra",
      "title": "B-RECOVAR label-free state assignment",
      "description": "Bootstrapped residual-subspace estimate that assigns each particle to a state and gives it a confidence score, so low-confidence particles can be dropped before model inference.",
      "workflow_code": "WF-BRECOVAR-UVRA",
      "workflow_type": "heterogeneity_analysis",
      "software_name": "B-RECOVAR",
      "number_of_particles": 2000
    },
    {
      "id": "lambdaber:workflow-af3-uvra-dna",
      "title": "AlphaFold3 prediction of UvrA-DNA",
      "description": "One prediction from sequence. It matches 9GXR (3.54 A, TM-score 0.886) but not 9GXQ (11.69 A, TM-score 0.734). The abasic site was given as intact DNA.",
      "workflow_code": "WF-AF3-UVRA",
      "workflow_type": "structure_prediction",
      "software_name": "AlphaFold3"
    },
    {
      "id": "lambdaber:workflow-foldem-uvra-two-state",
      "title": "Fold'EM two-state inference of UvrA-DNA",
      "description": "Both states inferred from the same prior, 1,000 particles each, poses known. Reported resolutions 3.09 A (9GXQ) and 2.95 A (9GXR), against 4.34 and 4.41 A for cryoDRGN.",
      "workflow_code": "WF-FOLDEM-UVRA-2S",
      "workflow_type": "particle_to_model_inference",
      "software_name": "Fold'EM",
      "additional_software": "AlphaFold3",
      "processing_parameters": "known poses; two states; particle-level likelihood",
      "number_of_particles": 2000
    }
  ],
