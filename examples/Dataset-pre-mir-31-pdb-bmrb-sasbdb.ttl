    lambdaber:data_type "model" ;
    lambdaber:description "SASBDB marks this model \"identical\" to PDB 8FCS. All 20 models match the coordinates in 8FCS.pdb atom for atom; only the header differs, because the copy was taken before the PDB's 2024 revision of the entry, so the checksum differs from pdb:8FCS/file/pdb." ;
    lambdaber:file_format "pdb" ;
    lambdaber:file_name "SASDRF9_fit1_model2.pdb" ;
    lambdaber:file_path "https://www.sasbdb.org/media/pdb_file/SASDRF9_fit1_model2.pdb" .

