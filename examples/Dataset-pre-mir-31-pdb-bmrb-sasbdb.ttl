rnacentral:URS0000001EB3_9606 a lambdaber:NucleicAcid ;
    dcterms:title "Human precursor microRNA 31" ;
    lambdaber:cross_references [ a ns1:DatabaseCrossReference ;
            ns1:database_id "MI0000089" ;
            ns1:database_name "mirbase" ;
            ns1:database_url "https://www.mirbase.org/hairpin/MI0000089"^^xsd:anyURI ] ;
    lambdaber:description "The hsa-mir-31 stem-loop, 71 nucleotides. RNAcentral lists PDB 8FCS chain A among its cross-references, so the archive link runs both ways for the molecule even though it does not for the SAXS entry." ;
    lambdaber:function_description "Precursor of miR-31, processed by Dicer to the mature microRNA." ;
    lambdaber:gene_name "MIR31" ;
    lambdaber:molecular_weight_theoretical [ a nmdc:QuantityValue ;
            lambdaber:numeric_value "22.873"^^xsd:float ;
            lambdaber:unit "kDa" ] ;
