        [ a lambdaber:StudyWorkflowAssociation ;
            lambdaber:study_id lambdaber:study-prokaryotic-vaults ;
            lambdaber:workflow_id lambdaber:workflow-l05-ligand-search ],
        [ a lambdaber:StudyWorkflowAssociation ;
            lambdaber:study_id lambdaber:study-prokaryotic-vaults ;
            lambdaber:workflow_id lambdaber:workflow-l05-composite ],
        [ a lambdaber:StudyWorkflowAssociation ;
            lambdaber:study_id lambdaber:study-prokaryotic-vaults ;
            lambdaber:workflow_id lambdaber:workflow-l05-model-refinement ],
        [ a lambdaber:StudyWorkflowAssociation ;
            lambdaber:study_id lambdaber:study-prokaryotic-vaults ;
            lambdaber:workflow_id lambdaber:workflow-l05-consensus-refine ] ;
    lambdaber:workflow_experiment_associations [ a lambdaber:WorkflowExperimentAssociation ;
            lambdaber:experiment_id lambdaber:exp-l05-cryoem ;
            lambdaber:workflow_id lambdaber:workflow-l05-consensus-refine ],
        [ a lambdaber:WorkflowExperimentAssociation ;
            lambdaber:experiment_id lambdaber:exp-l05-cryoem ;
            lambdaber:workflow_id lambdaber:workflow-l05-ctf ],
        [ a lambdaber:WorkflowExperimentAssociation ;
            lambdaber:experiment_id lambdaber:exp-l05-cryoem ;
            lambdaber:workflow_id lambdaber:workflow-l05-picking ],
        [ a lambdaber:WorkflowExperimentAssociation ;
            lambdaber:experiment_id lambdaber:exp-l05-cryoem ;
            lambdaber:workflow_id lambdaber:workflow-l05-motioncorr ],
        [ a lambdaber:WorkflowExperimentAssociation ;
            lambdaber:experiment_id lambdaber:exp-l05-plus2-cryoem ;
            lambdaber:workflow_id lambdaber:workflow-l05-plus2-halves-refine ] ;
    lambdaber:workflow_input_associations [ a lambdaber:WorkflowInputAssociation ;
