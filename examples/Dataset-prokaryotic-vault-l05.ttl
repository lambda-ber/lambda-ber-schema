lambdaber:workflow-l05-consensus-refine a lambdaber:WorkflowRun ;
    dcterms:title "Consensus refinement of the L05 vault" ;
    lambdaber:description "Refinement under D16 symmetry from a 20 A smoothened shell of the predicted model, with CTF refinement and 3D classification-based cleanup against decoy references. SCHEMA GAP: D16 is not a permissible value of SymmetryEnum, which stops at D10, so the symmetry slot is left unset and recorded here instead. Refinements without symmetry from a featureless reference preferentially showed 48 ribs around the wall." ;
    lambdaber:number_of_particles 11675 ;
    lambdaber:processing_parameters "D16 symmetry; starting reference low-pass filtered to 20 A" ;
    lambdaber:refinement_params [ a lambdaber:RefinementParameters ;
            lambdaber:gold_standard true ;
            lambdaber:pixel_size [ a nmdc:QuantityValue ;
                    lambdaber:numeric_value "0.937"^^xsd:float ;
                    lambdaber:unit "Angstroms" ] ;
            lambdaber:resolution_0_143 [ a nmdc:QuantityValue ;
                    lambdaber:numeric_value "3.5"^^xsd:float ;
                    lambdaber:unit "Angstroms" ] ] ;
    lambdaber:software_name "RELION" ;
    lambdaber:software_version "5.0.1" ;
    lambdaber:workflow_code "WF-L05-REFINE-D16" ;
    lambdaber:workflow_type "refinement" .

