            lambdaber:numeric_value "300.0"^^xsd:float ;
            lambdaber:unit "kilovolts" ] ;
    lambdaber:current_status "operational" ;
    lambdaber:description "Operated at the Thermo Fisher Scientific Cryo-EM Drug Discovery Center. SCHEMA GAP: facility_name is bound to FacilityEnum, a closed list of synchrotron and neutron sources, so a commercial or vendor cryo-EM centre cannot be named; the slot is left unset, per its own guidance for laboratory instruments." ;
    lambdaber:detector_manufacturer "Thermo Fisher Scientific" ;
    lambdaber:detector_mode "counting" ;
    lambdaber:detector_model "Falcon 4i" ;
    lambdaber:detector_technology "direct_electron_detector" ;
    lambdaber:energy_filter_present true ;
    lambdaber:energy_filter_slit_width [ a nmdc:QuantityValue ;
            lambdaber:numeric_value "10.0"^^xsd:float ;
            lambdaber:unit "eV" ] ;
    lambdaber:instrument_category "ELECTRON_MICROSCOPE" ;
    lambdaber:instrument_code "KRIOS-G4-CRYOEM-DDC" ;
    lambdaber:instrument_type "CryoEMInstrument" ;
    lambdaber:manufacturer "Thermo Fisher Scientific" ;
    lambdaber:microscope_software "EPU" ;
    lambdaber:model "Titan Krios G4" .

lambdaber:workflow-l05-ligand-search a lambdaber:WorkflowRun ;
    dcterms:title "Density-fit screen for the unassigned lumenal density" ;
    lambdaber:description "A computational search of 25,000 molecules against the unassigned density ranked coenzyme A and its derivatives highest. SCHEMA GAP: there is no ligand_identification value in WorkflowTypeEnum; map_validation is used as the nearest fit." ;
    lambdaber:processing_parameters "25,000 candidate molecules scored against the unassigned density" ;
    lambdaber:software_name "not stated in the main text" ;
    lambdaber:workflow_code "WF-L05-LIGAND-SEARCH" ;
    lambdaber:workflow_type "map_validation" .

lambdaber:workflow-l05-model-refinement a lambdaber:WorkflowRun ;
    dcterms:title "Refinement of the L05 atomic model" ;
    lambdaber:description "Refined under strict symmetry with residue-by-residue inspection. D8 symmetry generates the 96 chains of the model from six, which adopt four conformations (A, B, C and C-prime) that differ beyond residue 788. Each chain contains 717 to 724 of the 866 residues." ;
    lambdaber:refinement_params [ a lambdaber:RefinementParameters ;
            lambdaber:symmetry "D8" ] ;
    lambdaber:software_name "Servalcat" ;
    lambdaber:software_version "0.4.131" ;
    lambdaber:workflow_code "WF-L05-SERVALCAT" ;
    lambdaber:workflow_type "model_refinement" .

lambdaber:workflow-l05-motioncorr a lambdaber:WorkflowRun ;
    dcterms:title "Motion correction of L05 movies" ;
    lambdaber:additional_software "MotionCor2 implementation" ;
    lambdaber:motion_correction_params [ a lambdaber:MotionCorrectionParameters ;
            lambdaber:dose_weighting true ] ;
    lambdaber:software_name "RELION" ;
    lambdaber:software_version "5.0.1" ;
    lambdaber:workflow_code "WF-L05-MOTIONCORR" ;
    lambdaber:workflow_type "motion_correction" .

lambdaber:workflow-l05-plus2-halves-refine a lambdaber:WorkflowRun ;
    dcterms:title "Half-vault refinement of L05+2" ;
    lambdaber:description "Whole-vault refinement under D16 did not reach Nyquist, so each half was treated as a separate particle. 35,558 halves reached 4.2 A under C48 at 1.25 A per pixel. Refinement to convergence increased the difference between the half maps in the shells from 4.7 to 3.5 A, which the authors report as evidence of some fitted noise. SCHEMA GAP: C48 is not a permissible value of SymmetryEnum, and there is no slot for a self-reported fitted-noise check." ;
    lambdaber:number_of_particles 35558 ;
    lambdaber:processing_parameters "C48 symmetry on isolated halves; 1.25 A per pixel" ;
    lambdaber:refinement_params [ a lambdaber:RefinementParameters ;
            lambdaber:gold_standard true ;
            lambdaber:pixel_size [ a nmdc:QuantityValue ;
                    lambdaber:numeric_value "1.25"^^xsd:float ;
                    lambdaber:unit "Angstroms" ] ;
            lambdaber:resolution_0_143 [ a nmdc:QuantityValue ;
                    lambdaber:numeric_value "4.2"^^xsd:float ;
                    lambdaber:unit "Angstroms" ] ] ;
    lambdaber:software_name "RELION" ;
    lambdaber:workflow_code "WF-L05P2-HALVES-C48" ;
    lambdaber:workflow_type "refinement" .

lambdaber:workflow-l05-shell-prediction a lambdaber:WorkflowRun ;
    dcterms:title "OpenFold3 whole-shell prediction of the L05 vault" ;
    lambdaber:additional_software "OpenBind-0 weights; ColabFold alignments" ;
    lambdaber:description "Pairs of full-length chains co-folded without templates from unpaired ColabFold alignments. Predictions were kept when the chains lay side by side with continuous cap helices 8-11.5 A apart. C-alpha distances below 14 A between neighboring chains, present in at least half of the pooled predictions, became restraints used to optimize one chain so that 48 exact copies about one axis satisfied them; the second half was generated by a two-fold axis 1.5 A from the first at the waist. 127 of 150 predictions were usable; the model covers residues 8-798 of 866 and was not energy-minimized. Handedness was checked against the human vault. SCHEMA GAP: no slot records handedness determination." ;
    lambdaber:processing_parameters "48 chains per half; no templates; unpaired MSAs; restraint cutoff 14 A C-alpha; two-fold axis offset 1.5 A at the waist" ;
    lambdaber:software_name "OpenFold3" ;
    lambdaber:software_version "0.5.0" ;
    lambdaber:workflow_code "WF-L05-OF3-SHELL" ;
    lambdaber:workflow_type "structure_prediction" .

