lambdaber:dataset-prokaryotic-vault-l05 a lambdaber:Dataset ;
    dcterms:title "Phage L05 vault nanocapsule - cryo-EM structure and engineered wall expansion" ;
    lambdaber:data_files lambdaber:file-l05-composite-map,
        lambdaber:file-l05-consensus-map,
        lambdaber:file-l05-model,
        lambdaber:file-l05-movies,
        lambdaber:file-l05-particles,
        lambdaber:file-l05-plus2-map,
        lambdaber:file-l05-plus2-model,
        lambdaber:file-l05-predicted-shell ;
    lambdaber:description "Worked example covering the structural half of Athukoralage et al., \"Prokaryotic homologs of the major vault protein form engineerable vault nanocapsules\" (bioRxiv 2026.11.04.764334). Tracks one bacteriophage MVP homolog (L05) from construct through E. coli expression, size-exclusion capture, cryo-EM and model building, beside the human MVP control expressed in Sf9 cells. Exercises the prediction-as-experimental-reference pattern: an OpenFold3 whole-shell model supplies the starting reference for refinement, because ab initio maps could not distinguish the vault from its mirror image. No PDB, EMDB or EMPIAR accessions had been released when this example was written, so file names are placeholders and no checksums or storage URIs are asserted. Several facts from the paper have no slot in the schema and are carried as free text here; each is marked \"SCHEMA GAP\" in the description of the record that carries it." ;
    lambdaber:experiment_instrument_associations [ a lambdaber:ExperimentInstrumentAssociation ;
            lambdaber:experiment_id lambdaber:exp-l05-plus2-cryoem ;
            lambdaber:instrument_id lambdaber:instrument-krios-g4-tfs ;
            lambdaber:role "primary" ],
        [ a lambdaber:ExperimentInstrumentAssociation ;
            lambdaber:experiment_id lambdaber:exp-l05-cryoem ;
            lambdaber:instrument_id lambdaber:instrument-krios-g4-tfs ;
            lambdaber:role "primary" ] ;
    lambdaber:experiment_runs lambdaber:exp-l05-cryoem,
        lambdaber:exp-l05-plus2-cryoem ;
    lambdaber:experiment_sample_associations [ a lambdaber:ExperimentSampleAssociation ;
            lambdaber:experiment_id lambdaber:exp-l05-cryoem ;
            lambdaber:role "target" ;
            lambdaber:sample_id lambdaber:sample-l05-vault ],
        [ a lambdaber:ExperimentSampleAssociation ;
            lambdaber:experiment_id lambdaber:exp-l05-plus2-cryoem ;
            lambdaber:role "target" ;
            lambdaber:sample_id lambdaber:sample-l05-plus2-vault ] ;
    lambdaber:instruments lambdaber:instrument-krios-g4-tfs ;
    lambdaber:keywords "bacteriophage",
        "cryo-EM",
        "major vault protein",
        "protein nanocapsule",
        "structure prediction",
        "vault" ;
    lambdaber:protein_constructs lambdaber:construct-hsmvp-sf9,
        lambdaber:construct-l05-cap-truncation,
        lambdaber:construct-l05-i794d,
        lambdaber:construct-l05-plus2,
        lambdaber:construct-l05-r55e,
        lambdaber:construct-l05-wt ;
    lambdaber:proteins uniprot:Q14764,
        lambdaber:protein-c0,
        lambdaber:protein-l05 ;
    lambdaber:sample_component_interactions [ a lambdaber:SampleComponentInteraction ;
            lambdaber:description "Cryo-EM density not accounted for by the protein model; a computational fit of 25,000 candidate molecules ranked coenzyme A and its derivatives highest. The ligand is NOT identified, so interaction_status is \"expected\". Analogous to NAD+ and related nucleotides binding the lumenal wall of the human vault." ;
            lambdaber:evidence "experimental",
                "predicted" ;
            lambdaber:interaction_status "expected" ;
            lambdaber:interaction_type "binds" ;
            lambdaber:object_id lambdaber:component-l05-shell ;
            lambdaber:object_site "basic pocket between neighboring chains, repeats 1 and 2" ;
            lambdaber:sample_id lambdaber:sample-l05-vault ;
            lambdaber:subject_id lambdaber:component-l05-unknown-ligand ;
            lambdaber:subject_site "unassigned density at the repeat seam, lumenal face" ] ;
    lambdaber:sample_components lambdaber:component-human-vault-shell,
        lambdaber:component-l05-shell,
        lambdaber:component-l05-unknown-ligand ;
    lambdaber:sample_preparations lambdaber:prep-l05-ecoli,
        lambdaber:prep-l05-grids ;
    lambdaber:sample_protein_associations [ a lambdaber:SampleProteinAssociation ;
            lambdaber:construct_id lambdaber:construct-hsmvp-sf9 ;
            lambdaber:copy_number 78 ;
            lambdaber:protein_id uniprot:Q14764 ;
            lambdaber:role "subunit" ;
            lambdaber:sample_id lambdaber:sample-human-vault ],
        [ a lambdaber:SampleProteinAssociation ;
            lambdaber:construct_id lambdaber:construct-l05-wt ;
            lambdaber:copy_number 96 ;
            lambdaber:protein_id lambdaber:protein-l05 ;
            lambdaber:residue_range "8-798" ;
            lambdaber:role "subunit" ;
            lambdaber:sample_id lambdaber:sample-l05-vault ],
        [ a lambdaber:SampleProteinAssociation ;
            lambdaber:construct_id lambdaber:construct-l05-plus2 ;
            lambdaber:copy_number 96 ;
            lambdaber:protein_id lambdaber:protein-l05 ;
            lambdaber:role "subunit" ;
            lambdaber:sample_id lambdaber:sample-l05-plus2-vault ] ;
    lambdaber:samples lambdaber:sample-human-vault,
        lambdaber:sample-l05-plus2-vault,
        lambdaber:sample-l05-vault ;
    lambdaber:small_molecules chebi:15346 ;
    lambdaber:studies lambdaber:study-prokaryotic-vaults ;
    lambdaber:study_experiment_associations [ a lambdaber:StudyExperimentAssociation ;
            lambdaber:experiment_id lambdaber:exp-l05-plus2-cryoem ;
            lambdaber:study_id lambdaber:study-prokaryotic-vaults ],
        [ a lambdaber:StudyExperimentAssociation ;
            lambdaber:experiment_id lambdaber:exp-l05-cryoem ;
            lambdaber:study_id lambdaber:study-prokaryotic-vaults ] ;
    lambdaber:study_sample_associations [ a lambdaber:StudySampleAssociation ;
            lambdaber:role "control" ;
            lambdaber:sample_id lambdaber:sample-human-vault ;
            lambdaber:study_id lambdaber:study-prokaryotic-vaults ],
        [ a lambdaber:StudySampleAssociation ;
