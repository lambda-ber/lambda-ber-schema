lambdaber:protein-l05 a lambdaber:Protein ;
    dcterms:title "Phage L05 major vault protein homolog" ;
    lambdaber:description "MVP homolog encoded by an uncultured bacteriophage, recovered from a metagenomic survey. 866 residues with seven wall repeats, a shoulder (SPFH) domain, a cap helix and a C-terminal region. Assembles into a 96-chain vault. Member of the MVP-1 cluster, which carries seven wall repeats and an ~80-residue linker loop between the sixth and seventh repeats. No UniProt accession exists; a local identifier is used. Source phage is uncultured and unnamed." ;
    lambdaber:protein_name "Major vault protein homolog L05" .

lambdaber:study-prokaryotic-vaults a lambdaber:Study ;
    dcterms:title "Prokaryotic and bacteriophage MVP homologs form vault particles" ;
    lambdaber:description "Survey of the MVP family across ~15 billion predicted proteins, followed by heterologous expression and structural characterization of selected homologs. Only the structural work is represented here; the sequence survey, phylogenetics and gene-neighborhood analyses are out of scope for this schema." ;
    lambdaber:keywords "prokaryotic homolog",
        "vault" .

