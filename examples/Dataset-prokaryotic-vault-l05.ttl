lambdaber:workflow-l05-composite a lambdaber:WorkflowRun ;
    dcterms:title "Composite map assembly for L05" ;
    lambdaber:description "Local maps merged into one composite map. Sub-particle extraction, cap sorting, geometric mask construction, composite map assembly, the check for fitted noise and directional FSC were performed with custom Python scripts, because RELION has no job type for them. SCHEMA GAP: no workflow type for composite map assembly, and no way to record software that has no release version." ;
    lambdaber:processing_parameters "nominal resolution 3.2 A reported as the mean of the five local refinement values (2.95, 3.02, 3.39, 3.24, 3.30 A)" ;
    lambdaber:software_name "custom Python scripts" ;
    lambdaber:workflow_code "WF-L05-COMPOSITE" ;
    lambdaber:workflow_type "postprocessing" .

