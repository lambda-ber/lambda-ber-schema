    lambdaber:instruments emsl:resource_99999 ;
    lambdaber:keywords "EMSL",
        "SerialEM",
        "cryo-EM",
        "single particle" ;
    lambdaber:samples emsl:sample_grid_1_99999 ;
    lambdaber:studies emsl:project_99999 ;
