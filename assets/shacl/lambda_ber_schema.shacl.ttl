@prefix CHMO: <http://purl.obolibrary.org/obo/CHMO_> .
@prefix GO: <http://purl.obolibrary.org/obo/GO_> .
@prefix ROR: <https://ror.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lambdaber: <http://w3id.org/lambda/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix nmdc: <https://w3id.org/nmdc/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lambdaber:AttributeGroup a sh:NodeShape ;
    sh:closed false ;
    sh:description "A grouping of related data attributes that form a logical unit" ;
    sh:ignoredProperties ( lambdaber:seeding_type lambdaber:ybeam lambdaber:beam_trap_position_y lambdaber:unit_cell_c lambdaber:r_factor lambdaber:ice_contamination lambdaber:total_rotation_deg <http://w3id.org/lambda/functional_annotation/ligand_name> lambdaber:model_file_path lambdaber:protein_buffer lambdaber:detector_mode lambdaber:detector_description lambdaber:method lambdaber:mounting_temperature lambdaber:resolution_high_shell_a lambdaber:ramachandran_outliers_percent lambdaber:pixel_size_calibrated lambdaber:r_free lambdaber:chamber_temperature lambdaber:wilson_b_factor_a2 lambdaber:wavelength lambdaber:q_max lambdaber:total_dose lambdaber:map_sharpening_bfactor lambdaber:completeness_high_res_shell_percent lambdaber:ice_quality lambdaber:r_merge lambdaber:molprobity_score lambdaber:ncc_score lambdaber:glow_discharge_pressure lambdaber:protein_concentration_mg_per_ml lambdaber:pressure lambdaber:anisotropic_correction lambdaber:blot_force lambdaber:unit_cell_alpha lambdaber:resolution_0_143 lambdaber:frame_rate lambdaber:collection_mode lambdaber:oscillation_per_image_deg lambdaber:exposure_time <http://w3id.org/lambda/functional_annotation/error> lambdaber:cpu_hours lambdaber:terms lambdaber:beam_trap_position_x lambdaber:rotation_angle lambdaber:strategy_notes lambdaber:pdb_entries lambdaber:blot_time lambdaber:cc_half lambdaber:resolution lambdaber:r_work <http://w3id.org/lambda/functional_annotation/druggability_score> lambdaber:resolution_0_5 lambdaber:drop_volume_nl <http://w3id.org/lambda/functional_annotation/ligand_id> lambdaber:dose_per_frame lambdaber:fsc_value lambdaber:glow_discharge_applied lambdaber:gpu_hours <http://w3id.org/lambda/functional_annotation/characteristic_features> <http://w3id.org/lambda/functional_annotation/database_id> lambdaber:picking_method lambdaber:flux_photons_per_s lambdaber:xbeam lambdaber:symmetry lambdaber:initial_hit_condition lambdaber:beam_energy lambdaber:ph lambdaber:value lambdaber:crystallization_method lambdaber:seed_stock_dilution lambdaber:unit_cell_beta lambdaber:split_strategy lambdaber:frame_grouping lambdaber:grid_type lambdaber:crystal_size_um lambdaber:multiplicity lambdaber:sample_aperature_diameter lambdaber:modifications lambdaber:memory_gb lambdaber:anomalous_used lambdaber:transmission_percent lambdaber:vitrification_instrument <http://w3id.org/lambda/functional_annotation/interaction_distance> lambdaber:source_description <http://w3id.org/lambda/functional_annotation/ligand_smiles> lambdaber:cryo_protectant <http://w3id.org/lambda/functional_annotation/measurement_conditions> lambdaber:box_size <http://w3id.org/lambda/functional_annotation/population> <http://w3id.org/lambda/functional_annotation/state_id> lambdaber:beam_center_x_px lambdaber:grid_quality lambdaber:defocus_search_min lambdaber:sample_cell_type lambdaber:experimental_method lambdaber:atmosphere lambdaber:anom_sig_ano lambdaber:binning lambdaber:blot_number lambdaber:plasma_treatment <http://w3id.org/lambda/functional_annotation/state_name> lambdaber:completeness lambdaber:attenuator lambdaber:crystal_notes <http://w3id.org/lambda/functional_annotation/binding_affinity_type> lambdaber:vitrification_method lambdaber:storage_gb lambdaber:support_film lambdaber:sample_detector_distance lambdaber:energy lambdaber:total_frames lambdaber:source_ap_to_sample_ap_distance lambdaber:humidity lambdaber:detector_distance_mm lambdaber:blotter_height lambdaber:rg lambdaber:voltage_used_in_estimation lambdaber:power_score lambdaber:pixel_size_x <http://w3id.org/lambda/functional_annotation/free_energy> lambdaber:ethane_temperature lambdaber:detector_name lambdaber:screen_name lambdaber:resolution_low_a <http://w3id.org/lambda/functional_annotation/is_drug_like> lambdaber:beam_size_um lambdaber:particle_concentration lambdaber:drift_total lambdaber:wavelength_selection_method lambdaber:signal_to_noise lambdaber:r_pim lambdaber:unit_cell_b lambdaber:additives lambdaber:reservoir_volume_ul lambdaber:cryoprotectant lambdaber:sample_applied_volume <http://w3id.org/lambda/functional_annotation/binding_site_residues> lambdaber:drop_ratio_protein_to_reservoir lambdaber:dose_weighting lambdaber:sample_ap_to_main_distance lambdaber:buffer_matching_protocol lambdaber:ligands <http://w3id.org/lambda/functional_annotation/binding_affinity> lambdaber:pixel_size_y lambdaber:cryoprotectant_concentration lambdaber:i_zero lambdaber:clashscore lambdaber:protein_concentration lambdaber:siwindow_to_main_distance rdf:type lambdaber:unit lambdaber:source_aperature_diameter <http://w3id.org/lambda/functional_annotation/rmsd_from_reference> lambdaber:temperature_c lambdaber:model_source lambdaber:duration lambdaber:sequences lambdaber:humidity_percentage lambdaber:number_of_guides lambdaber:space_group lambdaber:unit_cell_gamma lambdaber:blotter_setting lambdaber:defocus_search_max lambdaber:mean_i_over_sigma_i lambdaber:glow_discharge_atmosphere lambdaber:sample_ap_to_sample_distance <http://w3id.org/lambda/functional_annotation/database_url> lambdaber:source_ap_to_siwindow_distance lambdaber:resolution_angstrom lambdaber:crystallization_conditions lambdaber:glow_discharge_time lambdaber:crystal_id lambdaber:hole_size <http://w3id.org/lambda/functional_annotation/last_updated> lambdaber:average_b_factor_a2 lambdaber:beam_center_pixels lambdaber:drop_volume lambdaber:gold_standard lambdaber:source_type lambdaber:loop_size lambdaber:cell_path_length lambdaber:optimization_strategy lambdaber:sweep_start lambdaber:wait_time lambdaber:beam_trap_type lambdaber:beam_center_y_px <http://w3id.org/lambda/functional_annotation/property_type> lambdaber:wavelength_a lambdaber:components lambdaber:anom_corr lambdaber:bfactor_dose_weighting lambdaber:amplitude_contrast lambdaber:flash_cooling_method lambdaber:pixel_size lambdaber:sample_ap_to_si_distance <http://w3id.org/lambda/functional_annotation/database_name> lambdaber:grid_material lambdaber:glow_discharge_current lambdaber:soak_conditions lambdaber:q_min lambdaber:detector_type lambdaber:wavelength_spread lambdaber:cs_used_in_estimation lambdaber:flux lambdaber:unit_cell_a lambdaber:optimized_condition lambdaber:defocus_step lambdaber:ramachandran_favored_percent <http://w3id.org/lambda/functional_annotation/interaction_type> lambdaber:sweep_end lambdaber:model_name lambdaber:temperature lambdaber:temperature_control lambdaber:concentration_series lambdaber:soak_compound lambdaber:patch_size <http://w3id.org/lambda/functional_annotation/binding_affinity_unit> lambdaber:mounting_method lambdaber:output_binning <http://w3id.org/lambda/functional_annotation/is_cofactor> lambdaber:threshold lambdaber:temperature_k ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path lambdaber:description ] ;
    sh:targetClass lambdaber:AttributeGroup .

lambdaber:BeamlineInstrument a sh:NodeShape ;
    sh:closed true ;
    sh:description "Multi-technique synchrotron beamline that supports multiple experimental methods" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class nmdc:QuantityValue ;
            sh:description "Maximum q value for SAXS in inverse Angstroms" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lambdaber:q_range_max ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Maximum X-ray energy in keV" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path lambdaber:energy_max ],
        [ sh:datatype xsd:string ;
            sh:description "Date of instrument installation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path lambdaber:installation_date ],
        [ sh:datatype xsd:string ;
            sh:description "Human-friendly facility or laboratory identifier for the instrument (e.g., 'TITAN-KRIOS-1', 'ALS-12.3.1-SIBYLS', 'RIGAKU-FR-E'). Used for local reference and equipment tracking." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path lambdaber:instrument_code ],
        [ sh:description "Data acquisition system used for experiment orchestration" ;
            sh:in ( "bluesky" "spec" "sardana" "gda" "mxcube_daq" "blu_ice" "jblue_ice" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path lambdaber:daq_system ],
        [ sh:description "Experimental techniques available at this beamline" ;
            sh:in ( CHMO:0002413 CHMO:0000156 CHMO:0000204 CHMO:0000207 CHMO:0000184 CHMO:0002413 CHMO:0000068 CHMO:0000470 CHMO:0000298 CHMO:0000305 CHMO:0000300 "xmcd" CHMO:0000182 CHMO:0000156 CHMO:0000156 CHMO:0002743 "microed" ) ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path lambdaber:techniques_supported ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether mail-in sample service is available" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:mail_in_service ],
        [ sh:datatype xsd:string ;
            sh:description "Beamline identifier at synchrotron/neutron facility" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path lambdaber:beamline_id ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path lambdaber:id ],
        [ sh:description "Controlled-vocabulary identifier linking this instrument to its canonical entry in a registry enum appropriate to the instrument type. For beamlines, use a value from BeamlineEnum; additional instrument-type registries may be referenced here as they are introduced." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "ALS_SIBYLS" "ALS_BL501" "ALS_BL502" "ALS_BL821" "ALS_BL822" "ALS_BL831" "ALS_BL832" "ALS_BL1222" "NSLS2_FMX" "NSLS2_AMX" "NSLS2_NYX" "NSLS2_LIX" "APS_GMCA_23IDB" "APS_GMCA_23IDD" "APS_LSCAT_21ID" "APS_LSCAT_21IDD" "APS_LSCAT_21IDF" "APS_LSCAT_21IDG" "APS_NECAT_24IDC" "APS_NECAT_24IDE" "APS_SERCAT_22ID" "APS_SERCAT_22BM" "APS_SBCCAT_19ID" "APS_SBCCAT_19BM" "APS_BIOCARS_14ID" "APS_BIOCAT_18ID" "APS_IMCACAT_17ID" "SSRL_BL92" "SSRL_BL121" "SSRL_BL122" "SSRL_BL141" "SNS_MANDI" "HFIR_IMAGINE" "SNS_BIOSANS" "SNS_EQSANS" ) ] ) ;
            sh:order 13 ;
            sh:path lambdaber:instrument_registry_id ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Minimum q value for SAXS in inverse Angstroms" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path lambdaber:q_range_min ],
        [ sh:description "Category distinguishing beamlines from laboratory equipment" ;
            sh:in ( CHMO:0001084 "NEUTRON_BEAMLINE" "XFEL_BEAMLINE" "ELECTRON_MICROSCOPE" "BENCHTOP_XRAY" "OPTICAL_MICROSCOPE" "SPECTROMETER" ) ;
            sh:maxCount 1 ;
            sh:order 14 ;
            sh:path lambdaber:instrument_category ],
        [ sh:datatype xsd:string ;
            sh:description "Instrument model" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path lambdaber:model ],
        [ sh:class lambdaber:Organization ;
            sh:description "The Organization that operates this instrument's facility. An instrument sits at exactly one facility, so this is a direct reference rather than an association table - the same shape as Sample.parent_sample_id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path lambdaber:facility_organization_id ],
        [ sh:description "Low-level control system for device communication" ;
            sh:in ( "epics" "tango" "labview" "opi" ) ;
            sh:maxCount 1 ;
            sh:order 11 ;
            sh:path lambdaber:control_system ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dcterms:title ],
        [ sh:description "Type of X-ray source" ;
            sh:in ( "synchrotron" "rotating_anode" "microfocus" "metal_jet" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path lambdaber:source_type ],
        [ sh:description "Name of the research facility where the instrument is located" ;
            sh:in ( ROR:01q47ea17 ROR:02jbv0t02 ROR:05gzmn429 ROR:02550n020 ROR:05etxs293 ROR:01g5y5k24 ROR:05gvnxz63 ROR:01xjv7358 ROR:01js2sh04 ROR:01ydb3330 ROR:03vk18a84 ROR:05h992307 ROR:01qz5mb56 ROR:01qz5mb56 ) ;
            sh:maxCount 1 ;
            sh:order 15 ;
            sh:path lambdaber:facility_name ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path lambdaber:description ],
        [ sh:description "Laboratory Information Management System used at this beamline" ;
            sh:in ( "ispyb" "ispyb_diamond" "icat" "mxlive" "mxcube_lims" "user_office" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path lambdaber:lims_system ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Beamline website URL" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path lambdaber:website ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Research Organization Registry (ROR) identifier for the facility" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path lambdaber:facility_ror ;
            sh:pattern "^https://ror\\.org/\\w+$" ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Automatic sample changer capacity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path lambdaber:sample_changer_capacity ],
        [ sh:description "Current operational status" ;
            sh:in ( "operational" "maintenance" "offline" "commissioning" ) ;
            sh:maxCount 1 ;
            sh:order 22 ;
            sh:path lambdaber:current_status ],
        [ sh:datatype xsd:string ;
            sh:description "Instrument manufacturer" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path lambdaber:manufacturer ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Minimum X-ray energy in keV" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lambdaber:energy_min ] ;
    sh:targetClass lambdaber:BeamlineInstrument .

lambdaber:CryoEMInstrument a sh:NodeShape ;
    sh:closed true ;
    sh:description "Cryo-EM microscope specifications" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Instrument model" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path lambdaber:model ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Physical pixel size in micrometers" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path lambdaber:pixel_size_physical ],
        [ sh:description "Controlled-vocabulary identifier linking this instrument to its canonical entry in a registry enum appropriate to the instrument type. For beamlines, use a value from BeamlineEnum; additional instrument-type registries may be referenced here as they are introduced." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "ALS_SIBYLS" "ALS_BL501" "ALS_BL502" "ALS_BL821" "ALS_BL822" "ALS_BL831" "ALS_BL832" "ALS_BL1222" "NSLS2_FMX" "NSLS2_AMX" "NSLS2_NYX" "NSLS2_LIX" "APS_GMCA_23IDB" "APS_GMCA_23IDD" "APS_LSCAT_21ID" "APS_LSCAT_21IDD" "APS_LSCAT_21IDF" "APS_LSCAT_21IDG" "APS_NECAT_24IDC" "APS_NECAT_24IDE" "APS_SERCAT_22ID" "APS_SERCAT_22BM" "APS_SBCCAT_19ID" "APS_SBCCAT_19BM" "APS_BIOCARS_14ID" "APS_BIOCAT_18ID" "APS_IMCACAT_17ID" "SSRL_BL92" "SSRL_BL121" "SSRL_BL122" "SSRL_BL141" "SNS_MANDI" "HFIR_IMAGINE" "SNS_BIOSANS" "SNS_EQSANS" ) ] ) ;
            sh:order 27 ;
            sh:path lambdaber:instrument_registry_id ],
        [ sh:datatype xsd:string ;
            sh:description "Detector dimensions in pixels (e.g., 4096x4096, 5760x4092)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path lambdaber:detector_dimensions ],
        [ sh:datatype xsd:string ;
            sh:description "Instrument manufacturer" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path lambdaber:manufacturer ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Objective aperture size in micrometers" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path lambdaber:objective_aperture ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path dcterms:title ],
        [ sh:description "Imaging mode for electron microscopy" ;
            sh:in ( "EFTEM" "TEM" "STEM" ) ;
            sh:maxCount 1 ;
            sh:order 24 ;
            sh:path lambdaber:imaging_mode ],
        [ sh:datatype xsd:string ;
            sh:description "Energy filter manufacturer" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path lambdaber:energy_filter_make ],
        [ sh:datatype xsd:string ;
            sh:description "Date of instrument installation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path lambdaber:installation_date ],
        [ sh:datatype xsd:string ;
            sh:description "Energy filter model" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path lambdaber:energy_filter_model ],
        [ sh:description "Generic detector technology type" ;
            sh:in ( "direct_electron_detector" "ccd" "cmos" "hybrid_photon_counting" "scintillator_coupled" "imaging_plate" "film" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path lambdaber:detector_technology ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Spherical aberration (Cs) in millimeters" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path lambdaber:cs ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Electron beam spot size setting" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path lambdaber:spotsize ],
        [ sh:datatype xsd:string ;
            sh:description "Beamline identifier at synchrotron/neutron facility" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path lambdaber:beamline_id ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether energy filter is present" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path lambdaber:energy_filter_present ],
        [ sh:description "Name of the research facility where the instrument is located" ;
            sh:in ( ROR:01q47ea17 ROR:02jbv0t02 ROR:05gzmn429 ROR:02550n020 ROR:05etxs293 ROR:01g5y5k24 ROR:05gvnxz63 ROR:01xjv7358 ROR:01js2sh04 ROR:01ydb3330 ROR:03vk18a84 ROR:05h992307 ROR:01qz5mb56 ROR:01qz5mb56 ) ;
            sh:maxCount 1 ;
            sh:order 29 ;
            sh:path lambdaber:facility_name ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Physical pixel size of the detector in micrometers" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path lambdaber:pixel_size_physical_um ],
        [ sh:datatype xsd:string ;
            sh:description "Type of phase plate if present" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path lambdaber:phase_plate_type ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Research Organization Registry (ROR) identifier for the facility" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path lambdaber:facility_ror ;
            sh:pattern "^https://ror\\.org/\\w+$" ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Energy filter slit width in eV" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path lambdaber:energy_filter_slit_width ],
        [ sh:description "Current operational status" ;
            sh:in ( "operational" "maintenance" "offline" "commissioning" ) ;
            sh:maxCount 1 ;
            sh:order 36 ;
            sh:path lambdaber:current_status ],
        [ sh:datatype xsd:string ;
            sh:description "Human-friendly facility or laboratory identifier for the instrument (e.g., 'TITAN-KRIOS-1', 'ALS-12.3.1-SIBYLS', 'RIGAKU-FR-E'). Used for local reference and equipment tracking." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path lambdaber:instrument_code ],
        [ sh:datatype xsd:string ;
            sh:description "Microscope control software (e.g., SerialEM, EPU, Leginon)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path lambdaber:microscope_software ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "TEM beam diameter in micrometers" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path lambdaber:tem_beam_diameter ],
        [ sh:datatype xsd:string ;
            sh:description "Detector model (e.g., K3, Falcon 4i, DE-64)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path lambdaber:detector_model ],
        [ sh:datatype xsd:string ;
            sh:description "Physical position of detector in microscope (e.g., post-GIF, pre-column)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:detector_position ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Gun lens setting" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path lambdaber:gunlens ],
        [ sh:description "Category distinguishing beamlines from laboratory equipment" ;
            sh:in ( CHMO:0001084 "NEUTRON_BEAMLINE" "XFEL_BEAMLINE" "ELECTRON_MICROSCOPE" "BENCHTOP_XRAY" "OPTICAL_MICROSCOPE" "SPECTROMETER" ) ;
            sh:maxCount 1 ;
            sh:order 28 ;
            sh:path lambdaber:instrument_category ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Accelerating voltage in kV" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:accelerating_voltage ],
        [ sh:datatype xsd:string ;
            sh:description "Software version" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path lambdaber:microscope_software_version ],
        [ sh:datatype xsd:boolean ;
            sh:description "Spherical aberration corrector present" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lambdaber:cs_corrector ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "C2 aperture size in micrometers" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path lambdaber:c2_aperture ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path lambdaber:id ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Number of grids the autoloader can hold" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path lambdaber:autoloader_capacity ],
        [ sh:description "Supported or default detector operating mode" ;
            sh:in ( "counting" "integrating" "super_resolution" "linear" "correlated_double_sampling" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path lambdaber:detector_mode ],
        [ sh:datatype xsd:boolean ;
            sh:description "Phase plate available" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:phase_plate ],
        [ sh:class lambdaber:Organization ;
            sh:description "The Organization that operates this instrument's facility. An instrument sits at exactly one facility, so this is a direct reference rather than an association table - the same shape as Sample.parent_sample_id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 31 ;
            sh:path lambdaber:facility_organization_id ],
        [ sh:datatype xsd:string ;
            sh:description "Detector manufacturer (e.g., Gatan, ThermoFisher, DirectElectron)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:detector_manufacturer ] ;
    sh:targetClass lambdaber:CryoEMInstrument .

lambdaber:CryoEMPreparation a sh:NodeShape ;
    sh:closed true ;
    sh:description "Cryo-EM specific sample preparation" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Glow discharge atmosphere (air, amylamine)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path lambdaber:glow_discharge_atmosphere ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Blotting time, typically specified in seconds (range: 0.5-10.0). Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path lambdaber:blot_time ],
        [ sh:datatype xsd:string ;
            sh:description "Support film type" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lambdaber:support_film ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path lambdaber:description ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether glow discharge treatment was applied" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path lambdaber:glow_discharge_applied ],
        [ sh:datatype xsd:string ;
            sh:description "Vitrification instrument used (e.g., Vitrobot)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path lambdaber:vitrification_instrument ],
        [ sh:description "Method used for vitrification" ;
            sh:in ( "plunge_freezing" "high_pressure_freezing" "slam_freezing" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path lambdaber:vitrification_method ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Volume of sample applied, typically specified in microliters. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path lambdaber:sample_applied_volume ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Blotting force setting" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lambdaber:blot_force ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Number of blots applied" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path lambdaber:blot_number ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Blotter setting value. Data providers may include unit information in the QuantityValue if needed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path lambdaber:blotter_setting ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Chamber humidity during vitrification (range: 0-100), typically specified as a percentage. Data providers may specify as decimal fraction by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path lambdaber:humidity_percentage ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Ethane temperature, typically specified in degrees Celsius. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path lambdaber:ethane_temperature ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Hole size, typically specified in micrometers (range: 0.5-5.0). Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lambdaber:hole_size ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Glow discharge pressure, typically specified in millibars. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path lambdaber:glow_discharge_pressure ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Chamber temperature, typically specified in degrees Celsius. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path lambdaber:chamber_temperature ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Glow discharge time, typically specified in seconds. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path lambdaber:glow_discharge_time ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Blotter height setting. Data providers may include unit information in the QuantityValue if needed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path lambdaber:blotter_height ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Glow discharge current, typically specified in milliamperes. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path lambdaber:glow_discharge_current ],
        [ sh:datatype xsd:string ;
            sh:description "Plasma treatment details" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path lambdaber:plasma_treatment ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Wait time before blotting, typically specified in seconds. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path lambdaber:wait_time ],
        [ sh:description "Grid material" ;
            sh:in ( "carbon" "gold" "graphene" "silicon_nitride" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path lambdaber:grid_material ],
        [ sh:description "Type of EM grid used" ;
            sh:in ( "c_flat" "quantifoil" "lacey_carbon" "ultrathin_carbon" "gold" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path lambdaber:grid_type ] ;
    sh:targetClass lambdaber:CryoEMPreparation .

lambdaber:Dataset a sh:NodeShape ;
    sh:closed true ;
    sh:description "Root container holding flat entity collections and association tables. Follows relational database design patterns for structural biology data." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class lambdaber:Sample ;
            sh:description "All samples across all studies" ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path lambdaber:samples ],
        [ sh:class lambdaber:WorkflowRun ;
            sh:description "All workflow runs (computational processing)" ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path lambdaber:workflow_runs ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path lambdaber:description ],
        [ sh:class lambdaber:Organization ;
            sh:description "All organizations referenced anywhere in this dataset" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path lambdaber:organizations ],
        [ sh:class lambdaber:SamplePreparation ;
            sh:description "All sample preparations" ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path lambdaber:sample_preparations ],
        [ sh:class lambdaber:Person ;
            sh:description "All people referenced anywhere in this dataset" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path lambdaber:persons ],
        [ sh:datatype xsd:string ;
            sh:description "Keywords or tags describing the dataset for search and categorization" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path lambdaber:keywords ],
        [ sh:class lambdaber:WorkflowInputAssociation ;
            sh:description "Links between workflows and input files" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path lambdaber:workflow_input_associations ],
        [ sh:class lambdaber:ExperimentSampleAssociation ;
            sh:description "Links between experiments and samples (M:N with role)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path lambdaber:experiment_sample_associations ],
        [ sh:class lambdaber:ProteinConstruct ;
            sh:description "All protein constructs" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path lambdaber:protein_constructs ],
        [ sh:class lambdaber:ExperimentRun ;
            sh:description "All experiment runs (data collection sessions)" ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path lambdaber:experiment_runs ],
        [ sh:class lambdaber:PersonOrganizationAssociation ;
            sh:description "Links between people and organizations (M:N with role and dates)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path lambdaber:person_organization_associations ],
        [ sh:class lambdaber:DataFile ;
            sh:description "All data files" ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path lambdaber:data_files ],
        [ sh:class lambdaber:ExperimentInstrumentAssociation ;
            sh:description "Links between experiments and instruments (M:N)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path lambdaber:experiment_instrument_associations ],
        [ sh:class lambdaber:Instrument ;
            sh:description "All instruments used across studies" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path lambdaber:instruments ],
        [ sh:class lambdaber:Image ;
            sh:description "All images" ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path lambdaber:images ],
        [ sh:class lambdaber:Protein ;
            sh:description "All proteins referenced by samples in this dataset, one record per protein" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path lambdaber:proteins ],
        [ sh:class lambdaber:ExperimentPersonAssociation ;
            sh:description "Links between experiment runs and people (M:N with role)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path lambdaber:experiment_person_associations ],
        [ sh:class lambdaber:Study ;
            sh:description "All studies in this dataset" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:studies ],
        [ sh:class lambdaber:StudyExperimentAssociation ;
            sh:description "Links between studies and experiments (M:N)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path lambdaber:study_experiment_associations ],
        [ sh:class lambdaber:StudyPersonAssociation ;
            sh:description "Links between studies and people (M:N with role) - where authorship lives" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path lambdaber:study_person_associations ],
        [ sh:class lambdaber:StudyOrganizationAssociation ;
            sh:description "Links between studies and organizations (M:N with role, award number)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path lambdaber:study_organization_associations ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path lambdaber:id ],
        [ sh:class lambdaber:SampleProteinAssociation ;
            sh:description "Links between samples and the proteins they contain (M:N with role, copy number, construct)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path lambdaber:sample_protein_associations ],
        [ sh:class lambdaber:WorkflowExperimentAssociation ;
            sh:description "Links between workflows and source experiments (M:N)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path lambdaber:workflow_experiment_associations ],
        [ sh:class lambdaber:StudySampleAssociation ;
            sh:description "Links between studies and samples (M:N)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path lambdaber:study_sample_associations ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path dcterms:title ],
        [ sh:class lambdaber:WorkflowOutputAssociation ;
            sh:description "Links between workflows and output files" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path lambdaber:workflow_output_associations ],
        [ sh:class lambdaber:WorkflowPersonAssociation ;
            sh:description "Links between workflow runs and people (M:N with role)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path lambdaber:workflow_person_associations ],
        [ sh:class lambdaber:StudyWorkflowAssociation ;
            sh:description "Links between studies and workflows (M:N)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path lambdaber:study_workflow_associations ] ;
    sh:targetClass lambdaber:Dataset .

lambdaber:FTIRImage a sh:NodeShape ;
    sh:closed true ;
    sh:description "Fourier Transform Infrared (FTIR) spectroscopy image capturing molecular composition through vibrational spectroscopy" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class nmdc:QuantityValue ;
            sh:description "Pixel size, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path lambdaber:pixel_size ],
        [ sh:datatype xsd:string ;
            sh:description "Image file name" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:file_name ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Spectral resolution, typically specified in inverse centimeters (cm⁻¹). Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lambdaber:spectral_resolution ],
        [ sh:datatype xsd:string ;
            sh:description "Method used for background correction" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path lambdaber:background_correction ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Electron dose in e-/Å²" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path lambdaber:dose ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Exposure time, typically specified in seconds. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path lambdaber:exposure_time ],
        [ sh:datatype xsd:string ;
            sh:description "Identified molecular signatures or peaks" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path lambdaber:molecular_signatures ],
        [ sh:datatype xsd:string ;
            sh:description "Date image was acquired" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path lambdaber:acquisition_date ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Image width, typically specified in pixels. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path lambdaber:dimensions_x ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Image height, typically specified in pixels. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path lambdaber:dimensions_y ],
        [ sh:datatype xsd:string ;
            sh:description "Mathematical function used for apodization" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:apodization_function ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path lambdaber:id ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Number of scans averaged for the spectrum" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path lambdaber:number_of_scans ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Maximum wavenumber, typically specified in inverse centimeters (cm⁻¹). Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lambdaber:wavenumber_max ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dcterms:title ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Minimum wavenumber, typically specified in inverse centimeters (cm⁻¹). Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:wavenumber_min ] ;
    sh:targetClass lambdaber:FTIRImage .

lambdaber:FluorescenceImage a sh:NodeShape ;
    sh:closed true ;
    sh:description "Fluorescence microscopy image capturing specific molecular targets through fluorescent labeling" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class nmdc:QuantityValue ;
            sh:description "Image width, typically specified in pixels. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path lambdaber:dimensions_x ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Electron dose in e-/Å²" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path lambdaber:dose ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the fluorescence channel (e.g., DAPI, GFP, RFP)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path lambdaber:channel_name ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Laser power, typically specified in milliwatts. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path lambdaber:laser_power ],
        [ sh:datatype xsd:string ;
            sh:description "Specifications of the emission filter" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:emission_filter ],
        [ sh:datatype xsd:string ;
            sh:description "Name or type of fluorophore used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:fluorophore ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Emission wavelength, typically specified in nanometers. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lambdaber:emission_wavelength ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path lambdaber:description ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path dcterms:title ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Astigmatism value, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path lambdaber:astigmatism ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path lambdaber:id ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Quantum yield of the fluorophore" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path lambdaber:quantum_yield ],
        [ sh:datatype xsd:string ;
            sh:description "Image file name" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path lambdaber:file_name ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Pinhole size, typically specified in Airy units for confocal microscopy. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path lambdaber:pinhole_size ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Excitation wavelength, typically specified in nanometers. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:excitation_wavelength ],
        [ sh:datatype xsd:string ;
            sh:description "Date image was acquired" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path lambdaber:acquisition_date ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Image height, typically specified in pixels. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
