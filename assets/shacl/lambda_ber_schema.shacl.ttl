            sh:path lambdaber:instrument_code ],
        [ sh:datatype xsd:string ;
            sh:description "Detector manufacturer (e.g., Dectris, Bruker, Rigaku, Rayonix)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:detector_manufacturer ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Photon flux density in photons/s/mm²" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path lambdaber:flux_density ],
        [ sh:datatype xsd:string ;
            sh:description "Beamline identifier at synchrotron/neutron facility" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path lambdaber:beamline_id ],
        [ sh:description "Name of the research facility where the instrument is located" ;
            sh:in ( ROR:01q47ea17 ROR:02jbv0t02 ROR:05gzmn429 ROR:02550n020 ROR:05etxs293 ROR:01g5y5k24 ROR:05gvnxz63 ROR:01xjv7358 ROR:01js2sh04 ROR:01ydb3330 ROR:03vk18a84 ROR:05h992307 ROR:01qz5mb56 ROR:01qz5mb56 ) ;
            sh:maxCount 1 ;
            sh:order 15 ;
            sh:path lambdaber:facility_name ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Maximum X-ray energy in keV" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lambdaber:energy_max ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Maximum beam size in micrometers" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path lambdaber:beam_size_max ],
        [ sh:datatype xsd:string ;
            sh:description "Instrument manufacturer" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path lambdaber:manufacturer ],
        [ sh:datatype xsd:string ;
            sh:description "Detector model (e.g., EIGER2 X 16M, PILATUS3 X 6M, PHOTON III)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:detector_model ] ;
    sh:targetClass lambdaber:XRayInstrument .

lambdaber:XRayPreparation a sh:NodeShape ;
    sh:closed true ;
    sh:description "X-ray crystallography specific preparation" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path lambdaber:description ],
        [ sh:datatype xsd:string ;
            sh:description "Conditions for crystal soaking" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path lambdaber:soak_conditions ],
        [ sh:datatype xsd:string ;
            sh:description "Description of initial crystallization hit condition" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path lambdaber:initial_hit_condition ],
        [ sh:datatype xsd:string ;
            sh:description "Strategy used to optimize crystals" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path lambdaber:optimization_strategy ],
        [ sh:datatype xsd:string ;
            sh:description "Name of crystallization screen used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path lambdaber:screen_name ],
        [ sh:datatype xsd:string ;
            sh:description "Additives mixed with protein before crystallization" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:additives ],
        [ sh:datatype xsd:string ;
            sh:description "Compound used for soaking (ligand, heavy atom)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path lambdaber:soak_compound ],
        [ sh:description "Method used for crystallization" ;
            sh:in ( "vapor_diffusion_hanging" "vapor_diffusion_sitting" "batch" "microbatch" "lcp" "dialysis" "free_interface_diffusion" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path lambdaber:crystallization_method ],
        [ sh:datatype xsd:string ;
            sh:description "Type of seeding used (micro, macro, streak)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path lambdaber:seeding_type ],
        [ sh:datatype xsd:string ;
            sh:description "Cryoprotectant used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path lambdaber:cryoprotectant ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Reservoir volume, typically specified in microliters. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path lambdaber:reservoir_volume_ul ],
        [ sh:datatype xsd:string ;
            sh:description "Final optimized crystallization condition" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path lambdaber:optimized_condition ],
        [ sh:datatype xsd:string ;
            sh:description "Ratio of protein to reservoir solution in drop (e.g., 1:1, 2:1)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:drop_ratio_protein_to_reservoir ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Loop size, typically specified in micrometers. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path lambdaber:loop_size ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Temperature during mounting, typically specified in Kelvin. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path lambdaber:mounting_temperature ],
        [ sh:datatype xsd:string ;
            sh:description "Flash cooling protocol" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path lambdaber:flash_cooling_method ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Cryoprotectant concentration, typically specified as a percentage. Data providers may specify as decimal fraction by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path lambdaber:cryoprotectant_concentration ],
        [ sh:class lambdaber:CrystallizationConditions ;
            sh:description "Detailed crystallization conditions" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path lambdaber:crystallization_conditions ],
        [ sh:datatype xsd:string ;
            sh:description "Dilution factor for seed stock" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path lambdaber:seed_stock_dilution ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Total drop volume, typically specified in nanoliters. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path lambdaber:drop_volume_nl ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Crystallization temperature, typically specified in degrees Celsius. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path lambdaber:temperature_c ],
        [ sh:datatype xsd:string ;
            sh:description "Buffer composition for protein solution" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lambdaber:protein_buffer ],
        [ sh:datatype xsd:string ;
            sh:description "Crystal mounting method" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path lambdaber:mounting_method ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Protein concentration for crystallization in mg/mL" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:protein_concentration_mg_per_ml ],
        [ sh:datatype xsd:string ;
            sh:description "Additional notes about crystal quality and handling" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path lambdaber:crystal_notes ],
        [ sh:datatype xsd:string ;
            sh:description "Crystal dimensions in micrometers" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path lambdaber:crystal_size_um ] ;
    sh:targetClass lambdaber:XRayPreparation .

<http://w3id.org/lambda/functional_annotation/AggregatedProteinView> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Aggregated view of all structural and functional data for a protein" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Protein name" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://w3id.org/lambda/functional_annotation/protein_name> ],
        [ sh:datatype xsd:integer ;
            sh:description "NCBI taxonomy ID" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <http://w3id.org/lambda/functional_annotation/organism_id> ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/FunctionalSite> ;
            sh:description "All functional site annotations" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path <http://w3id.org/lambda/functional_annotation/functional_sites> ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/ProteinProteinInteraction> ;
            sh:description "All protein-protein interactions" ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path <http://w3id.org/lambda/functional_annotation/protein_interactions> ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path lambdaber:id ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dcterms:title ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/PostTranslationalModification> ;
            sh:description "All post-translational modifications" ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path <http://w3id.org/lambda/functional_annotation/ptms> ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/LigandInteraction> ;
            sh:description "All ligand interactions" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://w3id.org/lambda/functional_annotation/ligand_interactions> ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/BiophysicalProperty> ;
            sh:description "All biophysical properties" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://w3id.org/lambda/functional_annotation/biophysical_properties> ],
        [ sh:datatype xsd:string ;
            sh:description "UniProt accession" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <http://w3id.org/lambda/functional_annotation/uniprot_id> ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/StructuralFeature> ;
            sh:description "All structural feature annotations" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path <http://w3id.org/lambda/functional_annotation/structural_features> ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path lambdaber:description ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/ConformationalEnsemble> ;
            sh:description "Conformational ensemble data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path <http://w3id.org/lambda/functional_annotation/conformational_ensemble> ],
        [ sh:datatype xsd:string ;
            sh:description "Source organism" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://w3id.org/lambda/functional_annotation/organism> ],
        [ sh:datatype xsd:string ;
            sh:description "All PDB entries for this protein" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <http://w3id.org/lambda/functional_annotation/pdb_entries> ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/DatabaseCrossReference> ;
            sh:description "Database cross-references" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://w3id.org/lambda/functional_annotation/cross_references> ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/EvolutionaryConservation> ;
            sh:description "Conservation analysis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path <http://w3id.org/lambda/functional_annotation/evolutionary_conservation> ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/MutationEffect> ;
            sh:description "All mutation annotations" ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path <http://w3id.org/lambda/functional_annotation/mutations> ] ;
    sh:targetClass <http://w3id.org/lambda/functional_annotation/AggregatedProteinView> .

<http://w3id.org/lambda/functional_annotation/ProteinAnnotation> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Base class for all protein-related functional and structural annotations" ;
    sh:ignoredProperties ( <http://w3id.org/lambda/functional_annotation/domain_id> <http://w3id.org/lambda/functional_annotation/site_name> <http://w3id.org/lambda/functional_annotation/backbone_flexibility> <http://w3id.org/lambda/functional_annotation/secondary_structure> <http://w3id.org/lambda/functional_annotation/functional_importance> rdf:type <http://w3id.org/lambda/functional_annotation/mass_shift> <http://w3id.org/lambda/functional_annotation/disease_association> <http://w3id.org/lambda/functional_annotation/modified_residue> <http://w3id.org/lambda/functional_annotation/functional_effect> lambdaber:go_terms <http://w3id.org/lambda/functional_annotation/regulatory_role> <http://w3id.org/lambda/functional_annotation/coevolved_residues> <http://w3id.org/lambda/functional_annotation/taxonomic_range> <http://w3id.org/lambda/functional_annotation/effect_on_stability> <http://w3id.org/lambda/functional_annotation/conserved_residues> <http://w3id.org/lambda/functional_annotation/partner_chain_id> <http://w3id.org/lambda/functional_annotation/conservation_score> <http://w3id.org/lambda/functional_annotation/variable_residues> <http://w3id.org/lambda/functional_annotation/residues> <http://w3id.org/lambda/functional_annotation/complex_stability> <http://w3id.org/lambda/functional_annotation/modification_group> <http://w3id.org/lambda/functional_annotation/partner_protein_id> <http://w3id.org/lambda/functional_annotation/interaction_evidence> <http://w3id.org/lambda/functional_annotation/partner_interface_residues> <http://w3id.org/lambda/functional_annotation/alignment_depth> <http://w3id.org/lambda/functional_annotation/structural_motif> <http://w3id.org/lambda/functional_annotation/mutation_type> <http://w3id.org/lambda/functional_annotation/clinical_significance> <http://w3id.org/lambda/functional_annotation/site_type> <http://w3id.org/lambda/functional_annotation/delta_delta_g> <http://w3id.org/lambda/functional_annotation/feature_type> <http://w3id.org/lambda/functional_annotation/binding_energy> <http://w3id.org/lambda/functional_annotation/effect_on_function> lambdaber:ligand_interactions <http://w3id.org/lambda/functional_annotation/mutation> <http://w3id.org/lambda/functional_annotation/functional_impact_description> <http://w3id.org/lambda/functional_annotation/solvent_accessibility> <http://w3id.org/lambda/functional_annotation/interface_area> <http://w3id.org/lambda/functional_annotation/ec_number> <http://w3id.org/lambda/functional_annotation/conservation_method> <http://w3id.org/lambda/functional_annotation/conformational_state> <http://w3id.org/lambda/functional_annotation/enzyme> <http://w3id.org/lambda/functional_annotation/biological_assembly> <http://w3id.org/lambda/functional_annotation/domain_assignment> <http://w3id.org/lambda/functional_annotation/disorder_probability> <http://w3id.org/lambda/functional_annotation/modification_type> <http://w3id.org/lambda/functional_annotation/removal_enzyme> <http://w3id.org/lambda/functional_annotation/omim_id> <http://w3id.org/lambda/functional_annotation/dissociation_constant> <http://w3id.org/lambda/functional_annotation/allele_frequency> <http://w3id.org/lambda/functional_annotation/interface_residues> ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Range of residues (e.g., '1-100', '25,27,30-35')" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <http://w3id.org/lambda/functional_annotation/residue_range> ;
            sh:pattern "^[0-9,\\-]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Chain identifier in the PDB structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://w3id.org/lambda/functional_annotation/chain_id> ;
            sh:pattern "^[A-Za-z0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "PDB identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://w3id.org/lambda/functional_annotation/pdb_entry> ;
            sh:pattern "^[0-9][A-Za-z0-9]{3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "UniProt accession of the annotated protein, preferably as a Bioregistry CURIE (uniprot:P69905) matching Protein.uniprot_id. A bare accession (P69905) is accepted for data recorded before the CURIE form was adopted." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <http://w3id.org/lambda/functional_annotation/protein_id> ;
            sh:pattern "^(uniprot:)?([OPQ][0-9][A-Z0-9]{3}[0-9]|[A-NR-Z][0-9]([A-Z][A-Z0-9]{2}[0-9]){1,2})(-[0-9]+)?$" ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path lambdaber:id ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Evidence and Conclusion Ontology (ECO) code" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <http://w3id.org/lambda/functional_annotation/evidence_code> ],
        [ sh:datatype xsd:string ;
            sh:description "IDs of one or more publications supporting this annotation. Use PubMed IDs in the format 'PMID:XXXXXXX' or DOIs with 'DOI:' prefix." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <http://w3id.org/lambda/functional_annotation/publication_ids> ;
            sh:pattern "^(PMID:[0-9]+|DOI:10\\.[0-9]{4,}/[-._;()/:A-Za-z0-9]+)$" ],
        [ sh:description "Source database or resource that provided this annotation" ;
            sh:in ( "pdbe" "pdbe_kb" "uniprot" "pfam" "cath" "scop" "interpro" "channelsdb" "dynamine" "foldx" "p2rank" "3dligandsite" "arpeggio" "covalentizer" "depth" "elmpdb" "frustration" "kincore" "membranome" "missense3d" "mobi" "nucleos" "14_3_3_pred" "akid" "camkinet" "cansar" "credo" "klifs" "m_csm" "moondb" "pocketome" "propka" "proteins_api" "validation" "alphafold" "modbase" "swiss_model" "intact" "cosmic" "clinvar" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path <http://w3id.org/lambda/functional_annotation/source_database> ],
        [ sh:datatype xsd:string ;
            sh:description "Computational or experimental method used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <http://w3id.org/lambda/functional_annotation/annotation_method> ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path lambdaber:description ],
        [ sh:datatype xsd:float ;
            sh:description "Confidence score for the annotation (range: 0-1)" ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <http://w3id.org/lambda/functional_annotation/confidence_score> ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:title ],
        [ sh:description "Type of evidence supporting this annotation" ;
            sh:in ( "experimental" "predicted" "inferred" "literature" "author_statement" "curator_inference" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path <http://w3id.org/lambda/functional_annotation/evidence_type> ] ;
    sh:targetClass <http://w3id.org/lambda/functional_annotation/ProteinAnnotation> .

linkml:Any a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass linkml:Any .

nmdc:AttributeValue a sh:NodeShape ;
    sh:closed false ;
    sh:description "The value for any attribute of an entity. This object can hold both the un-normalized atomic value and the structured value." ;
    sh:ignoredProperties ( lambdaber:unit lambdaber:value lambdaber:maximum_numeric_value lambdaber:numeric_value lambdaber:minimum_numeric_value lambdaber:unit_cv_id lambdaber:value_cv_id rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unnormalized atomic string representation, suggested syntax {number} {unit}" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lambdaber:raw_value ],
        [ sh:class lambdaber:Attribute ;
            sh:description "The attribute being represented." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:attribute ] ;
    sh:targetClass nmdc:AttributeValue .

nmdc:DateTimeValue a sh:NodeShape ;
    sh:closed true ;
    sh:description "A date or date and time value." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The date or date/time value, expressed in ISO 8601-compatible form. Dates should be expressed as YYYY-MM-DD; times should be expressed as HH:MM:SS with optional milliseconds and an indication of the timezone." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path lambdaber:value ],
        [ sh:class lambdaber:Attribute ;
            sh:description "The attribute being represented." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lambdaber:attribute ],
        [ sh:datatype xsd:string ;
            sh:description "Unnormalized atomic string representation, suggested syntax {number} {unit}" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:raw_value ] ;
    sh:targetClass nmdc:DateTimeValue .

nmdc:TextValue a sh:NodeShape ;
    sh:closed true ;
    sh:description "A value described using a text string, optionally with a controlled vocabulary ID." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The text value" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path lambdaber:value ],
        [ sh:datatype xsd:string ;
            sh:description "For values in a controlled vocabulary, the CV ID for the value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lambdaber:value_cv_id ],
        [ sh:class lambdaber:Attribute ;
            sh:description "The attribute being represented." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lambdaber:attribute ],
        [ sh:datatype xsd:string ;
            sh:description "Unnormalized atomic string representation, suggested syntax {number} {unit}" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:raw_value ] ;
    sh:targetClass nmdc:TextValue .

lambdaber:CTFEstimationParameters a sh:NodeShape ;
    sh:closed true ;
    sh:description "Parameters specific to CTF estimation workflows" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class nmdc:QuantityValue ;
            sh:description "Accelerating voltage value used during CTF estimation, typically specified in kilovolts (kV); may differ from instrument specification. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lambdaber:voltage_used_in_estimation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Spherical aberration (Cs) value used during CTF estimation, typically specified in millimeters; may differ from instrument specification. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path lambdaber:cs_used_in_estimation ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Minimum defocus search range, typically specified in micrometers. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:defocus_search_min ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Maximum defocus search range, typically specified in micrometers. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lambdaber:defocus_search_max ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Amplitude contrast value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path lambdaber:amplitude_contrast ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Defocus search step, typically specified in micrometers. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lambdaber:defocus_step ] ;
    sh:targetClass lambdaber:CTFEstimationParameters .

lambdaber:ComputeResources a sh:NodeShape ;
    sh:closed true ;
    sh:description "Computational resources used" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "CPU hours used, measured in hours. Data providers may specify alternative time units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:cpu_hours ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Maximum memory used, typically specified in gigabytes (GB). Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lambdaber:memory_gb ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "GPU hours used, measured in hours. Data providers may specify alternative time units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lambdaber:gpu_hours ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Storage used, typically specified in gigabytes (GB). Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path lambdaber:storage_gb ] ;
    sh:targetClass lambdaber:ComputeResources .

lambdaber:CryoEMQualityMetrics a sh:NodeShape ;
    sh:closed true ;
    sh:description "Cryo-EM specific quality assessments recorded during or after data collection" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Assessment of vitreous ice thickness/quality for data collection" ;
            sh:in ( "ideal" "too_thin" "too_thick" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path lambdaber:ice_quality ],
        [ sh:description "Assessment of particle concentration on the cryo-EM grid" ;
            sh:in ( "optimal" "too_low" "too_high" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path lambdaber:particle_concentration ],
        [ sh:description "Assessment of ice contamination level on the cryo-EM grid" ;
            sh:in ( "none" "limited" "severe" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path lambdaber:ice_contamination ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:description ] ;
    sh:targetClass lambdaber:CryoEMQualityMetrics .

lambdaber:CrystallizationConditions a sh:NodeShape ;
    sh:closed true ;
    sh:description "Crystal growth conditions for X-ray crystallography (NSLS2 Crystallization mapping)" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Cryoprotectant used for crystal cooling" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path lambdaber:cryo_protectant ],
        [ sh:description "Crystallization method used" ;
            sh:in ( "vapor_diffusion_hanging" "vapor_diffusion_sitting" "batch" "microbatch" "lcp" "dialysis" "free_interface_diffusion" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path lambdaber:method ],
        [ sh:datatype xsd:string ;
            sh:description "Name of crystallization screen used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:screen_name ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for the specific crystal used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path lambdaber:crystal_id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Reservoir volume, typically specified in microliters. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path lambdaber:reservoir_volume_ul ],
        [ sh:datatype xsd:string ;
            sh:description "Type of seeding used (micro, macro, streak)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path lambdaber:seeding_type ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Crystallization temperature, typically specified in degrees Celsius. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path lambdaber:temperature_c ],
        [ sh:datatype xsd:string ;
            sh:description "Crystal dimensions in micrometers (length x width x height)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:crystal_size_um ],
        [ sh:datatype xsd:string ;
            sh:description "Complete description of crystallization conditions including precipitant, pH, salts" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lambdaber:crystallization_conditions ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Protein concentration for crystallization in mg/mL" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path lambdaber:protein_concentration ],
        [ sh:datatype xsd:string ;
            sh:description "Dilution factor for seed stock" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path lambdaber:seed_stock_dilution ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Total drop volume, typically specified in nanoliters. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lambdaber:drop_volume ],
        [ sh:datatype xsd:string ;
            sh:description "Ratio of protein to reservoir solution in drop (e.g., 1:1, 2:1)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path lambdaber:drop_ratio_protein_to_reservoir ] ;
    sh:targetClass lambdaber:CrystallizationConditions .

lambdaber:DataCollectionStrategy a sh:NodeShape ;
    sh:closed true ;
    sh:description "Strategy for data collection" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class nmdc:QuantityValue ;
            sh:description "Calibrated pixel size for this experiment, typically specified in Angstroms (Å) per pixel. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path lambdaber:pixel_size_calibrated ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Dose per frame, typically specified in electrons per Angstrom squared (e⁻/Å²). Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path lambdaber:dose_per_frame ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Beam center X coordinate in pixels" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path lambdaber:beam_center_x_px ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Beam transmission, typically specified as a percentage (0-100). Data providers may specify as decimal fraction by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path lambdaber:transmission_percent ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Detector distance, typically specified in millimeters. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path lambdaber:detector_distance_mm ],
        [ sh:datatype xsd:string ;
            sh:description "Notes about data collection strategy" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path lambdaber:strategy_notes ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path lambdaber:description ],
        [ sh:description "Detector operating mode used during this experiment" ;
            sh:in ( "counting" "integrating" "super_resolution" "linear" "correlated_double_sampling" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path lambdaber:detector_mode ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Total rotation range, typically specified in degrees. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path lambdaber:total_rotation_deg ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Total number of frames/images" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lambdaber:total_frames ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "X-ray wavelength, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lambdaber:wavelength_a ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Exposure time per image, typically specified in seconds. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path lambdaber:exposure_time ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Frame rate, typically specified in frames per second. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lambdaber:frame_rate ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Ending angle of an X-ray oscillation sweep, typically specified in degrees." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path lambdaber:sweep_end ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Data collection temperature, typically specified in Kelvin. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path lambdaber:temperature_k ],
        [ sh:datatype xsd:string ;
            sh:description "Attenuator setting used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path lambdaber:attenuator ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Starting angle of an X-ray oscillation sweep, typically specified in degrees." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path lambdaber:sweep_start ],
        [ sh:description "Mode of data collection" ;
            sh:in ( "counting" "super_resolution" "continuous" "oscillation" "still" "batch" "sec_saxs" "single_particle" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path lambdaber:collection_mode ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Photon flux, typically specified in photons per second. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path lambdaber:flux_photons_per_s ],
        [ sh:class lambdaber:BeamCenterPixels ;
            sh:description "Combined beam center pixel coordinates as reported by systems such as NSLS-II AMX. Use beam_center_x_px and beam_center_y_px when coordinates are represented as separate strategy values." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path lambdaber:beam_center_pixels ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Oscillation angle per image, typically specified in degrees. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path lambdaber:oscillation_per_image_deg ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Beam size, typically specified in micrometers. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path lambdaber:beam_size_um ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Total electron dose for cryo-EM, typically specified in electrons per Angstrom squared (e⁻/Å²). Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path lambdaber:total_dose ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Beam center Y coordinate in pixels" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path lambdaber:beam_center_y_px ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "X-ray beam energy for this data collection strategy. Data providers may specify eV, keV, or another appropriate energy unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path lambdaber:energy ] ;
    sh:targetClass lambdaber:DataCollectionStrategy .

lambdaber:ExperimentInstrumentAssociation a sh:NodeShape ;
    sh:closed true ;
    sh:description "M:N link between ExperimentRun and Instrument" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class lambdaber:ExperimentRun ;
            sh:description "Reference to the experiment run" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path lambdaber:experiment_id ],
        [ sh:class lambdaber:Instrument ;
            sh:description "Reference to the instrument" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:instrument_id ],
        [ sh:description "Role of instrument in experiment" ;
            sh:in ( "primary" "detector" "sample_handler" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path lambdaber:role ] ;
    sh:targetClass lambdaber:ExperimentInstrumentAssociation .

lambdaber:ExperimentPersonAssociation a sh:NodeShape ;
    sh:closed true ;
    sh:description "M:N link between ExperimentRun and Person with role metadata - who actually collected the data, and who was the local contact." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Capacity in which the person is attached to the experiment run" ;
            sh:in ( "principal_investigator" "co_investigator" "author" "operator" "local_contact" "analyst" "reviewer" "data_curator" "submitter" "contact" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path lambdaber:role ],
        [ sh:class lambdaber:ExperimentRun ;
            sh:description "Reference to the experiment run" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path lambdaber:experiment_id ],
        [ sh:class lambdaber:Person ;
            sh:description "Reference to the person" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:person_id ] ;
    sh:targetClass lambdaber:ExperimentPersonAssociation .

lambdaber:ExperimentSampleAssociation a sh:NodeShape ;
    sh:closed true ;
    sh:description "M:N link between ExperimentRun and Sample with role metadata" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Role of sample in experiment" ;
            sh:in ( "target" "buffer_blank" "standard" "size_marker" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path lambdaber:role ],
        [ sh:class lambdaber:Sample ;
            sh:description "Reference to the sample" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:sample_id ],
        [ sh:class lambdaber:ExperimentRun ;
            sh:description "Reference to the experiment run" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path lambdaber:experiment_id ],
        [ sh:class lambdaber:SamplePreparation ;
            sh:description "Specific preparation used for this sample in this experiment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path lambdaber:preparation_id ] ;
    sh:targetClass lambdaber:ExperimentSampleAssociation .

lambdaber:ExperimentalConditions a sh:NodeShape ;
    sh:closed true ;
    sh:description "Environmental and experimental conditions" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class nmdc:QuantityValue ;
            sh:description "Humidity, typically specified as a percentage (0-100). Data providers may specify as a decimal fraction or percentage by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lambdaber:humidity ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Pressure, typically specified in kilopascals (kPa). Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lambdaber:pressure ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Exposure time, typically specified in seconds. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lambdaber:exposure_time ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Temperature, typically specified in degrees Celsius. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:temperature ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Beam energy, typically specified in kiloelectronvolts (keV). Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path lambdaber:beam_energy ],
        [ sh:datatype xsd:string ;
            sh:description "Atmosphere composition" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:atmosphere ] ;
    sh:targetClass lambdaber:ExperimentalConditions .

lambdaber:FSCCurve a sh:NodeShape ;
    sh:closed true ;
    sh:description """Fourier Shell Correlation curve data.

The `resolution_angstrom` and `fsc_value` arrays must be of equal length, with each value at index i in `resolution_angstrom`
corresponding to the value at index i in `fsc_value`. Both arrays should not exceed 10,000 elements.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Resolution values in Angstroms" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:resolution_angstrom ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "FSC values corresponding to each resolution" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lambdaber:fsc_value ] ;
    sh:targetClass lambdaber:FSCCurve .

lambdaber:Image a sh:NodeShape ;
    sh:closed true ;
    sh:description "An image file from structural biology experiments" ;
    sh:ignoredProperties ( lambdaber:excitation_filter lambdaber:contrast_method lambdaber:stage_position_x lambdaber:ctf_quality_score lambdaber:detector_technology rdf:type lambdaber:defocus_u lambdaber:color_channels lambdaber:astigmatism lambdaber:resolution_fit_limit lambdaber:super_resolution lambdaber:dwell_time lambdaber:astigmatism_angle lambdaber:emission_wavelength lambdaber:number_of_scans lambdaber:fluorophore lambdaber:numerical_aperture lambdaber:emission_filter lambdaber:acquisition_group lambdaber:dose_per_frame lambdaber:dimensions_z lambdaber:grid_square_id lambdaber:timestamp lambdaber:stage_position_z lambdaber:origin_movie_id lambdaber:wavenumber_min lambdaber:quantum_yield lambdaber:background_correction lambdaber:detector_model lambdaber:excitation_wavelength lambdaber:ice_thickness_estimate lambdaber:beam_shift_y lambdaber:defocus_v lambdaber:flux lambdaber:defocus lambdaber:stage_position_y lambdaber:spectral_resolution lambdaber:pinhole_size lambdaber:reconstruction_method lambdaber:channel_name lambdaber:illumination_type lambdaber:molecular_signatures lambdaber:hole_id lambdaber:pixel_size_unbinned lambdaber:beam_energy lambdaber:source_type lambdaber:nominal_defocus lambdaber:beam_size lambdaber:wavenumber_max lambdaber:calibration_standard lambdaber:white_balance lambdaber:beam_shift_x lambdaber:voxel_size lambdaber:apodization_function lambdaber:frames lambdaber:laser_power lambdaber:magnification lambdaber:elements_measured ) ;
    sh:property [ sh:class nmdc:QuantityValue ;
            sh:description "Image height, typically specified in pixels. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path lambdaber:dimensions_y ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:id ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "Image file name" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path lambdaber:file_name ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Image width, typically specified in pixels. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path lambdaber:dimensions_x ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Electron dose in e-/Å²" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path lambdaber:dose ],
        [ sh:datatype xsd:string ;
            sh:description "Date image was acquired" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lambdaber:acquisition_date ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Pixel size, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lambdaber:pixel_size ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Exposure time, typically specified in seconds. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lambdaber:exposure_time ] ;
    sh:targetClass lambdaber:Image .

lambdaber:MolecularComposition a sh:NodeShape ;
    sh:closed true ;
    sh:description "Molecular composition of a sample" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Amino acid or nucleotide sequences" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path lambdaber:sequences ],
        [ sh:datatype xsd:string ;
            sh:description "Bound ligands or cofactors" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:ligands ],
        [ sh:datatype xsd:string ;
            sh:description "Post-translational modifications or chemical modifications" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lambdaber:modifications ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:description ] ;
    sh:targetClass lambdaber:MolecularComposition .

lambdaber:MotionCorrectionParameters a sh:NodeShape ;
    sh:closed true ;
    sh:description "Parameters specific to motion correction workflows" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class nmdc:QuantityValue ;
            sh:description "Output binning factor. This must be a positive float value (e.g., 1, 1.5, 2, 3)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path lambdaber:output_binning ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether dose weighting was applied" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:dose_weighting ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Total drift, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path lambdaber:drift_total ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Binning factor applied during motion correction. This must be a positive float value (e.g., 1, 1.5, 2, 3)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lambdaber:binning ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether anisotropic motion correction was applied" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:anisotropic_correction ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Number of frames grouped together" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lambdaber:frame_grouping ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "B-factor for dose weighting, typically specified in Angstroms squared. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path lambdaber:bfactor_dose_weighting ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Patch size for local motion correction" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:patch_size ] ;
    sh:targetClass lambdaber:MotionCorrectionParameters .

lambdaber:ParticlePickingParameters a sh:NodeShape ;
    sh:closed true ;
    sh:description "Parameters specific to particle picking workflows" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Method used (manual, template_matching, deep_learning, LoG, Topaz, other)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path lambdaber:picking_method ],
        [ sh:datatype xsd:string ;
            sh:description "Name or identifier of the deep learning model (e.g., 'resnet16', 'resnet8', 'cryolo_general'). Use this for standard pretrained models. Either model_name or model_file_path should be provided when using deep learning methods." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path lambdaber:model_name ],
        [ sh:datatype xsd:string ;
            sh:description "Path to deep learning model file if using a local or custom trained model file. Use this instead of model_name when pointing to a specific file on disk. Either model_name or model_file_path should be provided when using deep learning methods." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path lambdaber:model_file_path ],
        [ sh:datatype xsd:string ;
            sh:description "Source or software associated with the model (e.g., 'topaz', 'cryolo', 'warp', 'custom', 'pretrained'). Helps track model provenance and should be provided alongside model_name or model_file_path to document which software/framework the model is for." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:model_source ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Power score threshold" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path lambdaber:power_score ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Picking threshold" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lambdaber:threshold ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Normalized cross-correlation score threshold" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path lambdaber:ncc_score ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Particle box size in pixels" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lambdaber:box_size ] ;
    sh:targetClass lambdaber:ParticlePickingParameters .

lambdaber:PersonOrganizationAssociation a sh:NodeShape ;
    sh:closed true ;
    sh:description "M:N link between Person and Organization with role metadata. An association table rather than a slot on Person because people hold several affiliations at once and move between them, and a dataset's provenance may need to say which affiliation applied at the time." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class lambdaber:Person ;
            sh:description "Reference to the person" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path lambdaber:person_id ],
        [ sh:datatype xsd:string ;
            sh:description "Date the affiliation ended, where known and ended" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:end_date ],
        [ sh:class lambdaber:Organization ;
            sh:description "Reference to the organization" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:organization_id ],
        [ sh:datatype xsd:string ;
            sh:description "Date the affiliation began, where known" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:start_date ],
        [ sh:description "Nature of the person's attachment to the organization" ;
            sh:in ( "host_institution" "operating_institution" "funder" "collaborating_institution" "depositor" "primary_affiliation" "secondary_affiliation" "former_affiliation" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path lambdaber:role ] ;
    sh:targetClass lambdaber:PersonOrganizationAssociation .

lambdaber:QualityMetrics a sh:NodeShape ;
    sh:closed true ;
    sh:description "Quality metrics for experiments" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class lambdaber:CryoEMQualityMetrics ;
            sh:description "Cryo-EM specific quality assessments of the imaged grid (ice contamination, ice quality, particle concentration)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 31 ;
            sh:path lambdaber:grid_quality ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Half-set correlation coefficient CC(1/2)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path lambdaber:cc_half ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Percentage of Ramachandran outliers" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path lambdaber:ramachandran_outliers_percent ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Mean I/sigma(I)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path lambdaber:mean_i_over_sigma_i ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether anomalous signal was used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path lambdaber:anomalous_used ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Anomalous correlation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path lambdaber:anom_corr ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Wilson B-factor in Angstroms squared" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path lambdaber:wilson_b_factor_a2 ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Radius of gyration, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 30 ;
            sh:path lambdaber:rg ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Unit cell parameter a, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path lambdaber:unit_cell_a ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Resolution, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:resolution ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Unit cell angle gamma, typically specified in degrees. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path lambdaber:unit_cell_gamma ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Unit cell angle alpha, typically specified in degrees. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path lambdaber:unit_cell_alpha ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Rpim - precision-indicating merging R-factor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path lambdaber:r_pim ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Signal to noise ratio" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lambdaber:signal_to_noise ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Percentage of residues in favored Ramachandran regions" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path lambdaber:ramachandran_favored_percent ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Low resolution limit, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lambdaber:resolution_low_a ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Data completeness, typically specified as a percentage (0-100). Data providers may specify as decimal fraction by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path lambdaber:completeness ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Unit cell parameter c, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path lambdaber:unit_cell_c ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Average B-factor in Angstroms squared" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path lambdaber:average_b_factor_a2 ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "MolProbity clashscore" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path lambdaber:clashscore ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "High resolution shell limit, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lambdaber:resolution_high_shell_a ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Data multiplicity (redundancy)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path lambdaber:multiplicity ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Unit cell angle beta, typically specified in degrees. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path lambdaber:unit_cell_beta ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Overall MolProbity score" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path lambdaber:molprobity_score ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Rmerge - merge R-factor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path lambdaber:r_merge ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "R-factor for crystallography (deprecated, use r_work)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 32 ;
            sh:path lambdaber:r_factor ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Completeness in highest resolution shell, typically specified as a percentage (0-100). Data providers may specify as decimal fraction by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path lambdaber:completeness_high_res_shell_percent ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Anomalous signal strength" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path lambdaber:anom_sig_ano ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Refinement R-factor (working set)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path lambdaber:r_work ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Forward scattering intensity I(0)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path lambdaber:i_zero ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Unit cell parameter b, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path lambdaber:unit_cell_b ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "R-free (test set)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path lambdaber:r_free ],
        [ sh:datatype xsd:string ;
            sh:description "Crystallographic space group" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:space_group ] ;
    sh:targetClass lambdaber:QualityMetrics .

lambdaber:RefinementParameters a sh:NodeShape ;
    sh:closed true ;
    sh:description "Parameters specific to 3D refinement workflows" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether gold-standard refinement was used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:gold_standard ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Resolution at FSC=0.5, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path lambdaber:resolution_0_5 ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Pixel size, typically specified in Angstroms per pixel. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lambdaber:pixel_size ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Resolution at FSC=0.143, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lambdaber:resolution_0_143 ],
        [ sh:description "Symmetry applied (C1, Cn, Dn, T, O, I)" ;
            sh:in ( "C1" "C2" "C3" "C4" "C5" "C6" "C7" "C8" "C9" "C10" "D2" "D3" "D4" "D5" "D6" "D7" "D8" "D9" "D10" "T" "O" "I" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path lambdaber:symmetry ],
        [ sh:datatype xsd:string ;
            sh:description "Strategy for data splitting" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:split_strategy ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "B-factor used for map sharpening, typically specified in Angstroms squared (Å²). Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path lambdaber:map_sharpening_bfactor ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Box size in pixels" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lambdaber:box_size ] ;
    sh:targetClass lambdaber:RefinementParameters .

lambdaber:SANSConfiguration a sh:NodeShape ;
    sh:closed true ;
    sh:description "Experimental configuration for a SANS instrument" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class nmdc:QuantityValue ;
            sh:description "Maximum q value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lambdaber:q_max ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Sample aperture to silicon window distance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path lambdaber:sample_ap_to_si_distance ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Minimum q value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:q_min ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Source aperture diameter" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path lambdaber:source_aperature_diameter ],
        [ sh:datatype xsd:string ;
            sh:description "Attenuator setting" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:attenuator ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Source aperture to sample aperture distance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path lambdaber:source_ap_to_sample_ap_distance ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Source aperture to silicon window distance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path lambdaber:source_ap_to_siwindow_distance ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Sample aperture to sample distance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path lambdaber:sample_ap_to_sample_distance ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Silicon window to main instrument distance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path lambdaber:siwindow_to_main_distance ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of neutron guides" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:number_of_guides ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Sample aperture to main instrument distance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path lambdaber:sample_ap_to_main_distance ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Sample aperture diameter" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lambdaber:sample_aperature_diameter ] ;
    sh:targetClass lambdaber:SANSConfiguration .

lambdaber:SANSDetector a sh:NodeShape ;
    sh:closed true ;
    sh:description "Description of a detector used in a SANS instrument" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Type of beam trap (if any)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:beam_trap_type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Rotation angle of the detector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path lambdaber:rotation_angle ],
        [ sh:datatype xsd:string ;
            sh:description "Type of detector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lambdaber:detector_type ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Pixel size in x-direction" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path lambdaber:pixel_size_x ],
        [ sh:datatype xsd:string ;
            sh:description "User-assigned detector name" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path lambdaber:detector_name ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Distance from sample to detector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lambdaber:sample_detector_distance ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Y coordinate of beam trap" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path lambdaber:beam_trap_position_y ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "X coordinate of beam trap" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path lambdaber:beam_trap_position_x ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the detector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:detector_description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Pixel size in y-direction" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path lambdaber:pixel_size_y ] ;
    sh:targetClass lambdaber:SANSDetector .

lambdaber:SANSSource a sh:NodeShape ;
    sh:closed true ;
    sh:description "Beam source parameters for a SANS instrument" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Type of source" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path lambdaber:source_type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Beam energy" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lambdaber:energy ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Beam flux" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path lambdaber:flux ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Wavelength spread" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path lambdaber:wavelength_spread ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Neutron wavelength" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lambdaber:wavelength ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the source" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lambdaber:source_description ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to select wavelength" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:wavelength_selection_method ] ;
    sh:targetClass lambdaber:SANSSource .

lambdaber:SampleProteinAssociation a sh:NodeShape ;
    sh:closed true ;
    sh:description "M:N link between Sample and Protein. A sample may hold several proteins - the subunits of a complex, a target with its chaperone, a fusion partner - and one protein turns up in many samples. What changes from preparation to preparation lives here: the role, the copy number, the residue range actually present, the modifications carried, the mass actually measured, and the construct it was made from." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Copies of this protein per assembly in the sample (e.g., 4 for a homotetramer, 2 for each chain of an alpha2-beta2 heterotetramer). Omit when unknown rather than assuming 1." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:copy_number ],
        [ sh:datatype xsd:string ;
            sh:description "Modifications carried by this protein in this sample: tags left on, mutations, labels, post-translational modifications" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path lambdaber:modifications ],
        [ sh:class lambdaber:Protein ;
            sh:description "Reference to the protein" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:protein_id ],
        [ sh:class lambdaber:ProteinConstruct ;
            sh:description "The construct that produced this protein in this sample, where cloning detail is recorded" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path lambdaber:construct_id ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Mass as measured for this preparation (mass spectrometry, SEC-MALS, SAXS), typically in kDa. The sequence-derived mass lives on Protein.molecular_weight_theoretical." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path lambdaber:observed_molecular_weight ],
        [ sh:datatype xsd:float ;
            sh:description "Fraction of the canonical sequence present in this sample (range: 0-1)" ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path lambdaber:sequence_coverage ],
        [ sh:class lambdaber:Sample ;
            sh:description "Reference to the sample" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path lambdaber:sample_id ],
        [ sh:datatype xsd:string ;
            sh:description "Residues of the canonical sequence present in this sample (e.g., '1-141', '25-300'), for fragments and truncations. Omit when the full-length protein is present." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path lambdaber:residue_range ;
            sh:pattern "^[0-9,\\-]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Chain identifiers this protein occupies in the deposited structure, where the sample is a PDB entity" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:chain_ids ],
        [ sh:description "Part this protein plays in the sample" ;
            sh:in ( "target" "subunit" "binding_partner" "fusion_partner" "chaperone" "contaminant" "standard" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path lambdaber:role ] ;
    sh:targetClass lambdaber:SampleProteinAssociation .

lambdaber:StorageConditions a sh:NodeShape ;
    sh:closed true ;
    sh:description "Storage conditions for samples" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class nmdc:QuantityValue ;
            sh:description "Storage temperature, typically specified in degrees Celsius. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:temperature ],
        [ sh:datatype xsd:string ;
            sh:description "Storage atmosphere conditions" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:atmosphere ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:description ],
        [ sh:datatype xsd:string ;
            sh:description "Storage duration" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lambdaber:duration ] ;
    sh:targetClass lambdaber:StorageConditions .

lambdaber:StudyExperimentAssociation a sh:NodeShape ;
    sh:closed true ;
    sh:description "M:N link between Study and ExperimentRun" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class lambdaber:Study ;
            sh:description "Reference to the study" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path lambdaber:study_id ],
        [ sh:class lambdaber:ExperimentRun ;
            sh:description "Reference to the experiment run" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:experiment_id ] ;
    sh:targetClass lambdaber:StudyExperimentAssociation .

lambdaber:StudyOrganizationAssociation a sh:NodeShape ;
    sh:closed true ;
    sh:description "M:N link between Study and Organization with role metadata - the host institution, the collaborating institutions, and who funded the work." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class lambdaber:Organization ;
            sh:description "Reference to the organization" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:organization_id ],
        [ sh:datatype xsd:string ;
            sh:description "Grant or award number, where the organization is a funder. Distinct from Study.proposal_id, which is the facility's beamtime allocation rather than the funding that paid for the science." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:award_number ],
        [ sh:class lambdaber:Study ;
            sh:description "Reference to the study" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path lambdaber:study_id ],
        [ sh:description "Capacity in which the organization is attached to the study" ;
            sh:in ( "host_institution" "operating_institution" "funder" "collaborating_institution" "depositor" "primary_affiliation" "secondary_affiliation" "former_affiliation" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path lambdaber:role ] ;
    sh:targetClass lambdaber:StudyOrganizationAssociation .

lambdaber:StudyPersonAssociation a sh:NodeShape ;
    sh:closed true ;
    sh:description "M:N link between Study and Person with role metadata. This is where authorship and responsibility for a body of work live - principal investigator, author, curator." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Position in the author list, where authorship order is meaningful. 1 is first author. Absent when the source does not state an order; do not invent one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:author_position ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether this person is a corresponding author for the study" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:corresponding ],
        [ sh:class lambdaber:Study ;
            sh:description "Reference to the study" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path lambdaber:study_id ],
        [ sh:description "Capacity in which the person is attached to the study" ;
            sh:in ( "principal_investigator" "co_investigator" "author" "operator" "local_contact" "analyst" "reviewer" "data_curator" "submitter" "contact" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path lambdaber:role ],
        [ sh:class lambdaber:Person ;
            sh:description "Reference to the person" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:person_id ] ;
    sh:targetClass lambdaber:StudyPersonAssociation .

lambdaber:StudySampleAssociation a sh:NodeShape ;
    sh:closed true ;
    sh:description "M:N link between Study and Sample with role metadata" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class lambdaber:Sample ;
            sh:description "Reference to the sample" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:sample_id ],
        [ sh:class lambdaber:Study ;
            sh:description "Reference to the study" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path lambdaber:study_id ],
        [ sh:description "Role of sample in study (e.g., target, control, reference)" ;
            sh:in ( "target" "control" "reference" "blank" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path lambdaber:role ],
        [ sh:datatype xsd:date ;
            sh:description "Date when sample was added to study" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:date_added ] ;
    sh:targetClass lambdaber:StudySampleAssociation .

lambdaber:StudyWorkflowAssociation a sh:NodeShape ;
    sh:closed true ;
    sh:description "M:N link between Study and WorkflowRun" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class lambdaber:Study ;
            sh:description "Reference to the study" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path lambdaber:study_id ],
        [ sh:class lambdaber:WorkflowRun ;
            sh:description "Reference to the workflow run" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:workflow_id ] ;
    sh:targetClass lambdaber:StudyWorkflowAssociation .

lambdaber:WorkflowExperimentAssociation a sh:NodeShape ;
    sh:closed true ;
    sh:description "M:N link between WorkflowRun and source ExperimentRuns" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class lambdaber:ExperimentRun ;
            sh:description "Reference to the source experiment run" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:experiment_id ],
        [ sh:class lambdaber:WorkflowRun ;
            sh:description "Reference to the workflow run" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path lambdaber:workflow_id ] ;
    sh:targetClass lambdaber:WorkflowExperimentAssociation .

lambdaber:WorkflowInputAssociation a sh:NodeShape ;
    sh:closed true ;
    sh:description "Links input DataFiles to WorkflowRun" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class lambdaber:WorkflowRun ;
            sh:description "Reference to the workflow run" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path lambdaber:workflow_id ],
        [ sh:description "Type of input for the workflow" ;
            sh:in ( "raw_data" "reference" "parameters" "mask" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path lambdaber:input_type ],
        [ sh:class lambdaber:DataFile ;
            sh:description "Reference to the input data file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:file_id ] ;
    sh:targetClass lambdaber:WorkflowInputAssociation .

lambdaber:WorkflowOutputAssociation a sh:NodeShape ;
    sh:closed true ;
    sh:description "Links output DataFiles to WorkflowRun" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Type of output from the workflow" ;
            sh:in ( "map" "model" "particles" "micrographs" "ctf_estimates" "metadata" "statistics" "processed_data" "log" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path lambdaber:output_type ],
        [ sh:class lambdaber:WorkflowRun ;
            sh:description "Reference to the workflow run" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path lambdaber:workflow_id ],
        [ sh:class lambdaber:DataFile ;
            sh:description "Reference to the output data file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:file_id ] ;
    sh:targetClass lambdaber:WorkflowOutputAssociation .

lambdaber:WorkflowPersonAssociation a sh:NodeShape ;
    sh:closed true ;
    sh:description "M:N link between WorkflowRun and Person with role metadata - who ran the processing, and who made the judgement calls it required." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Capacity in which the person is attached to the workflow run" ;
            sh:in ( "principal_investigator" "co_investigator" "author" "operator" "local_contact" "analyst" "reviewer" "data_curator" "submitter" "contact" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path lambdaber:role ],
        [ sh:class lambdaber:WorkflowRun ;
            sh:description "Reference to the workflow run" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path lambdaber:workflow_id ],
        [ sh:class lambdaber:Person ;
            sh:description "Reference to the person" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:person_id ] ;
    sh:targetClass lambdaber:WorkflowPersonAssociation .

<http://w3id.org/lambda/functional_annotation/ConformationalState> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Individual conformational state" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "PDB entries representing this state" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://w3id.org/lambda/functional_annotation/pdb_entries> ],
        [ sh:datatype xsd:string ;
            sh:description "Key features of this conformation" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <http://w3id.org/lambda/functional_annotation/characteristic_features> ],
        [ sh:datatype xsd:float ;
            sh:description "Relative population of this state (range: 0-1)" ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <http://w3id.org/lambda/functional_annotation/population> ],
        [ sh:datatype xsd:float ;
            sh:description "RMSD from reference structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <http://w3id.org/lambda/functional_annotation/rmsd_from_reference> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:description ],
        [ sh:datatype xsd:string ;
            sh:description "Descriptive name (e.g., 'open', 'closed')" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://w3id.org/lambda/functional_annotation/state_name> ],
        [ sh:datatype xsd:float ;
            sh:description "Relative free energy (kcal/mol)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <http://w3id.org/lambda/functional_annotation/free_energy> ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this state" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <http://w3id.org/lambda/functional_annotation/state_id> ] ;
    sh:targetClass <http://w3id.org/lambda/functional_annotation/ConformationalState> .

<http://w3id.org/lambda/functional_annotation/MeasurementConditions> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Conditions under which biophysical measurements were made" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:title ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "pH value of the solution during measurement (range: 0-14), typically expressed in pH units. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <http://w3id.org/lambda/functional_annotation/ph> ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Temperature during measurement, typically specified in Kelvin. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://w3id.org/lambda/functional_annotation/temperature> ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Ionic strength, typically specified in molar (mol/L). Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <http://w3id.org/lambda/functional_annotation/ionic_strength> ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:id ],
        [ sh:class lambdaber:BufferComposition ;
            sh:description "Composition of the buffer used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <http://w3id.org/lambda/functional_annotation/buffer_composition> ] ;
    sh:targetClass <http://w3id.org/lambda/functional_annotation/MeasurementConditions> .

lambdaber:BeamCenterPixels a sh:NodeShape ;
    sh:closed true ;
    sh:description "Combined beam center coordinates in detector pixel units" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class nmdc:QuantityValue ;
            sh:description "Beam center X coordinate in pixels" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:xbeam ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Beam center Y coordinate in pixels" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lambdaber:ybeam ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:description ] ;
    sh:targetClass lambdaber:BeamCenterPixels .

lambdaber:BufferComposition a sh:NodeShape ;
    sh:closed true ;
    sh:description "Buffer composition for sample storage" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Buffer components and their concentrations" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lambdaber:components ],
        [ sh:datatype xsd:string ;
            sh:description "Additional additives in the buffer" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:additives ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "pH of the buffer (range: 0-14)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path lambdaber:ph ] ;
    sh:targetClass lambdaber:BufferComposition .

lambdaber:Instrument a sh:NodeShape ;
    sh:closed true ;
    sh:description "An instrument used to collect data" ;
    sh:ignoredProperties ( lambdaber:lims_system lambdaber:control_system lambdaber:monochromator_type lambdaber:energy_max lambdaber:cs lambdaber:energy_filter_slit_width lambdaber:detector_manufacturer lambdaber:detector_technology lambdaber:spotsize rdf:type lambdaber:pixel_size_physical_um lambdaber:c2_aperture lambdaber:microscope_software_version lambdaber:website lambdaber:cs_corrector lambdaber:sample_changer_capacity lambdaber:imaging_mode lambdaber:beam_size_min lambdaber:detector_dimensions lambdaber:gunlens lambdaber:detector_distance_min lambdaber:technique lambdaber:tem_beam_diameter lambdaber:temperature_control_range lambdaber:q_range_max lambdaber:phase_plate_type lambdaber:detector_distance_max lambdaber:microscope_software lambdaber:environment lambdaber:autoloader_capacity lambdaber:detector_model lambdaber:daq_system lambdaber:beam_size_max lambdaber:crystal_cooling_capability lambdaber:objective_aperture lambdaber:phase_plate lambdaber:energy_filter_model lambdaber:energy_min lambdaber:mail_in_service lambdaber:goniometer_type lambdaber:source lambdaber:source_type lambdaber:pixel_size_physical lambdaber:flux_density lambdaber:detector_mode lambdaber:energy_filter_make lambdaber:accelerating_voltage lambdaber:configuration lambdaber:energy_filter_present lambdaber:detectors lambdaber:detector_position lambdaber:techniques_supported lambdaber:q_range_min ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-friendly facility or laboratory identifier for the instrument (e.g., 'TITAN-KRIOS-1', 'ALS-12.3.1-SIBYLS', 'RIGAKU-FR-E'). Used for local reference and equipment tracking." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path lambdaber:instrument_code ],
        [ sh:description "Category distinguishing beamlines from laboratory equipment" ;
            sh:in ( CHMO:0001084 "NEUTRON_BEAMLINE" "XFEL_BEAMLINE" "ELECTRON_MICROSCOPE" "BENCHTOP_XRAY" "OPTICAL_MICROSCOPE" "SPECTROMETER" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path lambdaber:instrument_category ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Research Organization Registry (ROR) identifier for the facility" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:facility_ror ;
            sh:pattern "^https://ror\\.org/\\w+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Instrument manufacturer" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:manufacturer ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path lambdaber:id ],
        [ sh:datatype xsd:string ;
            sh:description "Date of instrument installation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path lambdaber:installation_date ],
        [ sh:description "Controlled-vocabulary identifier linking this instrument to its canonical entry in a registry enum appropriate to the instrument type. For beamlines, use a value from BeamlineEnum; additional instrument-type registries may be referenced here as they are introduced." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "ALS_SIBYLS" "ALS_BL501" "ALS_BL502" "ALS_BL821" "ALS_BL822" "ALS_BL831" "ALS_BL832" "ALS_BL1222" "NSLS2_FMX" "NSLS2_AMX" "NSLS2_NYX" "NSLS2_LIX" "APS_GMCA_23IDB" "APS_GMCA_23IDD" "APS_LSCAT_21ID" "APS_LSCAT_21IDD" "APS_LSCAT_21IDF" "APS_LSCAT_21IDG" "APS_NECAT_24IDC" "APS_NECAT_24IDE" "APS_SERCAT_22ID" "APS_SERCAT_22BM" "APS_SBCCAT_19ID" "APS_SBCCAT_19BM" "APS_BIOCARS_14ID" "APS_BIOCAT_18ID" "APS_IMCACAT_17ID" "SSRL_BL92" "SSRL_BL121" "SSRL_BL122" "SSRL_BL141" "SNS_MANDI" "HFIR_IMAGINE" "SNS_BIOSANS" "SNS_EQSANS" ) ] ) ;
            sh:order 1 ;
            sh:path lambdaber:instrument_registry_id ],
        [ sh:class lambdaber:Organization ;
            sh:description "The Organization that operates this instrument's facility. An instrument sits at exactly one facility, so this is a direct reference rather than an association table - the same shape as Sample.parent_sample_id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path lambdaber:facility_organization_id ],
        [ sh:datatype xsd:string ;
            sh:description "Beamline identifier at synchrotron/neutron facility" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path lambdaber:beamline_id ],
        [ sh:datatype xsd:string ;
            sh:description "Instrument model" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path lambdaber:model ],
        [ sh:description "Name of the research facility where the instrument is located" ;
            sh:in ( ROR:01q47ea17 ROR:02jbv0t02 ROR:05gzmn429 ROR:02550n020 ROR:05etxs293 ROR:01g5y5k24 ROR:05gvnxz63 ROR:01xjv7358 ROR:01js2sh04 ROR:01ydb3330 ROR:03vk18a84 ROR:05h992307 ROR:01qz5mb56 ROR:01qz5mb56 ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path lambdaber:facility_name ],
        [ sh:description "Current operational status" ;
            sh:in ( "operational" "maintenance" "offline" "commissioning" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path lambdaber:current_status ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path lambdaber:description ] ;
    sh:targetClass lambdaber:Instrument .

lambdaber:ProteinConstruct a sh:NodeShape ;
    sh:closed true ;
    sh:description "Detailed information about a protein construct including cloning and sequence design" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable description of the construct" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path lambdaber:construct_description ],
        [ sh:datatype xsd:string ;
            sh:description "Method or person who verified the sequence" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path lambdaber:sequence_verified_by ],
        [ sh:datatype xsd:string ;
            sh:description "Antibiotic resistance or other selectable marker" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path lambdaber:selectable_marker ],
        [ sh:datatype xsd:string ;
            sh:description "Signal peptide sequence if present" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path lambdaber:signal_peptide ],
        [ sh:datatype xsd:anyURI ;
            sh:description "UniProt accession of the target protein as a CURIE (e.g., uniprot:P69905). Redundant with the linked Protein.uniprot_id; kept for constructs recorded before the protein is." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:uniprot_id ],
        [ sh:datatype xsd:string ;
            sh:description "N-terminal tag (e.g., His6, MBP, GST)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path lambdaber:tag_nterm ],
        [ sh:datatype xsd:string ;
            sh:description "Gene name" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:gene_name ],
        [ sh:datatype xsd:string ;
            sh:description "Notes from sequence verification" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path lambdaber:verification_notes ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Length of the protein sequence in amino acids" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lambdaber:sequence_length_aa ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path lambdaber:description ],
        [ sh:datatype xsd:string ;
            sh:description "Complete vector name" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path lambdaber:vector_name ],
        [ sh:datatype xsd:string ;
            sh:description "Company or facility that synthesized the gene" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:gene_synthesis_provider ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "Start and end positions of insert in vector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path lambdaber:insert_boundaries ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier for this construct" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path lambdaber:construct_id ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path lambdaber:id ],
        [ sh:datatype xsd:string ;
            sh:description "NCBI Taxonomy ID for source organism" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:ncbi_taxid ],
        [ sh:datatype xsd:string ;
            sh:description "Base plasmid backbone used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path lambdaber:vector_backbone ],
        [ sh:class lambdaber:Protein ;
            sh:description "The protein this construct expresses" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path lambdaber:protein_id ],
        [ sh:datatype xsd:string ;
            sh:description "Promoter used for expression" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path lambdaber:promoter ],
        [ sh:datatype xsd:string ;
            sh:description "Method used for cloning (e.g., restriction digest, Gibson, InFusion)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path lambdaber:cloning_method ],
        [ sh:datatype xsd:string ;
            sh:description "Protease cleavage site sequence" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path lambdaber:cleavage_site ],
        [ sh:datatype xsd:string ;
            sh:description "Organism for which codons were optimized" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path lambdaber:codon_optimization_organism ],
        [ sh:datatype xsd:string ;
            sh:description "C-terminal tag" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path lambdaber:tag_cterm ],
        [ sh:datatype xsd:string ;
            sh:description "Path to sequence file" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path lambdaber:sequence_file_path ] ;
    sh:targetClass lambdaber:ProteinConstruct .

lambdaber:SamplePreparation a sh:NodeShape ;
    sh:closed true ;
    sh:description "A process that prepares a sample for imaging" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Identifier or name of the person who performed the sample preparation (e.g., 'jsmith', 'John Smith', or personnel ID)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lambdaber:operator_id ],
        [ sh:datatype xsd:string ;
            sh:description "Buffer composition for lysis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path lambdaber:lysis_buffer ],
        [ sh:datatype xsd:string ;
            sh:description "Date of sample preparation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:preparation_date ],
        [ sh:datatype xsd:string ;
            sh:description "Protease used for tag cleavage" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path lambdaber:protease ],
        [ sh:datatype xsd:string ;
            sh:description "Specific strain or cell line used (e.g., BL21(DE3), Sf9, HEK293F)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path lambdaber:host_strain_or_cell_line ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether and how affinity tag was removed" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path lambdaber:tag_removal ],
        [ sh:datatype xsd:string ;
            sh:description "Ratio of protease to protein" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path lambdaber:protease_ratio ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Purity percentage by SDS-PAGE" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 39 ;
            sh:path lambdaber:purity_by_sds_page_percent ],
        [ sh:datatype xsd:string ;
            sh:description "Buffer for size-exclusion chromatography" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path lambdaber:sec_buffer ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Duration of induction, typically specified in hours. Data providers may specify alternative units (e.g., minutes, seconds) by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path lambdaber:induction_time_h ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Optical density at 600nm when induction was started. Data providers may include unit information in the QuantityValue if needed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path lambdaber:od600_at_induction ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 43 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 42 ;
            sh:path lambdaber:id ],
        [ sh:datatype xsd:string ;
            sh:description "Affinity column specifications" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path lambdaber:affinity_column ],
        [ sh:datatype xsd:string ;
            sh:description "Method used for cell lysis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path lambdaber:lysis_method ],
        [ sh:datatype xsd:string ;
            sh:description "Concentration of induction agent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path lambdaber:inducer_concentration ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 44 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Temperature during induction, typically specified in degrees Celsius. Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path lambdaber:induction_temperature_c ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Duration of protease cleavage in hours" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path lambdaber:cleavage_time_h ],
        [ sh:datatype xsd:string ;
            sh:description "Hydrophobic interaction column used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path lambdaber:hic_column ],
        [ sh:datatype xsd:string ;
            sh:description "Type of affinity chromatography" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path lambdaber:affinity_type ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed protocol description" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:protocol_description ],
        [ sh:datatype xsd:string ;
            sh:description "Growth medium used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path lambdaber:medium ],
        [ sh:datatype xsd:string ;
            sh:description "Assessment of protein aggregation state" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path lambdaber:aggregation_assessment ],
        [ sh:datatype xsd:string ;
            sh:description "Size-exclusion column used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path lambdaber:sec_column ],
        [ sh:datatype xsd:string ;
            sh:description "How the protein was aliquoted for storage" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 41 ;
            sh:path lambdaber:aliquoting ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Growth temperature, typically specified in degrees Celsius. Data providers may specify alternative units (e.g., Kelvin) by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path lambdaber:growth_temperature_c ],
        [ sh:datatype xsd:string ;
            sh:description "Second affinity or reverse affinity step" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path lambdaber:second_affinity_reverse ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to concentrate protein" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path lambdaber:concentration_method ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Final protein concentration in mg/mL" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 37 ;
            sh:path lambdaber:final_concentration_mg_per_ml ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Temperature during cleavage in Celsius" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path lambdaber:cleavage_temperature_c ],
        [ sh:datatype xsd:string ;
            sh:description "Buffer composition for elution" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path lambdaber:elution_buffer ],
        [ sh:datatype xsd:string ;
            sh:description "Time point when cells were harvested" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path lambdaber:harvest_timepoint ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Culture volume, typically specified in liters (L). Data providers may specify alternative units by including the unit in the QuantityValue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path lambdaber:culture_volume_l ],
        [ sh:datatype xsd:string ;
            sh:description "Reference to the sample being prepared" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lambdaber:sample_id ],
        [ sh:description "Ordered list of purification steps performed" ;
            sh:in ( "affinity_ni_nta" "affinity_co_nta" "affinity_strep" "affinity_mbp" "affinity_gst" "tag_cleavage" "ion_exchange" "hydrophobic_interaction" "size_exclusion" "dialysis" ) ;
            sh:order 19 ;
            sh:path lambdaber:purification_steps ],
        [ sh:datatype xsd:string ;
            sh:description "Ion-exchange column used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path lambdaber:iex_column ],
        [ sh:description "Type of sample preparation" ;
            sh:in ( "cryo_em" "xray_crystallography" "saxs" "sans" "protein_expression" "protein_purification" "negative_stain" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path lambdaber:preparation_type ],
        [ sh:datatype xsd:string ;
            sh:description "Antibiotic or selection agent used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path lambdaber:antibiotic_selection ],
        [ sh:description "Expression system used for recombinant protein production" ;
            sh:in ( "bacteria" "yeast" "insect" "mammalian" "cell_free" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path lambdaber:expression_system ],
        [ sh:datatype xsd:string ;
            sh:description "Buffer composition for washing" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path lambdaber:wash_buffer ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Total yield in milligrams" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 38 ;
            sh:path lambdaber:yield_mg ],
        [ sh:datatype xsd:string ;
            sh:description "Final buffer composition after purification" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path lambdaber:final_buffer ],
        [ sh:datatype xsd:string ;
            sh:description "Protease inhibitors added" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path lambdaber:protease_inhibitors ],
        [ sh:datatype xsd:string ;
            sh:description "Agent used to induce expression (e.g., IPTG, tetracycline)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path lambdaber:induction_agent ] ;
    sh:targetClass lambdaber:SamplePreparation .

lambdaber:Protein a sh:NodeShape ;
    sh:closed true ;
    sh:description "A protein as a biological entity: its sequence, source organism, gene, and the functional and structural annotations that hold for it regardless of any one preparation. One Protein record is shared by every Sample that contains it, through SampleProteinAssociation. Facts about a particular preparation - buffer, concentration, tags left on, the residue range actually present, the mass actually measured - stay on Sample and on the association." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://w3id.org/lambda/functional_annotation/BiophysicalProperty> ;
            sh:description "Measured or predicted biophysical properties" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path lambdaber:biophysical_properties ],
        [ sh:datatype xsd:string ;
            sh:description "Canonical one-letter amino acid sequence of the protein, without tags or other construct additions. Construct-level sequence belongs on ProteinConstruct." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path lambdaber:amino_acid_sequence ;
            sh:pattern "^[ACDEFGHIKLMNPQRSTVWYBJOUXZ]+$" ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path lambdaber:id ],
        [ sh:class lambdaber:OntologyTerm ;
            sh:description "Source organism as an NCBI Taxonomy CURIE (e.g., NCBITaxon:9606)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path lambdaber:organism ],
        [ sh:datatype xsd:anyURI ;
            sh:description "PDB entries containing this protein, as CURIEs (e.g., pdb:1HHO)" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path lambdaber:pdb_entries ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/ProteinProteinInteraction> ;
            sh:description "Protein-protein interaction annotations" ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path lambdaber:protein_interactions ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path lambdaber:description ],
        [ sh:class nmdc:QuantityValue ;
            sh:description "Mass computed from the canonical sequence, typically in kDa. A mass measured for a given preparation belongs on SampleProteinAssociation.observed_molecular_weight." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path lambdaber:molecular_weight_theoretical ],
        [ sh:datatype xsd:string ;
            sh:description "Primary gene symbol (e.g., HBA1)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lambdaber:gene_name ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Gene Ontology annotations as CURIEs (e.g., GO:0005344 for oxygen carrier activity)" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path lambdaber:go_terms ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/MutationEffect> ;
            sh:description "Known effects of mutations in this protein" ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path lambdaber:mutation_effects ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/EvolutionaryConservation> ;
            sh:description "Evolutionary conservation data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path lambdaber:evolutionary_conservation ],
        [ sh:datatype xsd:anyURI ;
            sh:description "UniProt accession as a Bioregistry CURIE (e.g., uniprot:P69905). An isoform suffix is allowed (uniprot:P69905-2). Normally identical to id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path lambdaber:uniprot_id ;
            sh:pattern "^uniprot:([OPQ][0-9][A-Z0-9]{3}[0-9]|[A-NR-Z][0-9]([A-Z][A-Z0-9]{2}[0-9]){1,2})(-[0-9]+)?$" ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/StructuralFeature> ;
            sh:description "Structural feature annotations for this protein" ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path lambdaber:structural_features ],
        [ sh:datatype xsd:string ;
            sh:description "Enzyme Commission numbers, where the protein is an enzyme (e.g., 1.1.1.1)" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path lambdaber:ec_numbers ;
            sh:pattern "^([0-9]+|-)\\.([0-9]+|-)\\.([0-9]+|-)\\.([0-9]+|n[0-9]*|-)$" ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/FunctionalSite> ;
            sh:description "Functional site annotations for this protein" ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path lambdaber:functional_sites ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/ConformationalEnsemble> ;
            sh:description "Conformational states and dynamics" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path lambdaber:conformational_ensemble ],
        [ sh:datatype xsd:integer ;
            sh:description "Length of the canonical sequence in residues" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path lambdaber:sequence_length ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text summary of molecular function, typically from UniProt" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path lambdaber:function_description ],
        [ sh:datatype xsd:string ;
            sh:description "Scientific name of the source organism. For display, and for sources that give a name but no taxonomy identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:organism_name ],
        [ sh:datatype xsd:string ;
            sh:description "Recommended protein name, as UniProt or the depositor gives it. Not required, so that a record seeded from an accession alone can be enriched from UniProt later." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lambdaber:protein_name ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/PostTranslationalModification> ;
            sh:description "Post-translational modification annotations" ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path lambdaber:ptm_annotations ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/DatabaseCrossReference> ;
            sh:description "Cross-references to external databases other than UniProt (Pfam, InterPro, ChEMBL, ...). The UniProt accession itself goes in uniprot_id." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path lambdaber:cross_references ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/LigandInteraction> ;
            sh:description "Small molecule interaction annotations" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path lambdaber:ligand_interactions ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dcterms:title ] ;
    sh:targetClass lambdaber:Protein .

<http://w3id.org/lambda/functional_annotation/BiophysicalProperty> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Measured or calculated biophysical properties" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Method used for measurement" ;
            sh:in ( "differential_scanning_calorimetry" "isothermal_titration_calorimetry" "circular_dichroism" "fluorescence_spectroscopy" "surface_plasmon_resonance" "dynamic_light_scattering" "analytical_ultracentrifugation" "nuclear_magnetic_resonance" "mass_spectrometry" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path <http://w3id.org/lambda/functional_annotation/experimental_method> ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/MeasurementConditions> ;
            sh:description "Conditions under which measurement was made. If multiple sets of conditions were used, this will represent that the same values were obtained under different conditions. If values differ under different conditions, separate BiophysicalProperty instances should be created." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <http://w3id.org/lambda/functional_annotation/measurement_conditions> ],
        [ sh:description "Type of biophysical property" ;
            sh:in ( "melting_temperature" "stability" "folding_rate" "unfolding_rate" "aggregation_propensity" "solubility" "hydrophobicity" "isoelectric_point" "extinction_coefficient" "molecular_weight" "diffusion_coefficient" "sedimentation_coefficient" "radius_of_gyration" "hydrodynamic_radius" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path <http://w3id.org/lambda/functional_annotation/property_type> ],
        [ sh:datatype xsd:float ;
            sh:description "Experimental error or uncertainty" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <http://w3id.org/lambda/functional_annotation/error> ],
        [ sh:datatype xsd:string ;
            sh:description "Unit of measurement" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://w3id.org/lambda/functional_annotation/unit> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path lambdaber:description ],
        [ sh:datatype xsd:float ;
            sh:description "Numerical value of the property" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://w3id.org/lambda/functional_annotation/value> ] ;
    sh:targetClass <http://w3id.org/lambda/functional_annotation/BiophysicalProperty> .

<http://w3id.org/lambda/functional_annotation/ConformationalEnsemble> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Ensemble of conformational states for a protein" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path lambdaber:description ],
        [ sh:datatype xsd:string ;
            sh:description "Description of transition pathways between states" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <http://w3id.org/lambda/functional_annotation/transition_pathways> ],
        [ sh:datatype xsd:string ;
            sh:description "Method used for conformational clustering" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://w3id.org/lambda/functional_annotation/clustering_method> ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "Description of principal motions" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <http://w3id.org/lambda/functional_annotation/principal_motions> ],
        [ sh:datatype xsd:string ;
            sh:description "UniProt accession" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <http://w3id.org/lambda/functional_annotation/protein_id> ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path lambdaber:id ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the energy landscape" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <http://w3id.org/lambda/functional_annotation/energy_landscape> ],
        [ sh:datatype xsd:float ;
            sh:description "RMSD threshold for clustering (Angstroms)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <http://w3id.org/lambda/functional_annotation/rmsd_threshold> ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/ConformationalState> ;
            sh:description "Individual conformational states" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <http://w3id.org/lambda/functional_annotation/conformational_states> ] ;
    sh:targetClass <http://w3id.org/lambda/functional_annotation/ConformationalEnsemble> .

<http://w3id.org/lambda/functional_annotation/DatabaseCrossReference> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Cross-references to external databases" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Date of last update" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <http://w3id.org/lambda/functional_annotation/last_updated> ],
        [ sh:description "Name of the external database" ;
            sh:in ( "uniprot" "pdb" "pfam" "cath" "scop" "interpro" "chembl" "chebi" "pubchem" "drugbank" "omim" "clinvar" "cosmic" "gnomad" "intact" "string" "biogrid" "reactome" "kegg" "go" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path <http://w3id.org/lambda/functional_annotation/database_name> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lambdaber:description ],
        [ sh:datatype xsd:anyURI ;
            sh:description "URL to the database entry" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://w3id.org/lambda/functional_annotation/database_url> ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier in the external database" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://w3id.org/lambda/functional_annotation/database_id> ] ;
    sh:targetClass <http://w3id.org/lambda/functional_annotation/DatabaseCrossReference> .

<http://w3id.org/lambda/functional_annotation/EvolutionaryConservation> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Evolutionary conservation information" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Type of evidence supporting this annotation" ;
            sh:in ( "experimental" "predicted" "inferred" "literature" "author_statement" "curator_inference" ) ;
            sh:maxCount 1 ;
            sh:order 12 ;
            sh:path <http://w3id.org/lambda/functional_annotation/evidence_type> ],
        [ sh:datatype xsd:float ;
            sh:description "Confidence score for the annotation (range: 0-1)" ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <http://w3id.org/lambda/functional_annotation/confidence_score> ],
        [ sh:datatype xsd:string ;
            sh:description "Highly conserved residues" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://w3id.org/lambda/functional_annotation/conserved_residues> ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Evidence and Conclusion Ontology (ECO) code" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path <http://w3id.org/lambda/functional_annotation/evidence_code> ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of sequences in alignment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <http://w3id.org/lambda/functional_annotation/alignment_depth> ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path lambdaber:description ],
        [ sh:datatype xsd:string ;
            sh:description "Pairs of coevolved residues" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <http://w3id.org/lambda/functional_annotation/coevolved_residues> ],
        [ sh:datatype xsd:string ;
            sh:description "Computational or experimental method used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path <http://w3id.org/lambda/functional_annotation/annotation_method> ],
        [ sh:description "Source database or resource that provided this annotation" ;
            sh:in ( "pdbe" "pdbe_kb" "uniprot" "pfam" "cath" "scop" "interpro" "channelsdb" "dynamine" "foldx" "p2rank" "3dligandsite" "arpeggio" "covalentizer" "depth" "elmpdb" "frustration" "kincore" "membranome" "missense3d" "mobi" "nucleos" "14_3_3_pred" "akid" "camkinet" "cansar" "credo" "klifs" "m_csm" "moondb" "pocketome" "propka" "proteins_api" "validation" "alphafold" "modbase" "swiss_model" "intact" "cosmic" "clinvar" ) ;
            sh:maxCount 1 ;
            sh:order 14 ;
            sh:path <http://w3id.org/lambda/functional_annotation/source_database> ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title for this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "IDs of one or more publications supporting this annotation. Use PubMed IDs in the format 'PMID:XXXXXXX' or DOIs with 'DOI:' prefix." ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path <http://w3id.org/lambda/functional_annotation/publication_ids> ;
            sh:pattern "^(PMID:[0-9]+|DOI:10\\.[0-9]{4,}/[-._;()/:A-Za-z0-9]+)$" ],
        [ sh:datatype xsd:string ;
            sh:description "Highly variable residues" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://w3id.org/lambda/functional_annotation/variable_residues> ],
        [ sh:datatype xsd:string ;
            sh:description "PDB identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <http://w3id.org/lambda/functional_annotation/pdb_entry> ;
            sh:pattern "^[0-9][A-Za-z0-9]{3}$" ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path lambdaber:id ],
        [ sh:datatype xsd:string ;
            sh:description "Method used for conservation analysis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <http://w3id.org/lambda/functional_annotation/conservation_method> ],
        [ sh:datatype xsd:string ;
            sh:description "Chain identifier in the PDB structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <http://w3id.org/lambda/functional_annotation/chain_id> ;
            sh:pattern "^[A-Za-z0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "UniProt accession of the annotated protein, preferably as a Bioregistry CURIE (uniprot:P69905) matching Protein.uniprot_id. A bare accession (P69905) is accepted for data recorded before the CURIE form was adopted." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <http://w3id.org/lambda/functional_annotation/protein_id> ;
            sh:pattern "^(uniprot:)?([OPQ][0-9][A-Z0-9]{3}[0-9]|[A-NR-Z][0-9]([A-Z][A-Z0-9]{2}[0-9]){1,2})(-[0-9]+)?$" ],
        [ sh:datatype xsd:string ;
            sh:description "Range of residues (e.g., '1-100', '25,27,30-35')" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path <http://w3id.org/lambda/functional_annotation/residue_range> ;
            sh:pattern "^[0-9,\\-]+$" ],
        [ sh:datatype xsd:float ;
            sh:description "Overall conservation score (range: 0-1)" ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <http://w3id.org/lambda/functional_annotation/conservation_score> ],
        [ sh:datatype xsd:string ;
            sh:description "Taxonomic range of conservation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <http://w3id.org/lambda/functional_annotation/taxonomic_range> ] ;
    sh:targetClass <http://w3id.org/lambda/functional_annotation/EvolutionaryConservation> .

<http://w3id.org/lambda/functional_annotation/FunctionalSite> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Functional sites including catalytic, binding, and regulatory sites" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Evolutionary conservation score (range: 0-1)" ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <http://w3id.org/lambda/functional_annotation/conservation_score> ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Evidence and Conclusion Ontology (ECO) code" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path <http://w3id.org/lambda/functional_annotation/evidence_code> ],
        [ sh:datatype xsd:string ;
            sh:description "Description of functional importance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <http://w3id.org/lambda/functional_annotation/functional_importance> ],
        [ sh:datatype xsd:string ;
            sh:description "Chain identifier in the PDB structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path <http://w3id.org/lambda/functional_annotation/chain_id> ;
            sh:pattern "^[A-Za-z0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "PDB identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <http://w3id.org/lambda/functional_annotation/pdb_entry> ;
            sh:pattern "^[0-9][A-Za-z0-9]{3}$" ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path lambdaber:id ],
        [ sh:datatype xsd:string ;
            sh:description "Computational or experimental method used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path <http://w3id.org/lambda/functional_annotation/annotation_method> ],
        [ sh:datatype xsd:string ;
            sh:description "A detailed textual description of this entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path lambdaber:description ],
        [ sh:class <http://w3id.org/lambda/functional_annotation/LigandInteraction> ;
            sh:description "Ligands that interact with this site" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://w3id.org/lambda/functional_annotation/ligand_interactions> ],
        [ sh:datatype xsd:string ;
            sh:description "List of residues forming the functional site. Each should be specified as a string (e.g., \"45\", \"120A\")." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://w3id.org/lambda/functional_annotation/residues> ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Associated Gene Ontology terms" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <http://w3id.org/lambda/functional_annotation/go_terms> ],
        [ sh:datatype xsd:string ;
            sh:description "Enzyme Commission number for catalytic sites" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <http://w3id.org/lambda/functional_annotation/ec_number> ;
            sh:pattern "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" ],
        [ sh:datatype xsd:float ;
            sh:description "Confidence score for the annotation (range: 0-1)" ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <http://w3id.org/lambda/functional_annotation/confidence_score> ],
        [ sh:datatype xsd:string ;
            sh:description "Common name for this site" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://w3id.org/lambda/functional_annotation/site_name> ],
        [ sh:datatype xsd:string ;
            sh:description "UniProt accession of the annotated protein, preferably as a Bioregistry CURIE (uniprot:P69905) matching Protein.uniprot_id. A bare accession (P69905) is accepted for data recorded before the CURIE form was adopted." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <http://w3id.org/lambda/functional_annotation/protein_id> ;
            sh:pattern "^(uniprot:)?([OPQ][0-9][A-Z0-9]{3}[0-9]|[A-NR-Z][0-9]([A-Z][A-Z0-9]{2}[0-9]){1,2})(-[0-9]+)?$" ],
        [ sh:description "Type of evidence supporting this annotation" ;
