lambda:additives a owl:DatatypeProperty .

lambda:beamline_id a owl:DatatypeProperty ;
    rdfs:label "beamline_id" ;
    skos:definition "Beamline identifier at synchrotron/neutron facility" ;
    skos:exactMatch <http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_diffrn_source.pdbx_synchrotron_beamline>,
        <https://github.com/NSLS2/BER-LAMBDA/Beamline>,
        <https://ispyb.github.io/ISPyB/BLSession.beamLineName> ;
    skos:inScheme lambda: ;
    skos:note "Examples: '12.3.1' (ALS), '17-ID-1' (NSLS-II), 'I04' (Diamond)",
        "For a validated controlled-vocabulary identity, also set instrument_registry_id (e.g., APS_SBCCAT_19ID)",
        "Use facility-specific naming convention" .

lambda:data_type a owl:ObjectProperty ;
    rdfs:label "data_type" ;
    skos:closeMatch <https://mmcif.wwpdb.org/dictionaries/mmcif_ihm_ext.dic/Items/_ihm_dataset_list.data_type> ;
    skos:definition "Type of data in the file" ;
    skos:inScheme lambda: .

lambda:experiment_date a owl:DatatypeProperty ;
    rdfs:label "experiment_date" ;
    skos:definition "Date of the experiment" ;
    skos:inScheme lambda: .

lambda:facility_name a owl:ObjectProperty ;
    rdfs:label "facility_name" ;
    skos:definition "Name of the research facility where the instrument is located" ;
    skos:inScheme lambda: ;
    skos:note "Leave empty for laboratory-based instruments",
        "Select from the standardized list of major synchrotron facilities" .

lambda:file_format a owl:ObjectProperty ;
    rdfs:label "file_format" ;
    skos:closeMatch <https://mmcif.wwpdb.org/dictionaries/mmcif_ihm_ext.dic/Items/_ihm_external_files.file_format> ;
    skos:definition "File format" ;
    skos:inScheme lambda: .

lambda:instrument_code a owl:DatatypeProperty ;
    rdfs:label "instrument_code" ;
    skos:definition "Human-friendly facility or laboratory identifier for the instrument (e.g., 'TITAN-KRIOS-1', 'ALS-12.3.1-SIBYLS', 'RIGAKU-FR-E'). Used for local reference and equipment tracking." ;
    skos:inScheme lambda: .

lambda:keywords a owl:DatatypeProperty .

lambda:numeric_value a owl:DatatypeProperty ;
    rdfs:label "numeric_value" ;
    rdfs:range xsd:float ;
    skos:definition "The numerical part of a quantity value, expressed as a number." ;
    skos:inScheme lambda:types ;
    skos:mappingRelation <http://qudt.org/1.1/schema/qudt#quantityValue>,
        sdo:value,
        <https://w3id.org/nmdc/numeric_value> .

lambda:protein_name a owl:DatatypeProperty ;
    rdfs:label "protein_name" ;
    skos:definition "Name of the protein" ;
    skos:exactMatch <https://github.com/NSLS2/BER-LAMBDA/Protein_Name> ;
    skos:inScheme lambda: .

lambdarc:AdmissibilityEnum a owl:Class ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <http://w3id.org/lambda/rocrate/AdmissibilityEnum#local> <http://w3id.org/lambda/rocrate/AdmissibilityEnum#comparable> <http://w3id.org/lambda/rocrate/AdmissibilityEnum#global> ) ;
    linkml:permissible_values <http://w3id.org/lambda/rocrate/AdmissibilityEnum#comparable>,
        <http://w3id.org/lambda/rocrate/AdmissibilityEnum#global>,
        <http://w3id.org/lambda/rocrate/AdmissibilityEnum#local> .

