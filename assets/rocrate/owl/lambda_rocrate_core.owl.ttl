lambdarc:at_type a owl:DatatypeProperty ;
    rdfs:label "at_type" ;
    skos:definition """One or more types. LAMBDA entities carry the RO-Crate/schema.org type *first* so that a plain RO-Crate consumer understands the crate, then the `lambda:` type for LAMBDA-aware readers.
Modelled as the set of types it semantically is. JSON-LD also permits the shorthand of a bare string for a single type, and real crates use it freely; a reader MUST expand that shorthand to a one-element list before validating or testing membership, exactly as a JSON-LD processor would. Validation here is defined against the expanded form.""" ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "@type" .

lambdarc:conforms_to a owl:ObjectProperty ;
    rdfs:label "conforms_to" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "Specification or profile this entity claims conformance to." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "conformsTo" .

