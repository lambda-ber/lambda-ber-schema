            owl:minCardinality 0 ;
            owl:onProperty lambdarc:award_number ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:FacilityTypeEnum ;
            owl:onProperty lambdarc:facility_type ],
        lambdarc:CrateEntity ;
    skos:definition """A facility, laboratory, institution or funding body. `@id` SHOULD be a ROR identifier.
An organization appears once in the graph and is referred to by `@id` from everywhere else — the root's `publisher`, an instrument's facility, a person's affiliation. That is the whole point of a contextual entity, and it is what the schema's `Organization` class now mirrors.
`role` states the capacity in which the organization is attached to this crate's work. As with `PersonEntity`, that capacity lives on an association in the projected record (`StudyOrganizationAssociation`, `PersonOrganizationAssociation`), not on the organization.""" ;
    skos:exactMatch sdo:Organization,
        lambda:Organization ;
    skos:inScheme lambdarc:core .

