lambdarc:PackageTierEnum a owl:Class ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <http://w3id.org/lambda/rocrate/PackageTierEnum#manifest> <http://w3id.org/lambda/rocrate/PackageTierEnum#processing> <http://w3id.org/lambda/rocrate/PackageTierEnum#full> ) ;
