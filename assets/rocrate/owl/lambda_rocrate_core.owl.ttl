lambdarc:InstrumentStatusEnum a owl:Class ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <http://w3id.org/lambda/rocrate/InstrumentStatusEnum#operational> <http://w3id.org/lambda/rocrate/InstrumentStatusEnum#maintenance> <http://w3id.org/lambda/rocrate/InstrumentStatusEnum#offline> <http://w3id.org/lambda/rocrate/InstrumentStatusEnum#commissioning> ) ;
