        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:conforms_to ],
        lambdarc:CrateEntity ;
    skos:definition "Related published work - a PDB or SASBDB entry, a paper, a complementary dataset in another technique's crate. Linked, never inlined: a crystal structure belongs in its own MX crate." ;
