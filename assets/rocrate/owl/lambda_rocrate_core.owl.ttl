lambda:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:FacilityEnum ;
            owl:onProperty lambda:facility_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:facility_ror ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:current_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:instrument_registry_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:manufacturer ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:facility_ror ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:current_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:Organization ;
            owl:onProperty lambda:facility_organization_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:manufacturer ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:beamline_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:InstrumentCategoryEnum ;
            owl:onProperty lambda:instrument_category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:instrument_registry_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:instrument_category ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:beamline_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:instrument_category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:model ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:model ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:facility_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:instrument_code ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:BeamlineEnum ;
            owl:onProperty lambda:instrument_registry_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:installation_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:facility_organization_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:manufacturer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:instrument_code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:installation_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:InstrumentStatusEnum ;
            owl:onProperty lambda:current_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:facility_organization_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:model ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:beamline_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:installation_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^https://ror\\.org/\\w+$" ] ) ] ) ] ;
            owl:onProperty lambda:facility_ror ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambda:instrument_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:facility_name ],
        lambda:NamedThing ;
    skos:definition "An instrument used to collect data" ;
    skos:inScheme lambda: .

lambdarc:MissingValueDeclaration a owl:Class ;
    rdfs:label "MissingValueDeclaration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:reason ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:field ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:SufficiencyTierEnum ;
            owl:onProperty lambdarc:blocks ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:reason ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:AbsenceReasonEnum ;
            owl:onProperty lambdarc:reason ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:blocks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:field ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:blocks ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:field ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:note ],
        linkml:ClassDefinition ;
    skos:definition """A **declared absence**. The profile's central honesty rule: a value that the pipeline could not obtain is recorded as missing, with a reason and the sufficiency tier it blocks. It is never silently omitted, and never faked with an empty stand-in.
Generalized from the LAMBDA SAXS profile so that every technique extension binds to one vocabulary of absence instead of inventing its own.""" ;
    skos:inScheme lambdarc:core ;
    skos:note "`blocks` is required in practice for every reason except `not-applicable`, which by definition blocks nothing - a field that does not apply to the technique is not a gap. The conformance checker enforces that conditional; JSON Schema cannot, because the condition is on a sibling value." .

lambdarc:MutationTypeEnum a owl:Class ;
