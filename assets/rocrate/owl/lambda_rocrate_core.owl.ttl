            owl:onProperty lambdarc:term_code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:in_defined_term_set ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:url ],
        lambdarc:CrateEntity ;
    skos:definition "A controlled-vocabulary term used by reference - a facility, a technique. Carrying facility and technique as `DefinedTerm` entities rather than bare strings is what lets a federated index join across crates; the SSRL 0.2 crates already do this." ;
    skos:exactMatch sdo:DefinedTerm ;
    skos:inScheme lambdarc:core .

