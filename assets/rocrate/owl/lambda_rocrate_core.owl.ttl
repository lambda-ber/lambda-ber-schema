    skos:mappingRelation <https://w3id.org/nmdc/raw_value> .

lambda:reservoir_volume_ul a owl:ObjectProperty .

lambdarc:AffinityUnitEnum a owl:Class ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <http://w3id.org/lambda/rocrate/AffinityUnitEnum#molar> <http://w3id.org/lambda/rocrate/AffinityUnitEnum#millimolar> <http://w3id.org/lambda/rocrate/AffinityUnitEnum#micromolar> <http://w3id.org/lambda/rocrate/AffinityUnitEnum#nanomolar> <http://w3id.org/lambda/rocrate/AffinityUnitEnum#picomolar> ) ;
    linkml:permissible_values <http://w3id.org/lambda/rocrate/AffinityUnitEnum#micromolar>,
        <http://w3id.org/lambda/rocrate/AffinityUnitEnum#millimolar>,
        <http://w3id.org/lambda/rocrate/AffinityUnitEnum#molar>,
        <http://w3id.org/lambda/rocrate/AffinityUnitEnum#nanomolar>,
        <http://w3id.org/lambda/rocrate/AffinityUnitEnum#picomolar> .

