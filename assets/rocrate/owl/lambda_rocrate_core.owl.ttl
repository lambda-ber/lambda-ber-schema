lambdarc:at_id a owl:DatatypeProperty ;
    rdfs:label "at_id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The entity's identifier - a relative path, an absolute URI, or a `#`-fragment." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "@id" .

lambdarc:EntityReference a owl:Class ;
    rdfs:label "EntityReference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:at_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty lambdarc:at_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:at_id ],
        linkml:ClassDefinition ;
    skos:definition "A `{\"@id\": \"...\"}` reference to another entity in the graph, or to an external resource. This is how RO-Crate expresses every relationship; it is never a bare string." ;
    skos:inScheme lambdarc:core .

lambdarc:core a owl:Ontology ;
    rdfs:label "lambda-rocrate-core" ;
    dcterms:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    dcterms:title "LAMBDA Core RO-Crate Profile" ;
    pav:version "0.3.0" ;
    skos:definition """**LAMBDA Core RO-Crate profile** — the technique-neutral file-manifest contract for LAMBDA.

A LAMBDA crate is a machine-readable *manifest*: it carries the highest-level details a program
needs in order to decide whether a dataset is worth opening, and then **points** at the fuller
record rather than restating it. The fuller record may be another RO-Crate, a complete
`lambda-ber-schema` document, or a remote registration (DOI / archive accession).

## Relationship to `lambda-ber-schema`

This module *mirrors* `lambda-ber-schema`; it does not copy it. It `imports` the main schema, so
every controlled vocabulary (`TechniqueEnum`, `FacilityEnum`, `FileFormatEnum`, `DataTypeEnum`,
`WorkflowTypeEnum`, `SampleTypeEnum`, …) is *referenced* from its single source. Every crate slot
that has a counterpart in the main schema declares it with `exact_mappings`, so
`gen-sssom` emits a machine-readable crate-term to schema-slot crosswalk instead of a
hand-maintained table that drifts.

## Term layers

Three namespaces, by design (the two-layer discipline of the LAMBDA SAXS profile, plus RO-Crate's
own base):

- `sdo:` (schema.org) — identity, access and packaging. Anything RO-Crate/schema.org already
  names (`name`, `datePublished`, `license`, `author`, `hasPart`, `encodingFormat`,
  `contentSize`, …) uses the schema.org term, in schema.org's own camelCase. Note the **http**
  form of the namespace, and see the prefix comment below for why it is not called `schema:`
  here. Crate authors never write this prefix — RO-Crate's context resolves the bare terms.
- `lambda:` — terms that project onto a `lambda-ber-schema` slot. These deliberately keep the
  schema's `snake_case` slot names, so `lambda:file_format` in a crate *is* the `DataFile.file_format`
  slot IRI and the projection is an identity mapping rather than a lookup.
- `lambdarc:` — profile-local machinery with no schema counterpart yet (declared absence,
  sufficiency tiers, designation, estimators). camelCase, following the SAXS profile's style.
  Each of these is a standing change request against `lambda-ber-schema`.

## Namespace note

Crates MUST bind `lambda:` to `http://w3id.org/lambda/` — the main schema's own base — so that
`lambda:Dataset` and `lambda:file_format` in a crate resolve to the actual LinkML class and slot
IRIs. Earlier SSRL crates bound `lambda:` to `https://w3id.org/lambda/terms/0.2/`, whose terms
resolve to nothing in the schema; see the deprecated-alias notes on individual elements.

## Validation model

Three layers, because a flat RO-Crate `@graph` is an open world and no single tool covers it:

1. **JSON Schema** (`gen-json-schema --top-class ROCrateMetadataDocument`) checks document shape.
   `@graph` is deliberately permissive at the document level so that crates carrying technique
   extension terms still validate as documents.
2. **Per-entity classes** — dispatch a graph entity on its `@type` and validate it against the
   matching class here (`linkml-validate -C CrateFile`, …). These classes are closed, so an
   undeclared term is caught. This is where the profile actually bites.
3. **Graph rules** for the cross-entity constraints neither of the above can state, because they
   are about relationships between entities rather than the shape of any one of them: does every
   `hasPart` target resolve to an entity? does each dataset part carry a metadata pointer or
   declare that it has none? is any field both present and declared missing? These live in
   `tests/test_rocrate_profile.py`.

   SHACL shapes would be the natural home for this layer, since RDF validation dispatches on
   `rdf:type` properly. They are *not* generated: `gen-shacl` raises
   `KeyError('lambda-ber-schema')` for classes whose slots come from an imported schema
   (`shaclgen.py::_build_ignored_properties`). Worth revisiting when that is fixed upstream.

Two normalizations a reader MUST apply before validating, both of them things a JSON-LD processor
does and neither of them a change of meaning: expand a single value where the profile declares a
set (`"instrument": {"@id": "#x"}` means a one-element list), and compact an explicitly prefixed
key to the profile's own term (`"lambda:protein_name"` and a context-mapped `"protein_name"` are
the same IRI, and real crates mix the two spellings within one entity).
""" .

lambda:QuantityValue a owl:Class ;
    rdfs:label "QuantityValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambda:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:minimum_numeric_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:maximum_numeric_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:unit_cv_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:numeric_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:maximum_numeric_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:unit_cv_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:minimum_numeric_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:raw_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:raw_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:unit_cv_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:maximum_numeric_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty lambda:numeric_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:raw_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:numeric_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:minimum_numeric_value ],
        lambda:AttributeValue ;
    skos:definition "A simple quantity value, representing a measurement with a numeric value and unit. This allows data providers to specify measurements in their preferred unit while enabling standardized interpretation. For example, a pixel size could be specified as 1.5 micrometers or 15 Angstroms, with the unit clearly specified." ;
    skos:exactMatch <https://w3id.org/nmdc/QuantityValue> ;
    skos:inScheme lambda:types ;
    skos:mappingRelation sdo:QuantityValue .

