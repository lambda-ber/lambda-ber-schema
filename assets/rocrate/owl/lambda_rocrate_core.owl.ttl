ROR:01qz5mb56 a owl:Class ;
    rdfs:label "HFIR",
        "SNS" ;
    rdfs:subClassOf lambdarc:FacilityEnum,
        linkml:PermissibleValue .

lambda:Image a owl:Class ;
    rdfs:label "Image" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:acquisition_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:dose ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:QuantityValue ;
            owl:onProperty lambda:dose ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:exposure_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:QuantityValue ;
            owl:onProperty lambda:dimensions_y ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:QuantityValue ;
            owl:onProperty lambda:exposure_time ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:dimensions_x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:acquisition_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:exposure_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:file_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:file_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:dimensions_y ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:QuantityValue ;
            owl:onProperty lambda:pixel_size ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:dimensions_y ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:pixel_size ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:pixel_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:QuantityValue ;
            owl:onProperty lambda:dimensions_x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:dimensions_x ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambda:file_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:dose ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:acquisition_date ],
        lambda:NamedThing ;
    skos:definition "An image file from structural biology experiments" ;
    skos:inScheme lambda: .

