lambdarc:at_context a owl:ObjectProperty ;
    rdfs:label "at_context" ;
    rdfs:range lambda:Any ;
    skos:definition "The JSON-LD context. MUST include the RO-Crate 1.2 context URI, and MUST bind `lambda` to `http://w3id.org/lambda/` and `lambdarc` to `http://w3id.org/lambda/rocrate/`." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "@context" .

lambdarc:at_graph a owl:ObjectProperty ;
    rdfs:label "at_graph" ;
    rdfs:range lambda:Any ;
    skos:definition "The flat set of entities. Order carries no meaning; relationships are by `@id` only." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "@graph" .

lambdarc:author a owl:ObjectProperty ;
    rdfs:label "author" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "People responsible for the dataset, by ORCID where known. Note that `lambda-ber-schema` has no `Person` class, so this projects to nothing today - see `PersonEntity`." ;
    skos:inScheme lambdarc:core .

lambdarc:citation a owl:ObjectProperty ;
    rdfs:label "citation" ;
    rdfs:range lambda:Any ;
    skos:definition "Publications or database entries that cite or describe this dataset. A reference to a contextual entity is preferred, because it can carry a DOI; a bare citation string is accepted, because that is all many archive exports publish." ;
    skos:inScheme lambdarc:core .

lambdarc:derived a owl:DatatypeProperty ;
    rdfs:label "derived" ;
    skos:closeMatch lambdax:derived ;
    skos:definition "Fields the builder computed rather than read from the source, named so a reader can tell recorded fact from pipeline inference." ;
    skos:inScheme lambdarc:core .

lambdarc:keywords a owl:DatatypeProperty ;
    rdfs:label "keywords" ;
    skos:definition "Free-text tags for discovery." ;
    skos:exactMatch lambda:keywords ;
    skos:inScheme lambdarc:core .

lambdarc:schema_set a owl:ObjectProperty ;
    rdfs:label "schema_set" ;
    rdfs:range lambdarc:SchemaSetEntry ;
    skos:closeMatch lambdax:schemaSet ;
    skos:definition "Which schema and profile versions this crate was built against, with hashes." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "schemaSet" .

lambdarc:sequence a owl:DatatypeProperty ;
    rdfs:label "sequence" ;
    skos:definition "Sequence(s) of the specimen, where short enough to travel in a manifest." ;
    skos:inScheme lambdarc:core .

lambdarc:was_derived_from a owl:ObjectProperty ;
    rdfs:label "was_derived_from" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "Artefacts this one was derived from." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "prov:wasDerivedFrom" .

