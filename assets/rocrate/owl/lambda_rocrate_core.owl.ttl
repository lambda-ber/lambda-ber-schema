lambdarc:Derivation a owl:Class ;
    rdfs:label "Derivation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:prov_entity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:prov_entity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:source_field ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:at_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:at_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:source_field ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:EntityReference ;
            owl:onProperty lambdarc:prov_entity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:source_field ],
        linkml:ClassDefinition ;
    skos:definition "Where a single reported value came from: which artefact it was read out of, and which field within it. Attaches to the value rather than to the crate, so a reader tracing one number does not have to work out which of several source files it came from." ;
    skos:exactMatch prov:Derivation ;
    skos:inScheme lambdarc:core .

