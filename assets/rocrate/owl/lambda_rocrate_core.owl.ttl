lambdarc:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:acted_on_behalf_of ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:at_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:at_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:EntityReference ;
            owl:onProperty lambdarc:acted_on_behalf_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty lambdarc:at_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:at_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:acted_on_behalf_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:at_type ],
        linkml:ClassDefinition ;
    skos:definition "A person, piece of software or organization that acted. Typed more specifically as `prov:Person`, `prov:SoftwareAgent` or `prov:Organization` where known - which is what tells a reader whether a human or a tool made a choice." ;
    skos:exactMatch prov:Agent ;
    skos:inScheme lambdarc:core .

lambdarc:Association a owl:Class ;
    rdfs:label "Association" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:had_plan ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:prov_agent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:prov_agent ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:at_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:had_plan ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:Agent ;
            owl:onProperty lambdarc:prov_agent ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:EntityReference ;
            owl:onProperty lambdarc:had_plan ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:at_type ],
        linkml:ClassDefinition ;
    skos:definition "Who or what carried out an activity, and under which published plan. The `prov:hadPlan` link is the part that matters for conformance: an agent acting under a versioned, resolvable rule is provenance, and an unattributed choice is not." ;
    skos:exactMatch prov:Association ;
    skos:inScheme lambdarc:core .

lambdarc:IceContaminationEnum a owl:Class ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <http://w3id.org/lambda/rocrate/IceContaminationEnum#none> <http://w3id.org/lambda/rocrate/IceContaminationEnum#limited> <http://w3id.org/lambda/rocrate/IceContaminationEnum#severe> ) ;
    linkml:permissible_values <http://w3id.org/lambda/rocrate/IceContaminationEnum#limited>,
        <http://w3id.org/lambda/rocrate/IceContaminationEnum#none>,
        <http://w3id.org/lambda/rocrate/IceContaminationEnum#severe> .

lambdarc:IceQualityEnum a owl:Class ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <http://w3id.org/lambda/rocrate/IceQualityEnum#ideal> <http://w3id.org/lambda/rocrate/IceQualityEnum#too_thin> <http://w3id.org/lambda/rocrate/IceQualityEnum#too_thick> ) ;
    linkml:permissible_values <http://w3id.org/lambda/rocrate/IceQualityEnum#ideal>,
        <http://w3id.org/lambda/rocrate/IceQualityEnum#too_thick>,
        <http://w3id.org/lambda/rocrate/IceQualityEnum#too_thin> .

lambdarc:ImagingModeEnum a owl:Class ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <http://w3id.org/lambda/rocrate/ImagingModeEnum#EFTEM> <http://w3id.org/lambda/rocrate/ImagingModeEnum#TEM> <http://w3id.org/lambda/rocrate/ImagingModeEnum#STEM> ) ;
    linkml:permissible_values <http://w3id.org/lambda/rocrate/ImagingModeEnum#EFTEM>,
        <http://w3id.org/lambda/rocrate/ImagingModeEnum#STEM>,
        <http://w3id.org/lambda/rocrate/ImagingModeEnum#TEM> .

lambdarc:InstrumentRoleEnum a owl:Class ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <http://w3id.org/lambda/rocrate/InstrumentRoleEnum#primary> <http://w3id.org/lambda/rocrate/InstrumentRoleEnum#detector> <http://w3id.org/lambda/rocrate/InstrumentRoleEnum#sample_handler> ) ;
    linkml:permissible_values <http://w3id.org/lambda/rocrate/InstrumentRoleEnum#detector>,
        <http://w3id.org/lambda/rocrate/InstrumentRoleEnum#primary>,
        <http://w3id.org/lambda/rocrate/InstrumentRoleEnum#sample_handler> .

lambdarc:ParticleConcentrationEnum a owl:Class ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <http://w3id.org/lambda/rocrate/ParticleConcentrationEnum#optimal> <http://w3id.org/lambda/rocrate/ParticleConcentrationEnum#too_low> <http://w3id.org/lambda/rocrate/ParticleConcentrationEnum#too_high> ) ;
    linkml:permissible_values <http://w3id.org/lambda/rocrate/ParticleConcentrationEnum#optimal>,
        <http://w3id.org/lambda/rocrate/ParticleConcentrationEnum#too_high>,
        <http://w3id.org/lambda/rocrate/ParticleConcentrationEnum#too_low> .

lambdarc:VitrificationMethodEnum a owl:Class ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <http://w3id.org/lambda/rocrate/VitrificationMethodEnum#plunge_freezing> <http://w3id.org/lambda/rocrate/VitrificationMethodEnum#high_pressure_freezing> <http://w3id.org/lambda/rocrate/VitrificationMethodEnum#slam_freezing> ) ;
    linkml:permissible_values <http://w3id.org/lambda/rocrate/VitrificationMethodEnum#high_pressure_freezing>,
        <http://w3id.org/lambda/rocrate/VitrificationMethodEnum#plunge_freezing>,
        <http://w3id.org/lambda/rocrate/VitrificationMethodEnum#slam_freezing> .

lambdarc:agent a owl:ObjectProperty ;
    rdfs:label "agent" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "Who ran the action." ;
    skos:inScheme lambdarc:core .

lambdarc:designated a owl:ObjectProperty ;
    rdfs:label "designated" ;
    rdfs:range lambdarc:Designation ;
    skos:definition "The designated result(s) and the provenance of each choice." ;
    skos:inScheme lambdarc:core .

lambdarc:has_part a owl:ObjectProperty ;
    rdfs:label "has_part" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "The manifest itself: every file and dataset part carried by this entity. Every present artefact appears here; every absent one appears in `missing`." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "hasPart" .

lambdarc:instrument a owl:ObjectProperty ;
    rdfs:label "instrument" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "What an action used - equipment for a collection, software for a workflow. schema.org's `instrument` covers both senses." ;
    skos:inScheme lambdarc:core .

lambdarc:object a owl:ObjectProperty ;
    rdfs:label "object" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "What an action consumed - the sample for a collection, the inputs for a workflow." ;
    skos:inScheme lambdarc:core .

lambdarc:result a owl:ObjectProperty ;
    rdfs:label "result" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "What an action produced." ;
    skos:inScheme lambdarc:core .

lambdarc:vocab_entry a owl:ObjectProperty ;
    rdfs:label "vocab_entry" ;
    rdfs:range lambdarc:VocabularyGap ;
    skos:closeMatch lambdax:vocabEntry ;
    skos:definition "Declared gaps in a controlled vocabulary. The enum equivalent of declared absence: where a real value has no permissible value to carry it, say so rather than silently coercing it to the nearest wrong term or dropping it." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "vocabEntry" .

lambdarc:was_informed_by a owl:ObjectProperty ;
    rdfs:label "was_informed_by" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "An earlier activity this one depended on - the collection session a processing run consumed. Chains activities without inventing a profile-local term for it." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "prov:wasInformedBy" .

