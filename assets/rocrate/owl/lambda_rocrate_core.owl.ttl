        <http://w3id.org/lambda/rocrate/ExperimentalMethodEnum#neutron_diffraction> .

lambdarc:GridMaterialEnum a owl:Class ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <http://w3id.org/lambda/rocrate/GridMaterialEnum#carbon> <http://w3id.org/lambda/rocrate/GridMaterialEnum#gold> <http://w3id.org/lambda/rocrate/GridMaterialEnum#graphene> <http://w3id.org/lambda/rocrate/GridMaterialEnum#silicon_nitride> ) ;
    linkml:permissible_values <http://w3id.org/lambda/rocrate/GridMaterialEnum#carbon>,
        <http://w3id.org/lambda/rocrate/GridMaterialEnum#gold>,
        <http://w3id.org/lambda/rocrate/GridMaterialEnum#graphene>,
        <http://w3id.org/lambda/rocrate/GridMaterialEnum#silicon_nitride> .

lambdarc:InputTypeEnum a owl:Class ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <http://w3id.org/lambda/rocrate/InputTypeEnum#raw_data> <http://w3id.org/lambda/rocrate/InputTypeEnum#reference> <http://w3id.org/lambda/rocrate/InputTypeEnum#parameters> <http://w3id.org/lambda/rocrate/InputTypeEnum#mask> ) ;
    linkml:permissible_values <http://w3id.org/lambda/rocrate/InputTypeEnum#mask>,
        <http://w3id.org/lambda/rocrate/InputTypeEnum#parameters>,
        <http://w3id.org/lambda/rocrate/InputTypeEnum#raw_data>,
