            owl:onProperty lambda:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambda:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty lambda:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:description ],
        linkml:ClassDefinition ;
    skos:definition "A named thing" ;
    skos:inScheme lambda: .

