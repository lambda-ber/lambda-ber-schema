lambda:refinement_params a owl:ObjectProperty ;
    rdfs:label "refinement_params" ;
    skos:definition "3D refinement specific parameters" ;
    skos:inScheme lambda: .

lambda:refinement_resolution_a a owl:ObjectProperty ;
    rdfs:label "refinement_resolution_a" ;
    skos:definition "Resolution cutoff used for refinement in Angstroms" ;
    skos:inScheme lambda: .

lambda:related_entity a owl:DatatypeProperty ;
    rdfs:label "related_entity" ;
    skos:definition "ID of the entity that owns this file" ;
    skos:inScheme lambda: ;
    skos:relatedMatch <https://mmcif.wwpdb.org/dictionaries/mmcif_ihm_ext.dic/Items/_ihm_dataset_list.id> .

lambda:resolution_0_143 a owl:ObjectProperty ;
    rdfs:label "resolution_0_143" ;
    skos:definition "Resolution at FSC=0.143, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
    skos:exactMatch <http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_em_3d_reconstruction.resolution> ;
    skos:inScheme lambda: .

lambda:resolution_0_5 a owl:ObjectProperty ;
    rdfs:label "resolution_0_5" ;
    skos:definition "Resolution at FSC=0.5, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
    skos:inScheme lambda: .

lambda:resolution_angstrom a owl:ObjectProperty ;
    rdfs:label "resolution_angstrom" ;
    skos:definition "Resolution values in Angstroms" ;
    skos:inScheme lambda: .

lambda:resolution_at_corner a owl:ObjectProperty ;
    rdfs:label "resolution_at_corner" ;
    skos:definition "Resolution at corner of detector, typically specified in Angstroms (Å). Data providers may specify alternative units by including the unit in the QuantityValue." ;
    skos:exactMatch <https://ispyb.github.io/ISPyB/DataCollection.resolutionAtCorner> ;
    skos:inScheme lambda: .

lambda:resolution_fit_limit a owl:ObjectProperty ;
    rdfs:label "resolution_fit_limit" ;
    skos:definition "Resolution fit limit, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
    skos:inScheme lambda: .

lambda:resolution_high a owl:ObjectProperty ;
    rdfs:label "resolution_high" ;
    skos:definition "High resolution limit, typically specified in Angstroms (Å). Data providers may specify alternative units by including the unit in the QuantityValue." ;
    skos:exactMatch <http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_reflns.d_resolution_high>,
        <https://github.com/NSLS2/BER-LAMBDA/Resolution_High_A>,
        <https://ispyb.github.io/ISPyB/AutoProcScalingStatistics.resolutionLimitHigh> ;
    skos:inScheme lambda: .

lambda:resolution_high_shell_a a owl:ObjectProperty ;
    rdfs:label "resolution_high_shell_a" ;
    skos:definition "High resolution shell limit, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
    skos:inScheme lambda: .

lambda:resolution_low a owl:ObjectProperty ;
    rdfs:label "resolution_low" ;
    skos:definition "Low resolution limit, typically specified in Angstroms (Å). Data providers may specify alternative units by including the unit in the QuantityValue." ;
    skos:exactMatch <http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_reflns.d_resolution_low>,
        <https://github.com/NSLS2/BER-LAMBDA/Resolution_Low_A>,
        <https://ispyb.github.io/ISPyB/AutoProcScalingStatistics.resolutionLimitLow> ;
    skos:inScheme lambda: .

lambda:resolution_low_a a owl:ObjectProperty ;
    rdfs:label "resolution_low_a" ;
    skos:definition "Low resolution limit, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
    skos:inScheme lambda: .

lambda:restraints_other a owl:DatatypeProperty ;
    rdfs:label "restraints_other" ;
    skos:definition "Other restraints applied during refinement" ;
    skos:inScheme lambda: .

lambda:rfree a owl:ObjectProperty ;
    rdfs:label "rfree" ;
    skos:definition "R-free (test set)" ;
    skos:exactMatch <http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_refine.ls_R_factor_R_free> ;
    skos:inScheme lambda: .

lambda:rg a owl:ObjectProperty ;
    rdfs:label "rg" ;
    skos:closeMatch <https://mmcif.wwpdb.org/dictionaries/mmcif_ihm_ext.dic/Items/_ihm_sas_restraint.radius_of_gyration> ;
    skos:definition "Radius of gyration, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue." ;
    skos:inScheme lambda: .

lambda:rmerge a owl:ObjectProperty ;
    rdfs:label "rmerge" ;
    skos:definition "Rmerge - merge R-factor" ;
    skos:inScheme lambda: .

lambda:rmsd_angles a owl:ObjectProperty ;
    rdfs:label "rmsd_angles" ;
    skos:definition "RMSD from ideal bond angles, typically specified in degrees. Data providers may specify alternative units by including the unit in the QuantityValue." ;
    skos:exactMatch <http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_refine.pdbx_ls_sigma_I>,
        <https://github.com/NSLS2/BER-LAMBDA/RMSD_angles> ;
    skos:inScheme lambda: .

lambda:rmsd_bonds a owl:ObjectProperty ;
    rdfs:label "rmsd_bonds" ;
    skos:definition "RMSD from ideal bond lengths, typically specified in Angstroms (Å). Data providers may specify alternative units by including the unit in the QuantityValue." ;
    skos:exactMatch <http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_refine.pdbx_ls_sigma_F>,
        <https://github.com/NSLS2/BER-LAMBDA/RMSD_bonds> ;
    skos:inScheme lambda: .

lambdarc:Designation a owl:Class ;
    rdfs:label "Designation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:species ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:prov_generated ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:EntityReference ;
            owl:onProperty lambdarc:prov_generated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:prov_used ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:selection ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:Association ;
            owl:onProperty lambdarc:qualified_association ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:at_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:species ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:at_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:qualified_association ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:qualified_association ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:selection ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:ended_at_time ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:started_at_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:started_at_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:selection ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:started_at_time ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:species ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:ended_at_time ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:ended_at_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:EntityReference ;
            owl:onProperty lambdarc:prov_used ],
        linkml:ClassDefinition ;
    skos:definition """One designated result, with the provenance of the choice published. Where several defensible results exist, naming which one is *the* result - and by what rule, and who or what decided - is what makes the crate's summary numbers mean something.
Typed `["lambdarc:Designation", "prov:Activity"]`, because that is what a designation *is*: an activity that used some inputs, generated a designated output, and was carried out by an agent acting under a plan. Modelling it as PROV rather than as flat `decidedBy` / `decidedAt` slots means the agent, the plan it followed, and who it acted on behalf of are all first-class and readable by any PROV-aware tool - and it removes the need for a `mode` flag, since a `prov:SoftwareAgent` and a `prov:Person` are already different things.""" ;
    skos:exactMatch prov:Activity ;
    skos:inScheme lambdarc:core .

lambdarc:EstimatorDescriptor a owl:Class ;
    rdfs:label "EstimatorDescriptor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:Agent ;
            owl:onProperty lambdarc:was_attributed_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:was_attributed_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:software ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:source_field ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:software ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:admissibility ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:AdmissibilityEnum ;
            owl:onProperty lambdarc:admissibility ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:source_field ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:was_attributed_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:software ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:admissibility ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:definition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:source_field ],
        linkml:ClassDefinition ;
    skos:definition """What produced a derived number, and how far it may be trusted. Any qualifying statistic in a crate travels with one of these: two numbers computed under different definitions are different quantities, however alike their labels look.
The producing software is named with `prov:wasAttributedTo` pointing at a `prov:SoftwareAgent` rather than as bare `software` / `version` strings, so the same agent can be referenced by every estimate it produced instead of being retyped beside each one.""" ;
    skos:inScheme lambdarc:core .

lambdarc:VocabularyGap a owl:Class ;
    rdfs:label "VocabularyGap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:module ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:enum_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:enum_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:enum_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:key ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:key ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:module ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:module ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:key ],
        linkml:ClassDefinition ;
    skos:definition """A value the source really carries that the schema's controlled vocabulary cannot express yet.
Silently coercing such a value to the nearest permissible term is the worst option: it looks like data and is wrong, and nothing downstream can tell. Dropping it is not much better. This records the local value against the enum it belongs in, so the crate stays honest and the gap becomes a change request with evidence attached rather than an anecdote.
Adopted from Peter Zwart's SAXS drafts, where a decommissioned beamline (`DORIS3_X33`) had no `BeamlineEnum` term and the crate said so.""" ;
    skos:inScheme lambdarc:core .

lambdarc:about a owl:ObjectProperty ;
    rdfs:label "about" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "What the metadata file describes - always the root data entity." ;
    skos:inScheme lambdarc:core .

lambdarc:acronym a owl:DatatypeProperty ;
    rdfs:label "acronym" ;
    skos:definition "Short name or acronym, e.g. `LBNL`, `SSRL`." ;
    skos:exactMatch lambda:acronym ;
    skos:inScheme lambdarc:core .

lambdarc:acted_on_behalf_of a owl:ObjectProperty ;
    rdfs:label "acted_on_behalf_of" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "The organization or person an agent acted for." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "prov:actedOnBehalfOf" .

lambdarc:admissibility a owl:ObjectProperty ;
    rdfs:label "admissibility" ;
    rdfs:range lambdarc:AdmissibilityEnum ;
    skos:closeMatch lambdax:admissibility ;
    skos:definition "How far the value may be compared across datasets." ;
    skos:inScheme lambdarc:core .

lambdarc:affiliation a owl:DatatypeProperty ;
    rdfs:label "affiliation" ;
    skos:definition "Institution a person is affiliated with." ;
    skos:exactMatch lambda:affiliation ;
    skos:inScheme lambdarc:core .

lambdarc:affiliation_ror a owl:DatatypeProperty ;
    rdfs:label "affiliation_ror" ;
    rdfs:range xsd:anyURI ;
    skos:definition "ROR identifier of the affiliated institution." ;
    skos:exactMatch lambda:affiliation_ror ;
    skos:inScheme lambdarc:core .

lambdarc:allow_empty a owl:DatatypeProperty ;
    rdfs:label "allow_empty" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a zero-length file is expected here rather than a build failure." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "allowEmpty" .

lambdarc:author_position a owl:DatatypeProperty ;
    rdfs:label "author_position" ;
    rdfs:range xsd:integer ;
    skos:definition "Position in the author list where order is meaningful; 1 is first author. Absent when the source does not state an order - an invented order is a claim about credit, so do not make one." ;
    skos:exactMatch lambda:author_position ;
    skos:inScheme lambdarc:core .

lambdarc:award_number a owl:DatatypeProperty ;
    rdfs:label "award_number" ;
    skos:definition "Grant or award number, where the organization is a funder. Distinct from a facility proposal identifier, which is beamtime rather than the funding that paid for the science." ;
    skos:exactMatch lambda:award_number ;
    skos:inScheme lambdarc:core .

lambdarc:blocks a owl:ObjectProperty ;
    rdfs:label "blocks" ;
    rdfs:range lambdarc:SufficiencyTierEnum ;
    skos:definition "Which sufficiency tier the absence blocks." ;
    skos:inScheme lambdarc:core .

lambdarc:collection_date a owl:DatatypeProperty ;
    rdfs:label "collection_date" ;
    skos:closeMatch lambda:experiment_date ;
    skos:definition "When the data was collected, on the root, for search." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "collectionDate" .

lambdarc:collection_mode a owl:ObjectProperty ;
    rdfs:label "collection_mode" ;
    rdfs:range lambdarc:CollectionModeEnum ;
    skos:definition "How the data was collected, from the schema's own `CollectionModeEnum`. Worth surfacing on the root so a federated index can filter on mode without parsing results." ;
    skos:exactMatch lambda:collection_mode ;
    skos:inScheme lambdarc:core .

lambdarc:concentration a owl:ObjectProperty ;
    rdfs:label "concentration" ;
    rdfs:range lambda:Any ;
    skos:definition "Sample concentration as a quantity object." ;
    skos:exactMatch lambda:concentration ;
    skos:inScheme lambdarc:core .

lambdarc:conditions_of_access a owl:DatatypeProperty ;
    rdfs:label "conditions_of_access" ;
    skos:definition "Access conditions - `open`, `embargoed`, `restricted`. Embargo detail originates outside the pipeline; where a builder cannot reach the proposal system it declares this missing and fails closed rather than guessing `open`." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "conditionsOfAccess" .

lambdarc:corresponding a owl:DatatypeProperty ;
    rdfs:label "corresponding" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether this person is a corresponding author." ;
    skos:exactMatch lambda:corresponding ;
    skos:inScheme lambdarc:core .

lambdarc:country a owl:DatatypeProperty ;
    rdfs:label "country" ;
    skos:definition "Country the organization is located in." ;
    skos:exactMatch lambda:country ;
    skos:inScheme lambdarc:core .

lambdarc:data_type a owl:ObjectProperty ;
    rdfs:label "data_type" ;
    rdfs:range lambdarc:DataTypeEnum ;
    skos:definition "What kind of data a file holds, from the schema's own `DataTypeEnum`." ;
    skos:exactMatch lambda:data_type ;
    skos:inScheme lambdarc:core .

lambdarc:date_created a owl:DatatypeProperty ;
    rdfs:label "date_created" ;
    skos:definition "Creation or deposition date. Distinct from `datePublished`: an archive deposit often records when the data was deposited but not when it was published, and the two should not be conflated." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "dateCreated" .

lambdarc:date_published a owl:DatatypeProperty ;
    rdfs:label "date_published" ;
    skos:definition "Publication date of the crate. String-typed, matching the main schema's date policy." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "datePublished" .

lambdarc:definition a owl:DatatypeProperty ;
    rdfs:label "definition" ;
    skos:closeMatch lambdax:definition ;
    skos:definition "What the number actually means. Required: two values computed under different definitions are different quantities however alike their labels look." ;
    skos:inScheme lambdarc:core .

lambdarc:detector a owl:DatatypeProperty ;
    rdfs:label "detector" ;
    skos:definition "Detector in use, where the crate names it on the instrument." ;
    skos:exactMatch lambda:detector ;
    skos:inScheme lambdarc:core .

lambdarc:distribution a owl:ObjectProperty ;
    rdfs:label "distribution" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "A `DataDownload` for a part whose bytes are retrieved from elsewhere." ;
    skos:inScheme lambdarc:core .

lambdarc:doe_office a owl:DatatypeProperty ;
    rdfs:label "doe_office" ;
    skos:definition "Sponsoring DOE office, e.g. `Office of Science`." ;
    skos:exactMatch lambda:doe_office ;
    skos:inScheme lambdarc:core .

lambdarc:email a owl:DatatypeProperty ;
    rdfs:label "email" ;
    skos:definition "Contact address." ;
    skos:exactMatch lambda:email ;
    skos:inScheme lambdarc:core .

lambdarc:enum_name a owl:DatatypeProperty ;
    rdfs:label "enum_name" ;
    skos:definition "The enum in which the value is missing, e.g. `BeamlineEnum`." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "enum" .

lambdarc:experiment_code a owl:DatatypeProperty ;
    rdfs:label "experiment_code" ;
    skos:definition "Facility-facing identifier for the collection session, e.g. `GluRS_1`." ;
    skos:exactMatch lambda:experiment_code ;
    skos:inScheme lambdarc:core .

lambdarc:experiment_date a owl:DatatypeProperty ;
    rdfs:label "experiment_date" ;
    skos:definition "Date of the collection session." ;
    skos:exactMatch lambda:experiment_date ;
    skos:inScheme lambdarc:core .

lambdarc:expression_system a owl:DatatypeProperty ;
    rdfs:label "expression_system" ;
    skos:definition "Host the construct was expressed in." ;
    skos:exactMatch lambda:expression_system ;
    skos:inScheme lambdarc:core .

lambdarc:facility a owl:ObjectProperty ;
    rdfs:label "facility" ;
    rdfs:range lambda:Any ;
    skos:closeMatch lambda:facility_name,
        lambdax:facility ;
    skos:definition "The facility, as a reference to a `DefinedTerm` entity or a bare code." ;
    skos:inScheme lambdarc:core .

lambdarc:facility_code a owl:ObjectProperty ;
    rdfs:label "facility_code" ;
    rdfs:range lambdarc:FacilityEnum ;
    skos:definition "The `FacilityEnum` term this organization corresponds to. This is the join key a federated index uses; the rest of the entity is what a reader needs once joined." ;
    skos:exactMatch lambda:facility_code ;
    skos:inScheme lambdarc:core .

lambdarc:facility_type a owl:ObjectProperty ;
    rdfs:label "facility_type" ;
    rdfs:range lambdarc:FacilityTypeEnum ;
    skos:definition "Kind of research facility, from the schema's own `FacilityTypeEnum`." ;
    skos:exactMatch lambda:facility_type ;
    skos:inScheme lambdarc:core .

lambdarc:family_name a owl:DatatypeProperty ;
    rdfs:label "family_name" ;
    skos:definition "Family name." ;
    skos:exactMatch lambda:family_name ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "familyName" .

lambdarc:field a owl:DatatypeProperty ;
    rdfs:label "field" ;
    skos:definition "The field or artefact that is absent, named as it would have appeared." ;
    skos:inScheme lambdarc:core .

lambdarc:file_format a owl:ObjectProperty ;
    rdfs:label "file_format" ;
    rdfs:range lambdarc:FileFormatEnum ;
    skos:definition "LAMBDA-controlled format, from the schema's own `FileFormatEnum`." ;
    skos:exactMatch lambda:file_format ;
    skos:inScheme lambdarc:core .

lambdarc:file_role a owl:DatatypeProperty ;
    rdfs:label "file_role" ;
    skos:definition "Role the file plays - raw, intermediate, final, diagnostic, metadata." ;
    skos:exactMatch lambda:file_role ;
    skos:inScheme lambdarc:core .

lambdarc:full_name a owl:DatatypeProperty ;
    rdfs:label "full_name" ;
    skos:definition "Full display name, as the person writes it. Distinct from `name`, which is the schema.org label RO-Crate consumers read; carry both, since only this one projects onto the schema." ;
    skos:exactMatch lambda:full_name ;
    skos:inScheme lambdarc:core .

lambdarc:generated_at a owl:DatatypeProperty ;
    rdfs:label "generated_at" ;
    skos:definition "When the crate itself was built - distinct from when the data was collected." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "generatedAt" .

lambdarc:given_name a owl:DatatypeProperty ;
    rdfs:label "given_name" ;
    skos:definition "Personal name." ;
    skos:exactMatch lambda:given_name ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "givenName" .

lambdarc:had_plan a owl:ObjectProperty ;
    rdfs:label "had_plan" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "The published, versioned rule the agent followed. This is the PROV spelling of what earlier drafts called `rule`." ;
    skos:exactMatch lambdarc:rule ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "prov:hadPlan" .

lambdarc:id_recipe_version a owl:DatatypeProperty ;
    rdfs:label "id_recipe_version" ;
    skos:closeMatch lambdax:idRecipeVersion ;
    skos:definition "Version of the published recipe used to mint this crate's deterministic identifiers, so a rebuild that produces different UUIDs can be told from one that produces the same ones. Adopted from Peter Zwart's SAXS drafts." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "idRecipeVersion" .

lambdarc:in_defined_term_set a owl:DatatypeProperty ;
    rdfs:label "in_defined_term_set" ;
    skos:definition "The vocabulary the term comes from." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "inDefinedTermSet" .

lambdarc:instrument_category a owl:ObjectProperty ;
    rdfs:label "instrument_category" ;
    rdfs:range lambdarc:InstrumentCategoryEnum ;
    skos:definition "Broad instrument class, from the schema's own `InstrumentCategoryEnum`." ;
    skos:exactMatch lambda:instrument_category ;
    skos:inScheme lambdarc:core .

lambdarc:instrument_code a owl:DatatypeProperty ;
    rdfs:label "instrument_code" ;
    skos:definition "Canonical instrument identifier, e.g. `ALS-12.3.1-SIBYLS`." ;
    skos:exactMatch lambda:instrument_code ;
    skos:inScheme lambdarc:core .

lambdarc:instrument_name a owl:DatatypeProperty ;
    rdfs:label "instrument_name" ;
    skos:closeMatch lambda:beamline_id,
        lambda:instrument_code ;
    skos:definition "Root-level shorthand for the instrument that produced the data, e.g. `BL12-1`. Introduced by the SSRL 0.2 crates and kept because a search index wants it on the root without resolving the instrument entity." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "instrumentName" .

lambdarc:is_doe_facility a owl:DatatypeProperty ;
    rdfs:label "is_doe_facility" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether this is a US Department of Energy facility." ;
    skos:exactMatch lambda:is_doe_facility ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "isDoeFacility" .

lambdarc:key a owl:DatatypeProperty ;
    rdfs:label "key" ;
    skos:definition "The local value being used in place of a permissible value. Carried verbatim, so the change request that adds it can be written from the crate." ;
    skos:inScheme lambdarc:core .

lambdarc:license a owl:ObjectProperty ;
    rdfs:label "license" ;
    rdfs:range lambda:Any ;
    skos:definition "Licence, as a `{\"@id\": ...}` reference to a licence URI or a contextual entity. Required on the root: a manifest whose reuse terms are unknown is not a usable handoff. Where the source genuinely does not state one, reference a `RelatedWork` entity that says so and record the gap in `missing`." ;
    skos:inScheme lambdarc:core .

lambdarc:location a owl:DatatypeProperty ;
    rdfs:label "location" ;
    skos:definition "Free-text location, e.g. `Berkeley, California, USA`." ;
    skos:exactMatch lambda:location ;
    skos:inScheme lambdarc:core .

lambdarc:manufacturer a owl:DatatypeProperty ;
    rdfs:label "manufacturer" ;
    skos:definition "Who made the instrument." ;
    skos:exactMatch lambda:manufacturer ;
    skos:inScheme lambdarc:core .

lambdarc:measurement_technique a owl:ObjectProperty ;
    rdfs:label "measurement_technique" ;
    rdfs:range lambdarc:EntityReference ;
    skos:closeMatch lambda:technique ;
    skos:definition "The technique, as a reference to a `DefinedTerm` entity." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "measurementTechnique" .

lambdarc:mime_type a owl:DatatypeProperty ;
    rdfs:label "mime_type" ;
    skos:definition "Media type, as published by SSRL alongside `encodingFormat`." ;
    skos:exactMatch sdo:encodingFormat ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "mimeType" .

lambdarc:model a owl:DatatypeProperty ;
    rdfs:label "model" ;
    skos:definition "Instrument model designation." ;
    skos:exactMatch lambda:model ;
    skos:inScheme lambdarc:core .

lambdarc:orcid a owl:DatatypeProperty ;
    rdfs:label "orcid" ;
    rdfs:range xsd:anyURI ;
    skos:definition "ORCID of the person. An entity SHOULD also use its ORCID as its `@id`, in which case this restates it - deliberately, so a consumer reading properties alone still finds it." ;
    skos:exactMatch lambda:orcid ;
    skos:inScheme lambdarc:core .

lambdarc:organization_role a owl:ObjectProperty ;
    rdfs:label "organization_role" ;
    rdfs:range lambdarc:OrganizationRoleEnum ;
    skos:closeMatch lambda:role ;
    skos:definition "Capacity in which the organization is attached to this crate's work, from the schema's own `OrganizationRoleEnum`. Named distinctly from a person's `role` because the two draw on different vocabularies and an entity should not have to guess which one applies." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "organizationRole" .

lambdarc:organization_type a owl:ObjectProperty ;
    rdfs:label "organization_type" ;
    rdfs:range lambdarc:OrganizationTypeEnum ;
    skos:definition "Kind of organization, from the schema's own `OrganizationTypeEnum`." ;
    skos:exactMatch lambda:organization_type ;
    skos:inScheme lambdarc:core .

lambdarc:package_tier a owl:ObjectProperty ;
    rdfs:label "package_tier" ;
    rdfs:range lambdarc:PackageTierEnum ;
    skos:definition "How much of the dataset this crate packages." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "packageTier" .

lambdarc:parent_organization a owl:ObjectProperty ;
    rdfs:label "parent_organization" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "Parent institution, e.g. a national laboratory above a light source. A reference, so the parent is described once and the child does not restate its identifiers." ;
    skos:exactMatch lambda:parent_organization_id ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "parentOrganization" .

lambdarc:part_count a owl:DatatypeProperty ;
    rdfs:label "part_count" ;
    rdfs:range xsd:integer ;
    skos:definition "How many members a bulk part contains. A frame series is one part with a count, never N file entities - enumerating them buries the manifest in noise." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "partCount" .

lambdarc:processing_status a owl:ObjectProperty ;
    rdfs:label "processing_status" ;
    rdfs:range lambdarc:ProcessingStatusEnum ;
    skos:definition "How far processing has got, from the schema's own `ProcessingStatusEnum`." ;
    skos:exactMatch lambda:processing_status ;
    skos:inScheme lambdarc:core .

lambdarc:product_id a owl:DatatypeProperty ;
    rdfs:label "product_id" ;
    skos:definition "Facility-local identifier of a derived product, in the SSRL 0.2 spelling." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "productId" ;
    skos:relatedMatch sdo:identifier .

lambdarc:property_id a owl:DatatypeProperty ;
    rdfs:label "property_id" ;
    skos:definition "Which identifier or measurement scheme a `PropertyValue` belongs to." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "propertyID" .

lambdarc:property_value a owl:ObjectProperty ;
    rdfs:label "property_value" ;
    rdfs:range lambda:Any ;
    skos:definition "The value of a `PropertyValue`." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "value" .

lambdarc:proposal_id a owl:DatatypeProperty ;
    rdfs:label "proposal_id" ;
    skos:definition "Facility proposal or allocation identifier. Distinct from a funder's award number, which is carried on `StudyOrganizationAssociation`: one is beamtime, the other is the money that paid for the science." ;
    skos:exactMatch lambda:proposal_id ;
    skos:inScheme lambdarc:core .

lambdarc:prov_agent a owl:ObjectProperty ;
    rdfs:label "prov_agent" ;
    rdfs:range lambdarc:Agent ;
    skos:definition "The agent in an association." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "prov:agent" .

lambdarc:prov_entity a owl:ObjectProperty ;
    rdfs:label "prov_entity" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "The artefact a value was read out of." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "prov:entity" .

lambdarc:provenance a owl:ObjectProperty ;
    rdfs:label "provenance" ;
    rdfs:range lambdarc:Derivation ;
    skos:definition "Where a single reported value came from - artefact plus field." ;
    skos:inScheme lambdarc:core .

lambdarc:publisher a owl:ObjectProperty ;
    rdfs:label "publisher" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "Publishing organization, by ROR where known." ;
    skos:inScheme lambdarc:core .

lambdarc:raw_data_location a owl:DatatypeProperty ;
    rdfs:label "raw_data_location" ;
    skos:definition "Where the raw payload lives, whether or not it travels with the crate." ;
    skos:exactMatch lambda:raw_data_location ;
    skos:inScheme lambdarc:core .

lambdarc:raw_included a owl:DatatypeProperty ;
    rdfs:label "raw_included" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the raw payload travels with this crate or is only referenced." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "rawIncluded" .

lambdarc:raw_unit_id a owl:DatatypeProperty ;
    rdfs:label "raw_unit_id" ;
    skos:definition "Facility-local identifier of a raw acquisition unit, in the SSRL 0.2 spelling." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "rawUnitId" ;
    skos:relatedMatch sdo:identifier .

lambdarc:reason a owl:ObjectProperty ;
    rdfs:label "reason" ;
    rdfs:range lambdarc:AbsenceReasonEnum ;
    skos:definition "Why it is absent." ;
    skos:inScheme lambdarc:core .

lambdarc:role a owl:ObjectProperty ;
    rdfs:label "role" ;
    rdfs:range lambdarc:PersonRoleEnum ;
    skos:closeMatch lambda:role ;
    skos:definition "Capacity in which a person is attached to this crate's work, from the schema's own `PersonRoleEnum`. Projects onto the `role` slot of a person association, not onto `Person`." ;
    skos:inScheme lambdarc:core .

lambdarc:ror a owl:DatatypeProperty ;
    rdfs:label "ror" ;
    rdfs:range xsd:anyURI ;
    skos:definition "ROR identifier. Omit it on a facility that is a unit of a larger institution rather than an institution in its own right - copying the parent's ROR down asserts an identity that is not the child's." ;
    skos:exactMatch lambda:ror ;
    skos:inScheme lambdarc:core .

lambdarc:run_definition a owl:ObjectProperty ;
    rdfs:label "run_definition" ;
    rdfs:range lambda:Any ;
    skos:definition "The pre-rename acquisition parameter block from the earliest SSRL crates." ;
    skos:exactMatch lambda:runParameters ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "runDefinition" .

lambdarc:s1_findable a owl:DatatypeProperty ;
    rdfs:label "s1_findable" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the generic search fields all resolve." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "s1Findable" .

lambdarc:s2_acquisition_complete a owl:DatatypeProperty ;
    rdfs:label "s2_acquisition_complete" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch lambdax:s2_acquisition_complete ;
    skos:definition "Whether the acquisition tier is complete. A search MUST require this for any filter whose answer depends on reprocessing." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "s2AcquisitionComplete" .

lambdarc:s2_core_complete a owl:DatatypeProperty ;
    rdfs:label "s2_core_complete" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the designated result and its analysis record are both verifiable." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "s2CoreComplete" .

lambdarc:s3_interpretable a owl:DatatypeProperty ;
    rdfs:label "s3_interpretable" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether every derived quantity names its estimator, convention and unit." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "s3Interpretable" .

lambdarc:sample_composition a owl:DatatypeProperty ;
    rdfs:label "sample_composition" ;
    skos:closeMatch lambda:molecular_composition ;
    skos:definition "Free-text composition summary, in the SSRL 0.2 spelling." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "sampleComposition" .

lambdarc:sample_type a owl:ObjectProperty ;
    rdfs:label "sample_type" ;
    rdfs:range lambdarc:SampleTypeEnum ;
    skos:definition "Kind of specimen, from the schema's own `SampleTypeEnum`." ;
    skos:exactMatch lambda:sample_type ;
    skos:inScheme lambdarc:core .

lambdarc:schema_record a owl:ObjectProperty ;
    rdfs:label "schema_record" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "Pointer to a file holding the full `lambda-ber-schema` record for this part - pointer mechanism 2. The one mechanism that carries the rigorous metadata without inlining it." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "schemaRecord" .

lambdarc:schema_version a owl:DatatypeProperty ;
    rdfs:label "schema_version" ;
    skos:definition "Version of `lambda-ber-schema` a referenced schema record conforms to." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "schemaVersion" .

lambdarc:seguid a owl:DatatypeProperty ;
    rdfs:label "seguid" ;
    skos:definition "SEGUID checksum of the sequence - the join key for finding the same construct across facilities. No counterpart in the main schema yet." ;
    skos:inScheme lambdarc:core .

lambdarc:selection a owl:DatatypeProperty ;
    rdfs:label "selection" ;
    skos:definition "What was selected, in terms a reader of this technique understands." ;
    skos:inScheme lambdarc:core .

lambdarc:software a owl:DatatypeProperty ;
    rdfs:label "software" ;
    skos:definition "Software that computed the value." ;
    skos:inScheme lambdarc:core .

lambdarc:software_name a owl:DatatypeProperty ;
    rdfs:label "software_name" ;
    skos:definition "Name of the software that did the processing." ;
    skos:exactMatch lambda:software_name ;
    skos:inScheme lambdarc:core .

lambdarc:software_version a owl:DatatypeProperty ;
    rdfs:label "software_version" ;
    skos:definition "Version of the software a workflow run reports having used." ;
    skos:exactMatch lambda:software_version ;
    skos:inScheme lambdarc:core .

lambdarc:software_version_schemaorg a owl:DatatypeProperty ;
    rdfs:label "software_version_schemaorg" ;
    skos:definition "Version of a `SoftwareApplication` contextual entity, in schema.org's own term. Distinct from `lambda:software_version`, which is the version *a workflow run reports having used* - the same number in the usual case, but they are different assertions and only one of them projects onto the schema." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "softwareVersion" .

lambdarc:species a owl:DatatypeProperty ;
    rdfs:label "species" ;
    skos:definition "Which resolved species or state this result corresponds to, where several exist." ;
    skos:inScheme lambdarc:core .

lambdarc:storage_uri a owl:DatatypeProperty ;
    rdfs:label "storage_uri" ;
    skos:definition "Facility storage locator - S3, Globus - for a file that does not travel." ;
    skos:exactMatch lambda:storage_uri ;
    skos:inScheme lambdarc:core .

lambdarc:sufficiency a owl:ObjectProperty ;
    rdfs:label "sufficiency" ;
    rdfs:range lambdarc:SufficiencyReport ;
    skos:definition "Which sufficiency tiers this crate meets." ;
    skos:inScheme lambdarc:core .

lambdarc:term_code a owl:DatatypeProperty ;
    rdfs:label "term_code" ;
    skos:definition "The code of a controlled term within its set." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "termCode" .

lambdarc:unit_code a owl:DatatypeProperty ;
    rdfs:label "unit_code" ;
    skos:definition "Unit as a controlled code, for machines." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "unitCode" .

lambdarc:unit_text a owl:DatatypeProperty ;
    rdfs:label "unit_text" ;
    skos:definition "Unit as free text, for readers." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "unitText" .

lambdarc:was_attributed_to a owl:ObjectProperty ;
    rdfs:label "was_attributed_to" ;
    rdfs:range lambdarc:Agent ;
    skos:definition "The agent responsible for an entity or a derived value." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "prov:wasAttributedTo" .

lambdarc:was_generated_by a owl:ObjectProperty ;
    rdfs:label "was_generated_by" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "The activity that produced this entity or value." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "prov:wasGeneratedBy" .

lambdarc:workflow_code a owl:DatatypeProperty ;
    rdfs:label "workflow_code" ;
    skos:definition "Human-facing identifier for the processing run." ;
    skos:exactMatch lambda:workflow_code ;
    skos:inScheme lambdarc:core .

lambdarc:workflow_run_id a owl:DatatypeProperty ;
    rdfs:label "workflow_run_id" ;
    skos:definition "Facility-local identifier of a processing run, in the SSRL 0.2 spelling." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "workflowRunId" ;
    skos:relatedMatch lambda:workflow_code .

lambdarc:workflow_type a owl:ObjectProperty ;
    rdfs:label "workflow_type" ;
    rdfs:range lambdarc:WorkflowTypeEnum ;
    skos:definition "Kind of processing, from the schema's own `WorkflowTypeEnum`." ;
    skos:exactMatch lambda:workflow_type ;
    skos:inScheme lambdarc:core .

lambda:rotation_angle a owl:ObjectProperty ;
    rdfs:label "rotation_angle" ;
    skos:definition "Rotation angle of the detector" ;
    skos:inScheme lambda: .

lambda:rotation_rate a owl:ObjectProperty ;
    rdfs:label "rotation_rate" ;
    skos:definition "Continuous rotation rate during data collection (e.g., for MicroED). Data providers may specify alternative units by including the unit in the QuantityValue." ;
    skos:inScheme lambda: ;
    skos:note "For the extent of a continuous-rotation sweep, use the rotation-method slots shared with the diffraction techniques: start_angle, sweep_start, sweep_end, total_rotation, and oscillation_angle." .

lambda:rpim a owl:ObjectProperty ;
    rdfs:label "rpim" ;
    skos:definition "Rpim - precision-indicating merging R-factor" ;
    skos:inScheme lambda: .

lambda:rwork a owl:ObjectProperty ;
    rdfs:label "rwork" ;
    skos:definition "Refinement R-factor (working set)" ;
    skos:exactMatch <http://mmcif.wwpdb.org/dictionaries/mmcif_pdbx_v50.dic/Items/_refine.ls_R_factor_R_work> ;
    skos:inScheme lambda: .

