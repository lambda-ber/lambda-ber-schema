lambdarc:additional_type a owl:DatatypeProperty ;
    rdfs:label "additional_type" ;
    skos:closeMatch lambda:data_type ;
    skos:definition "Finer-grained role of a part, e.g. `merged-reflections`." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "additionalType" .

lambdarc:beamline_id a owl:DatatypeProperty ;
    rdfs:label "beamline_id" ;
    skos:definition "Beamline identifier within a facility, e.g. `12.3.1`." ;
    skos:exactMatch lambda:beamline_id ;
    skos:inScheme lambdarc:core .

lambdarc:date_modified a owl:DatatypeProperty ;
    rdfs:label "date_modified" ;
    skos:definition "Last modification date." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "dateModified" .

lambdarc:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    skos:definition "Prose summary, aimed at a reader deciding whether to open the dataset." ;
    skos:exactMatch lambda:description ;
    skos:inScheme lambdarc:core .

lambdarc:designated_flag a owl:DatatypeProperty ;
    rdfs:label "designated_flag" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch lambdax:designated ;
    skos:definition "Marks an artefact as a designated result, for readers scanning parts directly." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "isDesignated" .

lambdarc:encoding_format a owl:DatatypeProperty ;
    rdfs:label "encoding_format" ;
    skos:closeMatch lambda:file_format ;
    skos:definition "IANA media type. Note this is *not* the same thing as `lambda:file_format`, which is a LAMBDA-controlled term; a crate carrying both is being helpful, not redundant." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "encodingFormat" .

lambdarc:end_time a owl:DatatypeProperty ;
    rdfs:label "end_time" ;
    skos:definition "When the action ended." ;
    skos:exactMatch lambda:end_time ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "endTime" .

lambdarc:enzyme_class a owl:DatatypeProperty ;
    rdfs:label "enzyme_class" ;
    skos:definition "Enzyme family or class, as published by SSRL. No schema counterpart." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "enzymeClass" .

lambdarc:estimator a owl:ObjectProperty ;
    rdfs:label "estimator" ;
    rdfs:range lambdarc:EstimatorDescriptor ;
    skos:closeMatch lambdax:estimator ;
    skos:definition "What produced a derived number, and how far it may be trusted." ;
    skos:inScheme lambdarc:core .

lambdarc:facility_name a owl:ObjectProperty ;
    rdfs:label "facility_name" ;
    rdfs:range lambdarc:FacilityEnum ;
    skos:definition "Facility, from the schema's own `FacilityEnum`." ;
    skos:exactMatch lambda:facility_name ;
    skos:inScheme lambdarc:core .

lambdarc:facility_ror a owl:DatatypeProperty ;
    rdfs:label "facility_ror" ;
    rdfs:range xsd:anyURI ;
    skos:definition "ROR identifier of the facility." ;
    skos:exactMatch lambda:facility_ror ;
    skos:inScheme lambdarc:core .

lambdarc:module a owl:DatatypeProperty ;
    rdfs:label "module" ;
    skos:definition "Schema or profile module name." ;
    skos:inScheme lambdarc:core .

lambdarc:note a owl:DatatypeProperty ;
    rdfs:label "note" ;
    skos:definition "Free text for a reader deciding whether the gap matters to them." ;
    skos:inScheme lambdarc:core .

lambdarc:organism a owl:ObjectProperty ;
    rdfs:label "organism" ;
    rdfs:range lambda:Any ;
    skos:closeMatch lambda:organism ;
    skos:definition "Source organism, as an NCBITaxon reference where resolvable or a name string. The main schema's `Sample.organism` is an `OntologyTerm`; a crate may carry the bare name." ;
    skos:inScheme lambdarc:core .

lambdarc:pdb_code a owl:DatatypeProperty ;
    rdfs:label "pdb_code" ;
    skos:closeMatch lambda:pdb_id ;
    skos:definition "PDB accession of a related structure." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "pdbCode" .

lambdarc:processing_level a owl:DatatypeProperty ;
    rdfs:label "processing_level" ;
    rdfs:range xsd:integer ;
    skos:closeMatch lambdax:processing_level ;
    skos:definition "How far from raw an artefact is - 0 raw, rising with each processing step." ;
    skos:exactMatch lambda:processing_level ;
    skos:inScheme lambdarc:core .

lambdarc:protein_name a owl:DatatypeProperty ;
    rdfs:label "protein_name" ;
    skos:definition "Name of the protein studied - one of the highest-value search fields." ;
    skos:exactMatch lambda:protein_name ;
    skos:inScheme lambdarc:core .

lambdarc:protein_name_camel a owl:DatatypeProperty ;
    rdfs:label "protein_name_camel" ;
    skos:definition "Protein name, in the SSRL 0.2 spelling." ;
    skos:exactMatch lambda:protein_name ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "proteinName" .

lambdarc:prov_generated a owl:ObjectProperty ;
    rdfs:label "prov_generated" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "Artefacts an activity produced." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "prov:generated" .

lambdarc:prov_used a owl:ObjectProperty ;
    rdfs:label "prov_used" ;
    rdfs:range lambdarc:EntityReference ;
    skos:definition "Artefacts an activity consumed." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "prov:used" .

lambdarc:resolution_angstrom a owl:ObjectProperty ;
    rdfs:label "resolution_angstrom" ;
    rdfs:range lambda:Any ;
    skos:closeMatch lambda:resolution ;
    skos:definition "Resolution in Angstrom. Retained from the SSRL 0.2 vocabulary; new crates SHOULD carry resolution in a technique extension's result summary with its estimator." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "resolutionAngstrom" .

lambdarc:result_summary a owl:ObjectProperty ;
    rdfs:label "result_summary" ;
    rdfs:range lambda:Any ;
    skos:closeMatch lambdax:summary ;
    skos:definition """**The extension seam.** Technique-specific result quantities - a SAXS quantity register, an MX data-reduction summary - live in here, and a technique extension is what gives the block its shape. Core deliberately leaves it opaque: core's job is to say *where* such quantities go and that they are subject to the estimator and admissibility rules, not to know any technique's numbers.
Carrying them here rather than as bare properties on the entity is what keeps a crate structurally valid against core while an extension tightens the contents. A crate that scatters technique quantities directly onto an entity is readable but not composable, and will not validate against core.""" ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "resultSummary" .

lambdarc:run_parameters a owl:ObjectProperty ;
    rdfs:label "run_parameters" ;
    rdfs:range lambda:Any ;
    skos:definition "The acquisition or processing parameter block as published by the facility, verbatim. Kept opaque on purpose: it is the un-projected source record, and the typed slots on `ExperimentRun` are what a consumer should read." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "runParameters" .

lambdarc:sample_code a owl:DatatypeProperty ;
    rdfs:label "sample_code" ;
    skos:definition "The specimen's identifier, and the join key across a facility's records." ;
    skos:exactMatch lambda:sample_code ;
    skos:inScheme lambdarc:core .

lambdarc:sample_name a owl:DatatypeProperty ;
    rdfs:label "sample_name" ;
    skos:definition "Specimen name, in the SSRL 0.2 spelling." ;
    skos:exactMatch lambda:sample_code ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "sampleName" .

lambdarc:source_field a owl:DatatypeProperty ;
    rdfs:label "source_field" ;
    skos:closeMatch lambdax:sourceField ;
    skos:definition "The upstream field the value was read from." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "sourceField" .

lambdarc:start_time a owl:DatatypeProperty ;
    rdfs:label "start_time" ;
    skos:definition "When the action began." ;
    skos:exactMatch lambda:start_time ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "startTime" .

lambdarc:technique a owl:ObjectProperty ;
    rdfs:label "technique" ;
    rdfs:range lambdarc:TechniqueEnum ;
    skos:definition "Technique, from the schema's own `TechniqueEnum`. Extensions add a PaNET IRI beside it." ;
    skos:exactMatch lambda:technique ;
    skos:inScheme lambdarc:core .

lambdarc:uniprot_id a owl:DatatypeProperty ;
    rdfs:label "uniprot_id" ;
    skos:definition "UniProt accession. No counterpart in the main schema; a standing change request." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "uniprotId" .

lambda:sample_changer_capacity a owl:ObjectProperty .

lambda:screen_name a owl:DatatypeProperty .

lambda:seed_stock_dilution a owl:DatatypeProperty .

lambda:seeding_type a owl:DatatypeProperty .

lambda:space_group a owl:DatatypeProperty .

lambda:sweep_end a owl:ObjectProperty .

lambda:sweep_start a owl:ObjectProperty .

lambda:temperature a owl:ObjectProperty .

lambda:temperature_c a owl:ObjectProperty .

lambda:total_dose a owl:ObjectProperty .

lambda:unit_cell_a a owl:ObjectProperty .

lambda:unit_cell_alpha a owl:ObjectProperty .

lambda:unit_cell_b a owl:ObjectProperty .

lambda:unit_cell_beta a owl:ObjectProperty .

lambda:unit_cell_c a owl:ObjectProperty .

lambda:unit_cell_gamma a owl:ObjectProperty .

lambda:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:range xsd:string ;
    skos:definition "The value, as a text string." ;
    skos:inScheme lambda:types .

lambda:wavelength a owl:ObjectProperty .

lambda:website a owl:DatatypeProperty .

