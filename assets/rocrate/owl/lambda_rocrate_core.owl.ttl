lambdarc:content_size a owl:ObjectProperty ;
    rdfs:label "content_size" ;
    rdfs:range lambda:Any ;
    skos:definition "Size in bytes. RO-Crate 1.2 expects text; integers occur in the wild and are accepted." ;
    skos:exactMatch lambda:file_size_bytes ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "contentSize" .

lambdarc:ended_at_time a owl:DatatypeProperty ;
    rdfs:label "ended_at_time" ;
    skos:definition "When an activity ended." ;
    skos:exactMatch lambda:completed_at ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "prov:endedAtTime" .

lambdarc:qualified_association a owl:ObjectProperty ;
    rdfs:label "qualified_association" ;
    rdfs:range lambdarc:Association ;
    skos:definition "Who carried out an activity and under which plan. Qualified rather than a bare `prov:wasAssociatedWith` precisely so the plan can travel with the agent." ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "prov:qualifiedAssociation" .

lambdarc:sha256 a owl:DatatypeProperty ;
    rdfs:label "sha256" ;
    skos:closeMatch lambda:sha256 ;
    skos:definition "SHA-256 of the bytes. The RO-Crate 1.2 context already maps the bare term `sha256` to `http://schema.org/sha256`, so that is what it means in any crate that does not override it - and a profile asserting a different IRI for the same key would be contradicted by the crate's own context. The SSRL 0.2 crates *do* override it to `lambda:sha256` in their inline context; that spelling is carried as a close mapping so those crates still project." ;
    skos:exactMatch lambda:checksum ;
    skos:inScheme lambdarc:core .

lambdarc:started_at_time a owl:DatatypeProperty ;
    rdfs:label "started_at_time" ;
    skos:definition "When an activity began." ;
    skos:exactMatch lambda:started_at ;
    skos:inScheme lambdarc:core ;
    skos:prefLabel "prov:startedAtTime" .

lambda:sample_id a owl:DatatypeProperty,
        owl:ObjectProperty .

