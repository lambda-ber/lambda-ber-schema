    skos:definition """The root data entity: one crate, one manifest, one search row. Carries the identity, access and provenance summary a reader needs to judge the dataset without opening it, plus the `hasPart` manifest of what is inside.
Typed `["Dataset", "lambda:Dataset"]`. Crates written against the SSRL 0.2 vocabulary type this `["Dataset", "lambda:Experiment"]`; readers MUST accept that spelling and SHOULD treat it as deprecated.""" ;
    skos:exactMatch sdo:Dataset,
        lambda:Dataset ;
    skos:inScheme lambdarc:core .

lambdarc:DefinedTermEntity a owl:Class ;
    rdfs:label "DefinedTermEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:in_defined_term_set ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:term_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:at_id ],
