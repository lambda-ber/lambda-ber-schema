lambdarc:SufficiencyReport a owl:Class ;
    rdfs:label "SufficiencyReport" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty lambdarc:s2_core_complete ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty lambdarc:s3_interpretable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:s1_findable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:s2_acquisition_complete ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:s3_interpretable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:s2_acquisition_complete ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty lambdarc:s1_findable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:s3_interpretable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:s2_core_complete ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:s1_findable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty lambdarc:s2_acquisition_complete ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:s2_core_complete ],
        linkml:ClassDefinition ;
    skos:definition "Which sufficiency tiers this crate meets. Makes the tiering machine-readable so a federated search can *gate* filters rather than silently returning crates that cannot answer them: a \"crates I can reprocess\" query requires `s2AcquisitionComplete`, and a crate that published only processed results correctly drops out instead of appearing and then disappointing." ;
    skos:inScheme lambdarc:core .

