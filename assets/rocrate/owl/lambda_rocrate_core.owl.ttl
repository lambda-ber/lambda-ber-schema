lambda:sample_code a owl:DatatypeProperty ;
    rdfs:label "sample_code" ;
    skos:definition "Human-friendly laboratory identifier or facility code for the sample (e.g., 'ALS-12.3.1-SAMPLE-001', 'LAB-PROT-2024-01'). Used for local reference and tracking within laboratory workflows." ;
    skos:inScheme lambda: .

lambda:workflow_code a owl:DatatypeProperty ;
    rdfs:label "workflow_code" ;
    skos:definition "Human-friendly identifier for the computational workflow run (e.g., 'MOTION-CORR-RUN-001', 'RELION-REFINE-240815'). Used for tracking processing pipelines and computational provenance." ;
    skos:inScheme lambda: .

<http://purl.obolibrary.org/obo/CHMO_0000156> a owl:Class ;
    rdfs:label "fiber_diffraction",
        "time_resolved_crystallography",
        "x_ray_diffraction",
        "xray_crystallography" ;
    rdfs:subClassOf lambdarc:ExperimentalMethodEnum,
        lambdarc:TechniqueEnum,
        linkml:PermissibleValue .

lambda:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:doe_office ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:acronym ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:doe_office ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:is_doe_facility ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:doe_office ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:country ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:parent_organization_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:OrganizationTypeEnum ;
            owl:onProperty lambda:organization_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:FacilityTypeEnum ;
            owl:onProperty lambda:facility_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty lambda:website ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:ror ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^https://ror\\.org/\\w+$" ] ) ] ) ] ;
            owl:onProperty lambda:ror ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:acronym ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:organization_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:is_doe_facility ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:location ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:organization_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:facility_code ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:Organization ;
            owl:onProperty lambda:parent_organization_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty lambda:is_doe_facility ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:facility_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:facility_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:website ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:website ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:country ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:FacilityEnum ;
            owl:onProperty lambda:facility_code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:facility_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:acronym ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:parent_organization_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:country ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:wikidata_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:ror ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:wikidata_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:wikidata_id ],
        lambda:NamedThing ;
    skos:definition """An institution, facility, laboratory or funding body - a national laboratory, a university, a light source, an agency that funded the work.
This is the structured home for organizational identity that the schema otherwise carries as unvalidated free text in three places: the annotations on FacilityEnum permissible values (`parent_organization`, `parent_ror`, `location`, `country`, `doe_office`, `website`, `wikidata_id`), Instrument's `facility_name` / `facility_ror` pair, and Person's `affiliation` / `affiliation_ror` pair. FacilityEnum remains the controlled vocabulary that says *which* facility something is; Organization is the record that says what that facility is, where, and who runs it - and lets a parent institution be stated once rather than restated by every entity that refers to it.""" ;
    skos:exactMatch prov:Organization ;
    skos:inScheme lambda: ;
    skos:note "As with Person, nothing beyond the inherited id is required: a ROR alone identifies an organization completely, and a source that gives only a name is common." .

lambda:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^https://ror\\.org/\\w+$" ] ) ] ) ] ;
            owl:onProperty lambda:affiliation_ror ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:person_local_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:family_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:family_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:email ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:full_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:affiliation_ror ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:full_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:orcid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:full_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:given_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:person_local_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:person_local_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:given_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:orcid ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^https://orcid\\.org/\\d{4}-\\d{4}-\\d{4}-\\d{3}[0-9X]$" ] ) ] ) ] ;
            owl:onProperty lambda:orcid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:given_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:family_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:affiliation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:affiliation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:affiliation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:affiliation_ror ],
        lambda:NamedThing ;
    skos:definition "A person involved in producing, processing or publishing data - a principal investigator, beamline operator, data analyst or curator. In the relational model, Person is lightweight: which study, experiment or workflow a person is attached to, and in what capacity, is carried by the person association tables in Dataset, so one person record serves every role they hold across a dataset." ;
    skos:exactMatch prov:Agent ;
    skos:inScheme lambda: ;
    skos:note "No slot is required beyond the inherited id. An ORCID alone is a complete identification of a person, and a source that publishes only a name is equally common - so neither can be insisted upon. Where a name is genuinely unavailable, record that fact rather than substituting the identifier for it." .

