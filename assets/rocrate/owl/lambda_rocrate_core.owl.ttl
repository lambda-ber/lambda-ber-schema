    linkml:permissible_values <http://w3id.org/lambda/rocrate/MutationTypeEnum#deletion>,
        <http://w3id.org/lambda/rocrate/MutationTypeEnum#duplication>,
        <http://w3id.org/lambda/rocrate/MutationTypeEnum#frameshift>,
        <http://w3id.org/lambda/rocrate/MutationTypeEnum#insertion>,
        <http://w3id.org/lambda/rocrate/MutationTypeEnum#missense>,
