lambdarc:CrateEntity a owl:Class ;
    rdfs:label "CrateEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty lambdarc:at_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:at_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:at_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:at_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:at_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:description ],
        linkml:ClassDefinition ;
    skos:definition "Anything that appears in the `@graph`. Every entity is addressable (`@id`) and typed (`@type`); everything else depends on what it is." ;
    skos:inScheme lambdarc:core .

lambdarc:missing a owl:ObjectProperty ;
    rdfs:label "missing" ;
    rdfs:range lambdarc:MissingValueDeclaration ;
    skos:closeMatch lambdax:missing ;
    skos:definition "Declared absences. Absence is stated, never implied by omission." ;
    skos:inScheme lambdarc:core .

