lambda:Attribute a owl:Class ;
    rdfs:label "Attribute" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:label ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
