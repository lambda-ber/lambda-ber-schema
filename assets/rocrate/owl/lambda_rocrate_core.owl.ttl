lambda:AttributeValue a owl:Class ;
    rdfs:label "AttributeValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:attribute ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:Attribute ;
            owl:onProperty lambda:attribute ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:raw_value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambda:attribute ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:raw_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:raw_value ],
        linkml:ClassDefinition ;
    skos:definition "The value for any attribute of an entity. This object can hold both the un-normalized atomic value and the structured value." ;
    skos:exactMatch <https://w3id.org/nmdc/AttributeValue> ;
    skos:inScheme lambda:types .

