lambda:DateTimeValue a owl:Class ;
    rdfs:label "DateTimeValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambda:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambda:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:value ],
        lambda:AttributeValue ;
    skos:definition "A date or date and time value." ;
    skos:exactMatch <https://w3id.org/nmdc/DateTimeValue> ;
    skos:inScheme lambda:types .

