lambda:BeamlineInstrument a owl:Class ;
    rdfs:label "BeamlineInstrument" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:website ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:source_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:control_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:sample_changer_capacity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:control_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:QuantityValue ;
            owl:onProperty lambda:q_range_min ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:q_range_max ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambda:techniques_supported ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:QuantityValue ;
            owl:onProperty lambda:energy_min ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:QuantityValue ;
            owl:onProperty lambda:q_range_max ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:energy_max ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty lambda:website ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:ControlSystemEnum ;
            owl:onProperty lambda:control_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:website ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:QuantityValue ;
            owl:onProperty lambda:sample_changer_capacity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:mail_in_service ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:sample_changer_capacity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:q_range_min ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:XRaySourceTypeEnum ;
            owl:onProperty lambda:source_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:lims_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:daq_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:mail_in_service ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:daq_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:source_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:q_range_max ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:DataAcquisitionSystemEnum ;
            owl:onProperty lambda:daq_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:QuantityValue ;
            owl:onProperty lambda:energy_max ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:TechniqueEnum ;
            owl:onProperty lambda:techniques_supported ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:energy_min ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:q_range_min ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:LIMSSystemEnum ;
            owl:onProperty lambda:lims_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty lambda:mail_in_service ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambda:lims_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:energy_min ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambda:energy_max ],
        lambda:Instrument ;
    skos:definition "Multi-technique synchrotron beamline that supports multiple experimental methods" ;
    skos:inScheme lambda: ;
    skos:note "For single-technique beamlines, use XRayInstrument, SANSInstrument, or SAXSInstrument",
        "Use for beamlines like SIBYLS that support both SAXS and crystallography" .

