lambdarc:MetadataDescriptor a owl:Class ;
    rdfs:label "MetadataDescriptor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:EntityReference ;
            owl:onProperty lambdarc:about ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:about ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:about ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:at_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:at_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambdarc:EntityReference ;
            owl:onProperty lambdarc:conforms_to ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:conforms_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^(.*/)?ro-crate-metadata\\.json$" ] ) ] ;
            owl:onProperty lambdarc:at_id ],
        lambdarc:CrateEntity ;
    skos:definition "The self-description of the metadata file. `@id` is `ro-crate-metadata.json`, `conformsTo` names the RO-Crate version, and `about` points at the root data entity." ;
    skos:exactMatch sdo:CreativeWork ;
    skos:inScheme lambdarc:core .

