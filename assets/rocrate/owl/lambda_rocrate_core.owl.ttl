        <http://w3id.org/lambda/rocrate/SampleRoleEnum#target> .

lambdarc:TiltingSchemeEnum a owl:Class ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <http://w3id.org/lambda/rocrate/TiltingSchemeEnum#none> <http://w3id.org/lambda/rocrate/TiltingSchemeEnum#dose_symmetric> <http://w3id.org/lambda/rocrate/TiltingSchemeEnum#linear> <http://w3id.org/lambda/rocrate/TiltingSchemeEnum#continuous> ) ;
    linkml:permissible_values <http://w3id.org/lambda/rocrate/TiltingSchemeEnum#continuous>,
