        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty lambdarc:corresponding ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:email ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:author_position ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:given_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty lambdarc:author_position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:affiliation ],
        lambdarc:CrateEntity ;
    skos:definition """A person - PI, author, operator, analyst, or the decider of a designation. `@id` SHOULD be an ORCID, which is also what `lambda:orcid` carries in the projected record.
`role` states the capacity in which the person is attached to *this* crate's work, drawn from the schema's `PersonRoleEnum`. In the projected record that capacity lives on an association (`StudyPersonAssociation` and friends) rather than on the person, because a person commonly holds several roles across one dataset and only one record of them should exist.""" ;
    skos:exactMatch sdo:Person,
        lambda:Person ;
    skos:inScheme lambdarc:core .

lambdarc:PropertyValueEntity a owl:Class ;
    rdfs:label "PropertyValueEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:property_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:property_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:unit_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:property_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:unit_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lambdarc:unit_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:unit_code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lambdarc:property_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:unit_text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:unit_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lambdarc:property_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:Any ;
            owl:onProperty lambdarc:property_value ],
        lambdarc:CrateEntity ;
    skos:definition "A typed identifier or measurement, used for `identifier` entries so that a UUID, a DOI and a facility-local accession can coexist without ambiguity about which is which." ;
    skos:exactMatch sdo:PropertyValue ;
    skos:inScheme lambdarc:core .

lambdarc:ROCrateMetadataDocument a owl:Class ;
    rdfs:label "ROCrateMetadataDocument" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom lambda:Any ;
            owl:onProperty lambdarc:at_context ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:at_context ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty lambdarc:at_graph ],
        [ a owl:Restriction ;
            owl:allValuesFrom lambda:Any ;
            owl:onProperty lambdarc:at_graph ],
        linkml:ClassDefinition ;
    skos:definition "An `ro-crate-metadata.json` file: a JSON-LD document whose `@graph` is a flat set of entities linked by `@id`. This is the tree root of the profile, so a real crate file validates as-is." ;
    skos:exactMatch sdo:CreativeWork ;
    skos:inScheme lambdarc:core ;
    skos:note "`@graph` has range `Any` on purpose. LinkML closes every nested class in the generated JSON Schema, so constraining `@graph` to the entity classes here would reject any crate that carries a technique-extension term - which is precisely the composition this profile is built for. Per-entity enforcement happens by dispatching each entity on its `@type` and validating it against the matching class (validation model, layer 2)." .

