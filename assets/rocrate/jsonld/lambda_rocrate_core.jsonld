      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "raw_included",
      "definition_uri": "http://w3id.org/lambda/rocrate/raw_included",
      "description": "Whether the raw payload travels with this crate or is only referenced.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://w3id.org/lambda/rocrate/rawIncluded"
      ],
      "slot_uri": "http://w3id.org/lambda/rocrate/rawIncluded",
