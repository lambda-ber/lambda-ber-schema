      "alias": "prov:qualifiedAssociation",
      "owner": "Designation",
      "domain_of": [
        "Designation"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "qualified_association",
      "range": "Association",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "Association_prov_agent",
      "definition_uri": "http://w3id.org/lambda/rocrate/prov_agent",
      "description": "The agent in an association.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
