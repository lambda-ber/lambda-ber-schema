      "domain_of": [
        "ProteinAnnotation"
      ],
      "range": "string",
      "pattern": "^[A-Za-z0-9]+$",
      "@type": "SlotDefinition"
    },
    {
      "name": "proteinAnnotation__residue_range",
      "description": "Range of residues (e.g., '1-100', '25,27,30-35')",
      "from_schema": "http://w3id.org/lambda/functional_annotation",
