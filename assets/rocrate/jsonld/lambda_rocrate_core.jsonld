    },
    {
      "name": "VocabularyGap_enum_name",
      "definition_uri": "http://w3id.org/lambda/rocrate/enum_name",
      "description": "The enum in which the value is missing, e.g. `BeamlineEnum`.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://w3id.org/lambda/rocrate/enum"
      ],
      "is_a": "enum_name",
      "domain": "VocabularyGap",
      "slot_uri": "http://w3id.org/lambda/rocrate/enum",
