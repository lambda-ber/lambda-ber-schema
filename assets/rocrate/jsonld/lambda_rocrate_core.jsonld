        "experimentRun__ispyb_session_id"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "experiment_code",
          "description": "Human-friendly laboratory or facility identifier for the experiment (e.g., 'SIBYLS-2024-02-01-hetBGL', 'CRYOEM-RUN-240815-001'). Used for local tracking and cross-referencing within laboratory systems.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "experiment_date",
          "description": "Date of the experiment",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "operator_id",
          "description": "Identifier or name of the person who performed the experiment data collection (e.g., 'jsmith', 'John Smith', or personnel ID)",
          "comments": [
            "Free text, and retained for sources that publish only a bare operator string. Where the person can be resolved, prefer a Person record linked by ExperimentPersonAssociation with role 'operator' - that is what carries an ORCID and survives a name change."
          ],
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "technique",
          "description": "Technique used for data collection",
          "related_mappings": [
            "IHMCIF:_ihm_dataset_list.data_type"
          ],
          "range": "TechniqueEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "experimental_method",
          "description": "Specific experimental method for structure determination (particularly for diffraction techniques)",
          "range": "ExperimentalMethodEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "experimental_conditions",
          "description": "Environmental and experimental conditions",
          "range": "ExperimentalConditions",
          "@type": "SlotDefinition"
        },
        {
          "name": "data_collection_strategy",
          "description": "Strategy for data collection",
          "range": "DataCollectionStrategy",
          "@type": "SlotDefinition"
        },
        {
          "name": "quality_metrics",
          "description": "Quality metrics for the experiment",
          "range": "QualityMetrics",
          "@type": "SlotDefinition"
        },
        {
          "name": "raw_data_location",
          "description": "Location of raw data files",
          "@type": "SlotDefinition"
        },
        {
          "name": "processing_status",
          "description": "Current processing status",
          "range": "ProcessingStatusEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "daq_system",
          "description": "Data acquisition system used to collect this experiment",
          "range": "DataAcquisitionSystemEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "magnification",
          "description": "Magnification used during data collection",
          "exact_mappings": [
            "mmCIF:_em_imaging.nominal_magnification"
          ],
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "calibrated_pixel_size",
          "description": "Calibrated pixel size, typically specified in Angstroms per pixel. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "exact_mappings": [
            "mmCIF:_em_image_recording.calibrated_pixel_size"
          ],
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "camera_binning",
          "description": "Camera binning factor. This must be a positive float value (e.g., 1, 1.5, 2, 3).",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "exposure_time_per_frame",
          "description": "Exposure time per frame, typically specified in milliseconds. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "exact_mappings": [
            "mmCIF:_em_image_recording.average_exposure_time"
          ],
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "frames_per_movie",
          "description": "Number of frames per movie",
          "exact_mappings": [
            "mmCIF:_em_image_recording.num_frames_per_image"
          ],
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "total_exposure_time",
          "description": "Total exposure time. Data providers may specify alternative units (e.g., seconds, milliseconds) by including the unit in the QuantityValue.",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "total_dose",
          "description": "Total electron dose, typically specified in e-/Angstrom^2. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "exact_mappings": [
            "mmCIF:_em_image_recording.avg_electron_dose_per_image"
          ],
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "dose_rate",
          "description": "Dose rate, typically specified in e-/pixel/s or e-/Angstrom^2/s. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "defocus_target",
          "description": "Target defocus value, typically specified in micrometers. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "defocus_range_min",
          "description": "Minimum defocus range, typically specified in micrometers. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "exact_mappings": [
            "mmCIF:_em_imaging.nominal_defocus_min"
          ],
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "defocus_range_max",
          "description": "Maximum defocus range, typically specified in micrometers. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "exact_mappings": [
            "mmCIF:_em_imaging.nominal_defocus_max"
          ],
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "defocus_range_increment",
          "description": "Defocus range increment, typically specified in micrometers. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "astigmatism_target",
          "description": "Target astigmatism, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "coma",
          "description": "Coma aberration, typically specified in nanometers. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "stage_tilt",
          "description": "Fixed stage tilt angle for a single-orientation acquisition, typically specified in degrees. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "comments": [
            "For a tilt series, use tilt_angle_min, tilt_angle_max, and tilt_angle_increment rather than this slot."
          ],
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "tilting_scheme",
          "description": "Tilt scheme used during tomographic data collection",
          "range": "TiltingSchemeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "tilt_angle_min",
          "description": "Lowest (most negative) tilt angle in the tilt series, typically specified in degrees. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "exact_mappings": [
            "mmCIF:_em_imaging.tilt_angle_min",
            "mmCIF:_em_tomography.axis1_min_angle"
          ],
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "tilt_angle_max",
          "description": "Highest (most positive) tilt angle in the tilt series, typically specified in degrees. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "exact_mappings": [
            "mmCIF:_em_imaging.tilt_angle_max",
            "mmCIF:_em_tomography.axis1_max_angle"
          ],
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "tilt_angle_increment",
          "description": "Tilt angle increment between successive tilt steps. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "exact_mappings": [
            "mmCIF:_em_tomography.axis1_angle_increment"
          ],
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "tilt_axis_angle",
          "description": "In-plane azimuth of the tilt axis relative to the detector x-axis, typically specified in degrees. Required for tilt series alignment and reconstruction.",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "number_of_tilt_images",
          "description": "Number of images collected in the tilt series",
          "comments": [
            "For a symmetric series this is usually (tilt_angle_max - tilt_angle_min) / tilt_angle_increment + 1, but record the actual count since tilts are often skipped or discarded."
          ],
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "dose_per_tilt",
          "description": "Electron dose applied at each tilt step, typically specified in e-/Angstrom^2. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "comments": [
            "Use total_dose for the accumulated dose across the whole tilt series."
