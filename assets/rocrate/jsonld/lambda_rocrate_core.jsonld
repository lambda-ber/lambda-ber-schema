      "mappings": [
        "http://w3id.org/lambda/rocrate/generatedAt"
      ],
      "slot_uri": "http://w3id.org/lambda/rocrate/generatedAt",
      "alias": "generatedAt",
      "owner": "CrateRoot",
      "domain_of": [
        "CrateRoot"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "part_count",
      "definition_uri": "http://w3id.org/lambda/rocrate/part_count",
      "description": "How many members a bulk part contains. A frame series is one part with a count, never N file entities - enumerating them buries the manifest in noise.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://w3id.org/lambda/rocrate/partCount"
      ],
      "slot_uri": "http://w3id.org/lambda/rocrate/partCount",
