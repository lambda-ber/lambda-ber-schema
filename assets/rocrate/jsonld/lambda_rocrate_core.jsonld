    },
    {
      "name": "was_derived_from",
      "definition_uri": "http://w3id.org/lambda/rocrate/was_derived_from",
      "description": "Artefacts this one was derived from.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
