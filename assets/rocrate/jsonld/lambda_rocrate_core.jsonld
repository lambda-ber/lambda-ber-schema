        },
        {
          "name": "final_concentration_mg_per_ml",
          "description": "Final protein concentration in mg/mL",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "yield_mg",
          "description": "Total yield in milligrams",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "purity_by_sds_page_percent",
          "description": "Purity percentage by SDS-PAGE",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "aggregation_assessment",
          "description": "Assessment of protein aggregation state",
          "@type": "SlotDefinition"
        },
        {
          "name": "aliquoting",
          "description": "How the protein was aliquoted for storage",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://w3id.org/lambda/SamplePreparation",
      "@type": "ClassDefinition"
    },
    {
      "name": "Instrument",
      "definition_uri": "http://w3id.org/lambda/Instrument",
      "description": "An instrument used to collect data",
      "from_schema": "http://w3id.org/lambda/",
      "is_a": "NamedThing",
      "slots": [
        "namedThing__id",
        "namedThing__title",
        "namedThing__description",
        "instrument__instrument_code",
        "instrument__instrument_registry_id",
        "instrument__instrument_category",
        "instrument__facility_name",
        "instrument__facility_ror",
        "instrument__facility_organization_id",
        "instrument__beamline_id",
        "instrument__manufacturer",
        "instrument__model",
        "instrument__installation_date",
        "instrument__current_status"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "instrument_code",
          "description": "Human-friendly facility or laboratory identifier for the instrument (e.g., 'TITAN-KRIOS-1', 'ALS-12.3.1-SIBYLS', 'RIGAKU-FR-E'). Used for local reference and equipment tracking.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "instrument_registry_id",
          "description": "Controlled-vocabulary identifier linking this instrument to its canonical entry in a registry enum appropriate to the instrument type. For beamlines, use a value from BeamlineEnum; additional instrument-type registries may be referenced here as they are introduced.",
          "comments": [
            "Use this to link an instrument record to a known, validated registry entry, enabling schema-level validation against typos",
            "instrument_code is a free-text local label; instrument_registry_id is the schema-level controlled identity",
            "beamline_id captures the facility-local string ID (e.g., '19-ID'); instrument_registry_id captures the enum identity (e.g., APS_SBCCAT_19ID)",
            "Distinct from the instrument_id foreign-key slot used in association tables, which references an Instrument object"
          ],
          "any_of": [
            {
              "range": "BeamlineEnum",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "instrument_category",
          "description": "Category distinguishing beamlines from laboratory equipment",
          "comments": [
            "Use SYNCHROTRON_BEAMLINE for synchrotron beamlines",
            "Use ELECTRON_MICROSCOPE for cryo-EM instruments"
          ],
          "range": "InstrumentCategoryEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "facility_name",
          "description": "Name of the research facility where the instrument is located",
          "comments": [
            "Select from the standardized list of major synchrotron facilities",
            "Leave empty for laboratory-based instruments"
          ],
          "range": "FacilityEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "facility_ror",
          "description": "Research Organization Registry (ROR) identifier for the facility",
          "comments": [
            "Persistent identifier for the facility organization",
            "Example: https://ror.org/02jbv0t02 (Lawrence Berkeley National Laboratory)",
            "Retained for sources that publish only a ROR. Where the facility is described as an entity, prefer facility_organization_id, which reaches its parent institution, type and location rather than just its identifier."
          ],
          "range": "uriorcurie",
          "pattern": "^https://ror\\.org/\\w+$",
          "@type": "SlotDefinition"
        },
        {
          "name": "facility_organization_id",
          "description": "The Organization that operates this instrument's facility. An instrument sits at exactly one facility, so this is a direct reference rather than an association table - the same shape as Sample.parent_sample_id.",
          "range": "Organization",
          "@type": "SlotDefinition"
        },
        {
          "name": "beamline_id",
          "description": "Beamline identifier at synchrotron/neutron facility",
          "comments": [
            "Use facility-specific naming convention",
            "Examples: '12.3.1' (ALS), '17-ID-1' (NSLS-II), 'I04' (Diamond)",
            "For a validated controlled-vocabulary identity, also set instrument_registry_id (e.g., APS_SBCCAT_19ID)"
          ],
          "exact_mappings": [
            "mmCIF:_diffrn_source.pdbx_synchrotron_beamline",
            "nsls2:Beamline",
            "ispyb:BLSession.beamLineName"
          ],
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "manufacturer",
          "description": "Instrument manufacturer",
          "@type": "SlotDefinition"
        },
        {
          "name": "model",
          "description": "Instrument model",
          "@type": "SlotDefinition"
        },
        {
          "name": "installation_date",
          "description": "Date of instrument installation",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "current_status",
          "description": "Current operational status",
          "range": "InstrumentStatusEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://w3id.org/lambda/Instrument",
      "@type": "ClassDefinition"
    },
