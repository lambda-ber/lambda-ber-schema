      "usage_slot_name": "prov_agent",
      "range": "Agent",
      "required": true,
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "EstimatorDescriptor_definition",
      "definition_uri": "http://w3id.org/lambda/rocrate/definition",
      "description": "What the number actually means. Required: two values computed under different definitions are different quantities however alike their labels look.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://w3id.org/lambda/rocrate/definition"
      ],
      "close_mappings": [
        "https://lambda-ber.github.io/lambda-ber-schema/profile/saxs/0.4.0/terms/definition"
      ],
      "is_a": "definition",
      "domain": "EstimatorDescriptor",
      "slot_uri": "http://w3id.org/lambda/rocrate/definition",
      "alias": "definition",
