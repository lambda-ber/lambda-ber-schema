  "slots": [
    {
      "name": "at_context",
      "definition_uri": "http://w3id.org/lambda/rocrate/at_context",
      "description": "The JSON-LD context. MUST include the RO-Crate 1.2 context URI, and MUST bind `lambda` to `http://w3id.org/lambda/` and `lambdarc` to `http://w3id.org/lambda/rocrate/`.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "slot_uri": "http://w3id.org/lambda/rocrate/@context",
      "alias": "@context",
      "owner": "ROCrateMetadataDocument",
      "domain_of": [
        "ROCrateMetadataDocument"
      ],
      "range": "Any",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "at_graph",
      "definition_uri": "http://w3id.org/lambda/rocrate/at_graph",
      "description": "The flat set of entities. Order carries no meaning; relationships are by `@id` only.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "slot_uri": "http://w3id.org/lambda/rocrate/@graph",
      "alias": "@graph",
      "owner": "ROCrateMetadataDocument",
      "domain_of": [
        "ROCrateMetadataDocument"
      ],
      "range": "Any",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "at_id",
      "definition_uri": "http://w3id.org/lambda/rocrate/at_id",
      "description": "The entity's identifier - a relative path, an absolute URI, or a `#`-fragment.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/identifier"
      ],
      "slot_uri": "http://schema.org/identifier",
      "alias": "@id",
      "owner": "Agent",
      "domain_of": [
        "EntityReference",
        "CrateEntity",
        "Agent"
      ],
      "range": "uriorcurie",
      "@type": "SlotDefinition"
    },
    {
      "name": "at_type",
      "definition_uri": "http://w3id.org/lambda/rocrate/at_type",
      "description": "One or more types. LAMBDA entities carry the RO-Crate/schema.org type *first* so that a plain RO-Crate consumer understands the crate, then the `lambda:` type for LAMBDA-aware readers.\nModelled as the set of types it semantically is. JSON-LD also permits the shorthand of a bare string for a single type, and real crates use it freely; a reader MUST expand that shorthand to a one-element list before validating or testing membership, exactly as a JSON-LD processor would. Validation here is defined against the expanded form.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "slot_uri": "http://w3id.org/lambda/rocrate/@type",
      "alias": "@type",
      "owner": "Derivation",
      "domain_of": [
        "CrateEntity",
        "Designation",
        "Association",
        "Agent",
        "Derivation"
      ],
      "range": "string",
      "required": true,
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "name",
      "definition_uri": "http://w3id.org/lambda/rocrate/name",
      "description": "Human-readable label.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/name"
      ],
      "exact_mappings": [
        "http://w3id.org/lambda/title"
      ],
      "slot_uri": "http://schema.org/name",
      "owner": "Agent",
      "domain_of": [
        "CrateEntity",
        "Agent"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "description",
      "definition_uri": "http://w3id.org/lambda/rocrate/description",
      "description": "Prose summary, aimed at a reader deciding whether to open the dataset.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/description"
      ],
      "exact_mappings": [
        "http://w3id.org/lambda/description"
      ],
      "slot_uri": "http://schema.org/description",
      "owner": "CrateEntity",
      "domain_of": [
        "CrateEntity"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "conforms_to",
      "definition_uri": "http://w3id.org/lambda/rocrate/conforms_to",
      "description": "Specification or profile this entity claims conformance to.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://purl.org/dc/terms/conformsTo"
      ],
      "slot_uri": "http://purl.org/dc/terms/conformsTo",
      "alias": "conformsTo",
      "owner": "RelatedWork",
      "domain_of": [
        "MetadataDescriptor",
        "CrateRoot",
        "CrateFile",
        "CrateDatasetPart",
        "RelatedWork"
      ],
      "range": "EntityReference",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "about",
      "definition_uri": "http://w3id.org/lambda/rocrate/about",
      "description": "What the metadata file describes - always the root data entity.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/about"
      ],
      "slot_uri": "http://schema.org/about",
      "owner": "MetadataDescriptor",
      "domain_of": [
        "MetadataDescriptor"
      ],
      "range": "EntityReference",
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "date_published",
      "definition_uri": "http://w3id.org/lambda/rocrate/date_published",
      "description": "Publication date of the crate. String-typed, matching the main schema's date policy.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/datePublished"
      ],
      "slot_uri": "http://schema.org/datePublished",
      "alias": "datePublished",
      "owner": "CrateRoot",
      "domain_of": [
        "CrateRoot"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "date_modified",
      "definition_uri": "http://w3id.org/lambda/rocrate/date_modified",
      "description": "Last modification date.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/dateModified"
      ],
      "slot_uri": "http://schema.org/dateModified",
      "alias": "dateModified",
      "owner": "CrateFile",
      "domain_of": [
        "CrateRoot",
        "CrateFile"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "date_created",
      "definition_uri": "http://w3id.org/lambda/rocrate/date_created",
      "description": "Creation or deposition date. Distinct from `datePublished`: an archive deposit often records when the data was deposited but not when it was published, and the two should not be conflated.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/dateCreated"
      ],
      "slot_uri": "http://schema.org/dateCreated",
      "alias": "dateCreated",
      "owner": "CrateRoot",
      "domain_of": [
        "CrateRoot"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "license",
      "definition_uri": "http://w3id.org/lambda/rocrate/license",
      "description": "Licence, as a `{\"@id\": ...}` reference to a licence URI or a contextual entity. Required on the root: a manifest whose reuse terms are unknown is not a usable handoff. Where the source genuinely does not state one, reference a `RelatedWork` entity that says so and record the gap in `missing`.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/license"
      ],
      "slot_uri": "http://schema.org/license",
      "owner": "CrateRoot",
      "domain_of": [
        "CrateRoot"
      ],
      "range": "Any",
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "author",
      "definition_uri": "http://w3id.org/lambda/rocrate/author",
      "description": "People responsible for the dataset, by ORCID where known. Projects onto `Person` plus a person association; see `PersonEntity` for why the role travels on the association rather than on the person.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/author"
      ],
      "slot_uri": "http://schema.org/author",
      "owner": "CrateRoot",
      "domain_of": [
        "CrateRoot"
      ],
      "range": "EntityReference",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "publisher",
      "definition_uri": "http://w3id.org/lambda/rocrate/publisher",
      "description": "Publishing organization, by ROR where known.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/publisher"
      ],
      "slot_uri": "http://schema.org/publisher",
      "owner": "CrateRoot",
      "domain_of": [
        "CrateRoot"
      ],
      "range": "EntityReference",
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "identifier",
      "definition_uri": "http://w3id.org/lambda/rocrate/identifier",
      "description": "Identifiers for this entity. Use `PropertyValue` entries with a `propertyID` when more than one identifier scheme is in play, so a UUID is never mistaken for an accession.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/identifier"
      ],
      "slot_uri": "http://schema.org/identifier",
      "owner": "RelatedWork",
      "domain_of": [
        "CrateRoot",
        "CrateDatasetPart",
        "OrganizationEntity",
        "RelatedWork"
      ],
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "keywords",
      "definition_uri": "http://w3id.org/lambda/rocrate/keywords",
      "description": "Free-text tags for discovery.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/keywords"
      ],
      "exact_mappings": [
        "http://w3id.org/lambda/keywords"
      ],
      "slot_uri": "http://schema.org/keywords",
      "owner": "CrateRoot",
      "domain_of": [
        "CrateRoot"
      ],
      "range": "string",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "citation",
      "definition_uri": "http://w3id.org/lambda/rocrate/citation",
      "description": "Publications or database entries that cite or describe this dataset. A reference to a contextual entity is preferred, because it can carry a DOI; a bare citation string is accepted, because that is all many archive exports publish.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/citation"
      ],
      "slot_uri": "http://schema.org/citation",
      "owner": "CrateRoot",
      "domain_of": [
        "CrateRoot"
      ],
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "url",
      "definition_uri": "http://w3id.org/lambda/rocrate/url",
      "description": "Landing page or direct locator.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/url"
      ],
      "slot_uri": "http://schema.org/url",
      "owner": "RelatedWork",
      "domain_of": [
        "CrateRoot",
        "CrateDatasetPart",
        "OrganizationEntity",
        "SoftwareApplicationEntity",
        "DefinedTermEntity",
        "RelatedWork"
      ],
      "range": "uri",
      "@type": "SlotDefinition"
    },
    {
      "name": "conditions_of_access",
      "definition_uri": "http://w3id.org/lambda/rocrate/conditions_of_access",
      "description": "Access conditions - `open`, `embargoed`, `restricted`. Embargo detail originates outside the pipeline; where a builder cannot reach the proposal system it declares this missing and fails closed rather than guessing `open`.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/conditionsOfAccess"
      ],
      "slot_uri": "http://schema.org/conditionsOfAccess",
      "alias": "conditionsOfAccess",
      "owner": "CrateRoot",
      "domain_of": [
        "CrateRoot"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "has_part",
      "definition_uri": "http://w3id.org/lambda/rocrate/has_part",
      "description": "The manifest itself: every file and dataset part carried by this entity. Every present artefact appears here; every absent one appears in `missing`.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/hasPart"
      ],
      "slot_uri": "http://schema.org/hasPart",
      "alias": "hasPart",
      "owner": "CrateDatasetPart",
      "domain_of": [
        "CrateRoot",
        "CrateDatasetPart"
      ],
      "range": "EntityReference",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "distribution",
      "definition_uri": "http://w3id.org/lambda/rocrate/distribution",
      "description": "A `DataDownload` for a part whose bytes are retrieved from elsewhere.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/distribution"
      ],
      "slot_uri": "http://schema.org/distribution",
      "owner": "CrateDatasetPart",
      "domain_of": [
        "CrateDatasetPart"
      ],
      "range": "EntityReference",
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "encoding_format",
      "definition_uri": "http://w3id.org/lambda/rocrate/encoding_format",
      "description": "IANA media type. Note this is *not* the same thing as `lambda:file_format`, which is a LAMBDA-controlled term; a crate carrying both is being helpful, not redundant.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/encodingFormat"
      ],
      "close_mappings": [
        "http://w3id.org/lambda/file_format"
      ],
      "slot_uri": "http://schema.org/encodingFormat",
      "alias": "encodingFormat",
      "owner": "CrateDatasetPart",
      "domain_of": [
        "CrateFile",
        "CrateDatasetPart"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "content_size",
      "definition_uri": "http://w3id.org/lambda/rocrate/content_size",
      "description": "Size in bytes. RO-Crate 1.2 expects text; integers occur in the wild and are accepted.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/contentSize"
      ],
      "exact_mappings": [
        "http://w3id.org/lambda/file_size_bytes"
      ],
      "slot_uri": "http://schema.org/contentSize",
      "alias": "contentSize",
      "owner": "CrateDatasetPart",
      "domain_of": [
        "CrateRoot",
        "CrateFile",
        "CrateDatasetPart"
      ],
      "range": "Any",
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sha256",
      "definition_uri": "http://w3id.org/lambda/rocrate/sha256",
      "description": "SHA-256 of the bytes. The RO-Crate 1.2 context already maps the bare term `sha256` to `http://schema.org/sha256`, so that is what it means in any crate that does not override it - and a profile asserting a different IRI for the same key would be contradicted by the crate's own context. The SSRL 0.2 crates *do* override it to `lambda:sha256` in their inline context; that spelling is carried as a close mapping so those crates still project.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/sha256"
      ],
      "exact_mappings": [
        "http://w3id.org/lambda/checksum"
      ],
      "close_mappings": [
        "http://w3id.org/lambda/sha256"
      ],
      "slot_uri": "http://schema.org/sha256",
      "owner": "SchemaSetEntry",
      "domain_of": [
        "CrateFile",
        "CrateDatasetPart",
        "SchemaSetEntry"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "mime_type",
      "definition_uri": "http://w3id.org/lambda/rocrate/mime_type",
      "description": "Media type, as published by SSRL alongside `encodingFormat`.",
      "deprecated": "Duplicates `encodingFormat`. Retained so SSRL 0.2 crates validate; do not emit in new crates.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "deprecated_element_has_exact_replacement": "schema:encodingFormat",
      "mappings": [
        "http://w3id.org/lambda/rocrate/mimeType"
      ],
      "exact_mappings": [
        "http://schema.org/encodingFormat"
      ],
      "slot_uri": "http://w3id.org/lambda/rocrate/mimeType",
      "alias": "mimeType",
