      "domain_of": [
        "ExperimentRunAction",
        "WorkflowRunAction",
        "Designation"
      ],
      "range": "EntityReference",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "prov_generated",
      "definition_uri": "http://w3id.org/lambda/rocrate/prov_generated",
      "description": "Artefacts an activity produced.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://www.w3.org/ns/prov#generated"
      ],
      "slot_uri": "http://www.w3.org/ns/prov#generated",
      "alias": "prov:generated",
      "owner": "Designation",
      "domain_of": [
        "ExperimentRunAction",
        "WorkflowRunAction",
        "Designation"
      ],
      "range": "EntityReference",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "was_generated_by",
      "definition_uri": "http://w3id.org/lambda/rocrate/was_generated_by",
      "description": "The activity that produced this entity or value.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://www.w3.org/ns/prov#wasGeneratedBy"
      ],
      "slot_uri": "http://www.w3.org/ns/prov#wasGeneratedBy",
      "alias": "prov:wasGeneratedBy",
      "owner": "CrateFile",
      "domain_of": [
        "CrateFile"
      ],
      "range": "EntityReference",
      "inlined": true,
