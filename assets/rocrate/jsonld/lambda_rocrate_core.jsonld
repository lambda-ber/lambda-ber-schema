      "slot_uri": "http://www.w3.org/ns/prov#wasDerivedFrom",
      "alias": "prov:wasDerivedFrom",
      "owner": "CrateFile",
      "domain_of": [
        "CrateFile"
      ],
      "range": "EntityReference",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "was_informed_by",
      "definition_uri": "http://w3id.org/lambda/rocrate/was_informed_by",
      "description": "An earlier activity this one depended on - the collection session a processing run consumed. Chains activities without inventing a profile-local term for it.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://www.w3.org/ns/prov#wasInformedBy"
      ],
      "slot_uri": "http://www.w3.org/ns/prov#wasInformedBy",
      "alias": "prov:wasInformedBy",
      "owner": "WorkflowRunAction",
      "domain_of": [
        "ExperimentRunAction",
        "WorkflowRunAction"
      ],
      "range": "EntityReference",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "was_attributed_to",
      "definition_uri": "http://w3id.org/lambda/rocrate/was_attributed_to",
      "description": "The agent responsible for an entity or a derived value.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://www.w3.org/ns/prov#wasAttributedTo"
      ],
      "slot_uri": "http://www.w3.org/ns/prov#wasAttributedTo",
      "alias": "prov:wasAttributedTo",
      "owner": "EstimatorDescriptor",
      "domain_of": [
        "EstimatorDescriptor"
      ],
      "range": "Agent",
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "qualified_association",
      "definition_uri": "http://w3id.org/lambda/rocrate/qualified_association",
      "description": "Who carried out an activity and under which plan. Qualified rather than a bare `prov:wasAssociatedWith` precisely so the plan can travel with the agent.\nMultivalued, because PROV does not make this functional and real activities have more than one responsible party: a collection session has an operator *and* a local contact, and a processing run may be attributed to both a person and the policy they ran under. Forcing a single association would silently discard whichever agent the builder happened to write second.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://www.w3.org/ns/prov#qualifiedAssociation"
      ],
      "slot_uri": "http://www.w3.org/ns/prov#qualifiedAssociation",
      "alias": "prov:qualifiedAssociation",
      "owner": "Designation",
      "domain_of": [
        "ExperimentRunAction",
        "WorkflowRunAction",
        "Designation"
      ],
      "range": "Association",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "prov_agent",
      "definition_uri": "http://w3id.org/lambda/rocrate/prov_agent",
      "description": "The agent in an association.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://www.w3.org/ns/prov#agent"
      ],
      "slot_uri": "http://www.w3.org/ns/prov#agent",
      "alias": "prov:agent",
      "owner": "Association",
      "domain_of": [
        "Association"
      ],
      "range": "Agent",
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "had_plan",
      "definition_uri": "http://w3id.org/lambda/rocrate/had_plan",
      "description": "The published, versioned rule the agent followed. This is the PROV spelling of what earlier drafts called `rule`.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://www.w3.org/ns/prov#hadPlan"
      ],
      "exact_mappings": [
        "http://w3id.org/lambda/rocrate/rule"
      ],
      "slot_uri": "http://www.w3.org/ns/prov#hadPlan",
      "alias": "prov:hadPlan",
      "owner": "Association",
      "domain_of": [
        "Association"
      ],
      "range": "EntityReference",
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "acted_on_behalf_of",
      "definition_uri": "http://w3id.org/lambda/rocrate/acted_on_behalf_of",
      "description": "The organization or person an agent acted for.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://www.w3.org/ns/prov#actedOnBehalfOf"
      ],
      "slot_uri": "http://www.w3.org/ns/prov#actedOnBehalfOf",
      "alias": "prov:actedOnBehalfOf",
      "owner": "Agent",
      "domain_of": [
        "Agent"
      ],
      "range": "EntityReference",
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "prov_entity",
      "definition_uri": "http://w3id.org/lambda/rocrate/prov_entity",
      "description": "The artefact a value was read out of.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://www.w3.org/ns/prov#entity"
      ],
      "slot_uri": "http://www.w3.org/ns/prov#entity",
      "alias": "prov:entity",
      "owner": "Derivation",
      "domain_of": [
        "Derivation"
      ],
      "range": "EntityReference",
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "started_at_time",
      "definition_uri": "http://w3id.org/lambda/rocrate/started_at_time",
      "description": "When an activity began.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://www.w3.org/ns/prov#startedAtTime"
      ],
      "exact_mappings": [
        "http://w3id.org/lambda/started_at"
      ],
      "slot_uri": "http://www.w3.org/ns/prov#startedAtTime",
      "alias": "prov:startedAtTime",
      "owner": "Designation",
      "domain_of": [
        "ExperimentRunAction",
        "WorkflowRunAction",
        "Designation"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "ended_at_time",
      "definition_uri": "http://w3id.org/lambda/rocrate/ended_at_time",
      "description": "When an activity ended.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://www.w3.org/ns/prov#endedAtTime"
      ],
      "exact_mappings": [
        "http://w3id.org/lambda/completed_at"
      ],
      "slot_uri": "http://www.w3.org/ns/prov#endedAtTime",
      "alias": "prov:endedAtTime",
      "owner": "Designation",
      "domain_of": [
