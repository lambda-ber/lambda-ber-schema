    {
      "name": "estimator",
      "definition_uri": "http://w3id.org/lambda/rocrate/estimator",
      "description": "What produced a derived number, and how far it may be trusted.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://w3id.org/lambda/rocrate/estimator"
      ],
      "close_mappings": [
        "https://lambda-ber.github.io/lambda-ber-schema/profile/saxs/0.4.0/terms/estimator"
      ],
      "slot_uri": "http://w3id.org/lambda/rocrate/estimator",
      "owner": "WorkflowRunAction",
      "domain_of": [
        "CrateFile",
        "WorkflowRunAction"
      ],
      "range": "EstimatorDescriptor",
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "result_summary",
      "definition_uri": "http://w3id.org/lambda/rocrate/result_summary",
      "description": "**The extension seam.** Technique-specific result quantities - a SAXS quantity register, an MX data-reduction summary - live in here, and a technique extension is what gives the block its shape. Core deliberately leaves it opaque: core's job is to say *where* such quantities go and that they are subject to the estimator and admissibility rules, not to know any technique's numbers.\nCarrying them here rather than as bare properties on the entity is what keeps a crate structurally valid against core while an extension tightens the contents. A crate that scatters technique quantities directly onto an entity is readable but not composable, and will not validate against core.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://w3id.org/lambda/rocrate/resultSummary"
      ],
      "close_mappings": [
        "https://lambda-ber.github.io/lambda-ber-schema/profile/saxs/0.4.0/terms/summary"
      ],
      "slot_uri": "http://w3id.org/lambda/rocrate/resultSummary",
      "alias": "resultSummary",
      "owner": "WorkflowRunAction",
      "domain_of": [
        "CrateRoot",
        "WorkflowRunAction"
      ],
      "range": "Any",
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "prov_used",
      "definition_uri": "http://w3id.org/lambda/rocrate/prov_used",
      "description": "Artefacts an activity consumed.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
