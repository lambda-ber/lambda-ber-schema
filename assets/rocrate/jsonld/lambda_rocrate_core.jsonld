    {
      "name": "AttributeValue",
      "definition_uri": "http://w3id.org/lambda/AttributeValue",
      "description": "The value for any attribute of an entity. This object can hold both the un-normalized atomic value and the structured value.",
      "from_schema": "http://w3id.org/lambda/types",
      "mappings": [
        "nmdc:AttributeValue"
      ],
      "abstract": true,
      "slots": [
        "attributeValue__attribute",
        "attributeValue__raw_value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "attribute",
          "description": "The attribute being represented.",
          "range": "Attribute",
          "@type": "SlotDefinition"
        },
        {
          "name": "raw_value",
          "description": "Unnormalized atomic string representation, suggested syntax {number} {unit}",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/nmdc/AttributeValue",
      "@type": "ClassDefinition"
    },
    {
      "name": "Attribute",
      "definition_uri": "http://w3id.org/lambda/Attribute",
      "description": "A domain, measurement, attribute, property, or any descriptor for additional properties to be added to an entity. Where available, please use OBO Foundry ontologies or other controlled vocabularies for attributes; the label should be the term name from the ontology and the id should be the fully-qualified CURIE.",
      "from_schema": "http://w3id.org/lambda/types",
      "slots": [
        "attribute__id",
        "attribute__label"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "id",
          "description": "A CURIE for the attribute, should one exist. Where available, please use OBO Foundry ontologies or other controlled vocabularies for labelling attributes; the id should be the term ID from the ontology.",
          "recommended": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "label",
          "description": "Text string to describe the attribute. Where available, please use OBO Foundry ontologies or other controlled vocabularies for labelling attributes; the label should be the term name from the ontology.",
          "aliases": [
            "name",
            "title"
          ],
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://w3id.org/lambda/Attribute",
      "@type": "ClassDefinition"
    },
    {
      "name": "QuantityValue",
      "definition_uri": "http://w3id.org/lambda/QuantityValue",
      "description": "A simple quantity value, representing a measurement with a numeric value and unit. This allows data providers to specify measurements in their preferred unit while enabling standardized interpretation. For example, a pixel size could be specified as 1.5 micrometers or 15 Angstroms, with the unit clearly specified.",
      "from_schema": "http://w3id.org/lambda/types",
      "mappings": [
        "nmdc:QuantityValue",
        "schema:QuantityValue"
      ],
      "is_a": "AttributeValue",
      "slots": [
        "attributeValue__attribute",
        "maximum_numeric_value",
        "minimum_numeric_value",
        "QuantityValue_numeric_value",
        "QuantityValue_unit",
        "unit_cv_id",
        "QuantityValue_raw_value"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/nmdc/QuantityValue",
      "@type": "ClassDefinition"
    },
    {
      "name": "TextValue",
      "definition_uri": "http://w3id.org/lambda/TextValue",
      "description": "A value described using a text string, optionally with a controlled vocabulary ID.",
      "from_schema": "http://w3id.org/lambda/types",
      "mappings": [
        "nmdc:TextValue"
      ],
      "is_a": "AttributeValue",
      "slots": [
        "attributeValue__attribute",
        "attributeValue__raw_value",
        "textValue__value",
        "textValue__value_cv_id"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "value",
          "description": "The text value",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "value_cv_id",
          "description": "For values in a controlled vocabulary, the CV ID for the value.",
          "range": "curie",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/nmdc/TextValue",
      "@type": "ClassDefinition"
    },
    {
      "name": "DateTimeValue",
      "definition_uri": "http://w3id.org/lambda/DateTimeValue",
      "description": "A date or date and time value.",
      "from_schema": "http://w3id.org/lambda/types",
      "mappings": [
        "nmdc:DateTimeValue"
      ],
      "is_a": "AttributeValue",
      "slots": [
        "attributeValue__attribute",
        "attributeValue__raw_value",
        "dateTimeValue__value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "value",
          "description": "The date or date/time value, expressed in ISO 8601-compatible form. Dates should be expressed as YYYY-MM-DD; times should be expressed as HH:MM:SS with optional milliseconds and an indication of the timezone.",
          "examples": [
            {
              "value": "2025-11-09",
              "@type": "Example"
            },
            {
              "value": "2025-09-16T22:48:54Z",
              "@type": "Example"
            }
          ],
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/nmdc/DateTimeValue",
      "@type": "ClassDefinition"
    },
    {
      "name": "ProteinAnnotation",
      "definition_uri": "http://w3id.org/lambda/functional_annotation/ProteinAnnotation",
      "description": "Base class for all protein-related functional and structural annotations",
      "from_schema": "http://w3id.org/lambda/functional_annotation",
      "is_a": "NamedThing",
      "slots": [
        "namedThing__id",
        "namedThing__title",
        "namedThing__description",
        "proteinAnnotation__protein_id",
        "proteinAnnotation__pdb_entry",
        "proteinAnnotation__chain_id",
        "proteinAnnotation__residue_range",
        "proteinAnnotation__confidence_score",
        "proteinAnnotation__evidence_type",
        "proteinAnnotation__evidence_code",
        "proteinAnnotation__source_database",
        "proteinAnnotation__annotation_method",
        "proteinAnnotation__publication_ids"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "protein_id",
          "description": "UniProt accession number",
          "required": true,
          "pattern": "^[A-Z][0-9][A-Z0-9]{3}[0-9]|[A-Z][0-9][A-Z0-9]{3}[0-9]-[0-9]+$",
          "@type": "SlotDefinition"
        },
        {
          "name": "pdb_entry",
          "description": "PDB identifier",
          "pattern": "^[0-9][A-Za-z0-9]{3}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "chain_id",
          "description": "Chain identifier in the PDB structure",
          "pattern": "^[A-Za-z0-9]+$",
          "@type": "SlotDefinition"
        },
        {
          "name": "residue_range",
          "description": "Range of residues (e.g., '1-100', '25,27,30-35')",
          "pattern": "^[0-9,\\-]+$",
          "@type": "SlotDefinition"
        },
        {
          "name": "confidence_score",
          "description": "Confidence score for the annotation (range: 0-1)",
          "range": "float",
          "minimum_value": 0,
          "maximum_value": 1,
          "@type": "SlotDefinition"
        },
        {
          "name": "evidence_type",
          "description": "Type of evidence supporting this annotation",
          "range": "EvidenceTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "evidence_code",
          "description": "Evidence and Conclusion Ontology (ECO) code",
          "range": "uriorcurie",
          "@type": "SlotDefinition"
        },
        {
          "name": "source_database",
          "description": "Source database or resource that provided this annotation",
          "range": "AnnotationSourceEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "annotation_method",
          "description": "Computational or experimental method used",
          "@type": "SlotDefinition"
        },
        {
          "name": "publication_ids",
          "description": "IDs of one or more publications supporting this annotation. Use PubMed IDs in the format 'PMID:XXXXXXX' or DOIs with 'DOI:' prefix.",
          "multivalued": true,
          "pattern": "^(PMID:[0-9]+|DOI:10\\.[0-9]{4,}/[-._;()/:A-Za-z0-9]+)$",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://w3id.org/lambda/functional_annotation/ProteinAnnotation",
      "@type": "ClassDefinition"
    },
    {
      "name": "FunctionalSite",
      "definition_uri": "http://w3id.org/lambda/functional_annotation/FunctionalSite",
      "description": "Functional sites including catalytic, binding, and regulatory sites",
      "from_schema": "http://w3id.org/lambda/functional_annotation",
      "is_a": "ProteinAnnotation",
      "slots": [
        "namedThing__id",
        "namedThing__title",
        "namedThing__description",
        "proteinAnnotation__protein_id",
        "proteinAnnotation__pdb_entry",
        "proteinAnnotation__chain_id",
        "proteinAnnotation__residue_range",
        "proteinAnnotation__confidence_score",
        "proteinAnnotation__evidence_type",
        "proteinAnnotation__evidence_code",
        "proteinAnnotation__source_database",
        "proteinAnnotation__annotation_method",
        "proteinAnnotation__publication_ids",
        "functionalSite__site_type",
        "functionalSite__site_name",
        "functionalSite__residues",
        "functionalSite__ligand_interactions",
        "functionalSite__conservation_score",
        "functionalSite__functional_importance",
        "functionalSite__go_terms",
        "functionalSite__ec_number"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "site_type",
          "description": "Type of functional site",
          "range": "FunctionalSiteTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "site_name",
          "description": "Common name for this site",
          "@type": "SlotDefinition"
        },
        {
          "name": "residues",
          "description": "List of residues forming the functional site. Each should be specified as a string (e.g., \"45\", \"120A\").",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ligand_interactions",
          "description": "Ligands that interact with this site",
          "range": "LigandInteraction",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "conservation_score",
          "description": "Evolutionary conservation score (range: 0-1)",
          "range": "float",
          "minimum_value": 0,
          "maximum_value": 1,
          "@type": "SlotDefinition"
        },
        {
          "name": "functional_importance",
          "description": "Description of functional importance",
          "@type": "SlotDefinition"
        },
        {
          "name": "go_terms",
          "description": "Associated Gene Ontology terms",
          "range": "uriorcurie",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ec_number",
          "description": "Enzyme Commission number for catalytic sites",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://w3id.org/lambda/functional_annotation/FunctionalSite",
      "@type": "ClassDefinition"
    },
