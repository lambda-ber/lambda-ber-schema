      "alias": "measurementTechnique",
      "owner": "CrateRoot",
      "domain_of": [
        "CrateRoot"
      ],
      "range": "EntityReference",
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "object",
      "definition_uri": "http://w3id.org/lambda/rocrate/object",
      "description": "What an action consumed - the sample for a collection, the inputs for a workflow.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://schema.org/object"
      ],
      "slot_uri": "http://schema.org/object",
