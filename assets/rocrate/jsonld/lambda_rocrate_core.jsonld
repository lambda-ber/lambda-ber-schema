      "description": "A decimal degree expresses latitude or longitude as decimal fractions.",
      "from_schema": "http://w3id.org/lambda/types",
      "see_also": [
        "https://en.wikipedia.org/wiki/Decimal_degrees"
      ],
      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#decimal",
      "@type": "TypeDefinition"
    },
    {
      "name": "smiles_string",
      "definition_uri": "http://w3id.org/lambda/functional_annotation/SmilesString",
      "description": "A SMILES representation of a chemical structure",
      "from_schema": "http://w3id.org/lambda/functional_annotation",
      "see_also": [
        "https://en.wikipedia.org/wiki/Simplified_molecular-input_line-entry_system",
        "https://www.epa.gov/sites/default/files/2015-05/documents/appendf.pdf"
      ],
      "aliases": [
        "smiles"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^([A-Za-z0-9@+\\-\\[\\]\\(\\)\\\\/=#$%.]+)$",
      "@type": "TypeDefinition"
    }
  ],
  "enums": [
    {
      "name": "AbsenceReasonEnum",
      "definition_uri": "http://w3id.org/lambda/rocrate/AbsenceReasonEnum",
      "description": "Why a value or artefact is absent. Distinguishing these is the point of declaring absence.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "permissible_values": [
        {
          "text": "not-registered",
          "description": "No upstream system ever held the value. Typically fields originating in a proposal system the builder cannot reach."
        },
        {
          "text": "not-available",
          "description": "The value exists in an otherwise complete source, but this build could not reach the bytes."
        },
        {
          "text": "not-deposited",
          "description": "The artefact exists or existed, but the source archive did not include it. The normal case for raw acquisition data in public deposits."
        },
        {
          "text": "embargoed",
          "description": "Withheld under an access embargo; may become available later."
        },
        {
          "text": "not-applicable",
          "description": "The field does not apply to this technique or collection mode. Distinct from a gap: nothing is missing."
        }
      ]
    },
    {
      "name": "SufficiencyTierEnum",
      "definition_uri": "http://w3id.org/lambda/rocrate/SufficiencyTierEnum",
      "description": "What a crate is sufficient *for*. Splitting these lets a crate be findable and judgeable without being reprocessable - which is what most public deposits actually are.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "permissible_values": [
        {
          "text": "S1",
          "description": "Findable - the generic search fields resolve."
        },
        {
          "text": "S2-core",
          "description": "Retrievable core - the designated result and its analysis record are addressable, sized and checksummed. Required for conformance."
        },
        {
          "text": "S2-acquisition",
          "description": "Reprocessable - the raw acquisition and its subtracted or reference data are present. Optional, but its absence MUST be declared rather than silent."
        },
        {
          "text": "S3",
          "description": "Interpretable - every derived quantity names its estimator, convention and unit."
        }
      ]
    },
    {
      "name": "AdmissibilityEnum",
      "definition_uri": "http://w3id.org/lambda/rocrate/AdmissibilityEnum",
      "description": "How far a derived value may be compared. A search MUST NOT filter on a `local` value: it would rank datasets against each other on a number that only means something inside one pipeline.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "permissible_values": [
        {
          "text": "local",
          "description": "Meaningful only within the producing pipeline. Displayable, not filterable."
        },
        {
          "text": "comparable",
          "description": "Comparable across datasets that share the stated definition and companions."
        },
        {
          "text": "global",
          "description": "Comparable across datasets unconditionally, under a published shared definition."
        }
      ]
    },
    {
      "name": "PackageTierEnum",
      "definition_uri": "http://w3id.org/lambda/rocrate/PackageTierEnum",
      "description": "How much of a dataset a crate packages.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "permissible_values": [
        {
          "text": "manifest",
          "description": "Metadata and pointers only; no payload travels. The lightest useful crate and the default for a federation handoff."
        },
        {
          "text": "processing",
          "description": "Processed and derived results plus their provenance; raw acquisition referenced only."
        },
        {
          "text": "full",
          "description": "Raw acquisition and derived results both present."
        }
      ]
    },
    {
      "name": "FacilityEnum",
      "definition_uri": "http://w3id.org/lambda/FacilityEnum",
      "description": "Major synchrotron and structural biology research facilities worldwide",
      "comments": [
        "This enum provides standardized identifiers for major facilities with rich metadata",
        "ROR (Research Organization Registry) IDs provide persistent organizational identifiers",
        "Not currently bound to any slots - available for future use"
      ],
      "from_schema": "http://w3id.org/lambda/",
      "permissible_values": [
        {
          "text": "NSLS_II",
          "description": "Fourth-generation synchrotron light source at Brookhaven National Laboratory, Upton, NY, USA",
          "meaning": "ROR:01q47ea17",
          "annotations": [
            {
              "tag": "facility_type",
              "value": "FacilityTypeEnum:SYNCHROTRON"
            },
            {
              "tag": "parent_organization",
              "value": "Brookhaven National Laboratory"
            },
            {
              "tag": "parent_ror",
              "value": "ROR:02ex6cf31"
            },
            {
              "tag": "location",
              "value": "Upton, New York, USA"
            },
            {
              "tag": "country",
              "value": "USA"
            },
            {
              "tag": "doe_facility",
              "value": "true"
            },
            {
              "tag": "doe_office",
              "value": "Office of Science"
            },
            {
              "tag": "wikidata_id",
              "value": "Q30270543"
            },
            {
              "tag": "energy_gev",
              "value": "3.0"
            },
