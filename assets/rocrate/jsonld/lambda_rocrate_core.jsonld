        "IHMCIF:_ihm_model_list",
        "IHMCIF:_ihm_ensemble_info"
      ],
      "is_a": "AttributeGroup",
      "slots": [
        "attributeGroup__description",
        "refinementParameters__symmetry",
        "refinementParameters__pixel_size",
        "refinementParameters__box_size",
        "refinementParameters__gold_standard",
        "refinementParameters__split_strategy",
        "refinementParameters__resolution_0_143",
        "refinementParameters__resolution_0_5",
        "refinementParameters__map_sharpening_bfactor"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "symmetry",
          "description": "Symmetry applied (C1, Cn, Dn, T, O, I)",
          "exact_mappings": [
            "mmCIF:_em_3d_reconstruction.symmetry_type"
          ],
          "range": "SymmetryEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "pixel_size",
          "description": "Pixel size, typically specified in Angstroms per pixel. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "box_size",
          "description": "Box size in pixels",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "gold_standard",
          "description": "Whether gold-standard refinement was used",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "split_strategy",
          "description": "Strategy for data splitting",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "resolution_0_143",
          "description": "Resolution at FSC=0.143, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "exact_mappings": [
            "mmCIF:_em_3d_reconstruction.resolution"
          ],
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "resolution_0_5",
          "description": "Resolution at FSC=0.5, typically specified in Angstroms. Data providers may specify alternative units by including the unit in the QuantityValue.",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "map_sharpening_bfactor",
          "description": "B-factor used for map sharpening, typically specified in Angstroms squared (\u00c5\u00b2). Data providers may specify alternative units by including the unit in the QuantityValue.",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://w3id.org/lambda/RefinementParameters",
      "@type": "ClassDefinition"
    },
    {
      "name": "FSCCurve",
      "definition_uri": "http://w3id.org/lambda/FSCCurve",
      "description": "Fourier Shell Correlation curve data.\n\nThe `resolution_angstrom` and `fsc_value` arrays must be of equal length, with each value at index i in `resolution_angstrom`\ncorresponding to the value at index i in `fsc_value`. Both arrays should not exceed 10,000 elements.\n",
      "from_schema": "http://w3id.org/lambda/",
      "is_a": "AttributeGroup",
      "slots": [
        "attributeGroup__description",
        "fSCCurve__resolution_angstrom",
