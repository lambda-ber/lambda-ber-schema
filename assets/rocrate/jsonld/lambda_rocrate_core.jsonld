        "SchemaSetEntry"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "version",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "QuantityValue_numeric_value",
      "definition_uri": "http://w3id.org/lambda/numeric_value",
      "description": "The numerical value of the quantity. May be null if the value is unknown or not measured.",
      "from_schema": "http://w3id.org/lambda/types",
      "mappings": [
        "https://w3id.org/nmdc/numeric_value",
        "http://qudt.org/1.1/schema/qudt#quantityValue",
        "https://schema.org/value"
      ],
      "is_a": "numeric_value",
      "domain": "QuantityValue",
      "slot_uri": "http://w3id.org/lambda/numeric_value",
      "alias": "numeric_value",
      "owner": "QuantityValue",
      "domain_of": [
        "QuantityValue"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "numeric_value",
      "range": "float",
      "@type": "SlotDefinition"
    },
    {
      "name": "QuantityValue_unit",
      "definition_uri": "http://w3id.org/lambda/unit",
      "description": "The unit of measurement (e.g., \"Angstroms\", \"micrometers\", \"kilodaltons\"). Should match the UCUM standard notation or Unit Ontology.",
      "from_schema": "http://w3id.org/lambda/types",
      "aliases": [
        "scale"
      ],
      "mappings": [
        "https://w3id.org/nmdc/unit",
        "http://qudt.org/1.1/schema/qudt#unit",
        "https://schema.org/unitCode",
        "http://purl.obolibrary.org/obo/UO_0000000"
      ],
      "is_a": "unit",
      "domain": "QuantityValue",
      "slot_uri": "http://w3id.org/lambda/unit",
      "alias": "unit",
      "owner": "QuantityValue",
      "domain_of": [
        "QuantityValue"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "unit",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "QuantityValue_raw_value",
      "definition_uri": "http://w3id.org/lambda/raw_value",
      "description": "Unnormalized atomic string representation, suggested syntax {number} {unit}",
      "examples": [
        {
          "value": "1.5 micrometers",
          "@type": "Example"
        },
        {
          "value": "50 Angstroms",
          "@type": "Example"
        }
      ],
      "from_schema": "http://w3id.org/lambda/types",
      "mappings": [
        "https://w3id.org/nmdc/raw_value"
      ],
      "is_a": "attributeValue__raw_value",
      "domain": "QuantityValue",
      "slot_uri": "http://w3id.org/lambda/raw_value",
      "alias": "raw_value",
      "owner": "QuantityValue",
      "domain_of": [
        "QuantityValue"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "raw_value",
      "range": "string",
      "@type": "SlotDefinition"
    }
  ],
  "classes": [
    {
      "name": "ROCrateMetadataDocument",
      "definition_uri": "http://w3id.org/lambda/rocrate/ROCrateMetadataDocument",
      "description": "An `ro-crate-metadata.json` file: a JSON-LD document whose `@graph` is a flat set of entities linked by `@id`. This is the tree root of the profile, so a real crate file validates as-is.",
      "comments": [
        "`@graph` has range `Any` on purpose. LinkML closes every nested class in the generated JSON Schema, so constraining `@graph` to the entity classes here would reject any crate that carries a technique-extension term - which is precisely the composition this profile is built for. Per-entity enforcement happens by dispatching each entity on its `@type` and validating it against the matching class (validation model, layer 2)."
      ],
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:CreativeWork"
      ],
      "slots": [
        "at_context",
        "at_graph"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/CreativeWork",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "EntityReference",
      "definition_uri": "http://w3id.org/lambda/rocrate/EntityReference",
      "description": "A `{\"@id\": \"...\"}` reference to another entity in the graph, or to an external resource. This is how RO-Crate expresses every relationship; it is never a bare string.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "slots": [
        "at_id"
      ],
      "slot_usage": {},
      "class_uri": "http://w3id.org/lambda/rocrate/EntityReference",
      "@type": "ClassDefinition"
    },
    {
      "name": "CrateEntity",
      "definition_uri": "http://w3id.org/lambda/rocrate/CrateEntity",
      "description": "Anything that appears in the `@graph`. Every entity is addressable (`@id`) and typed (`@type`); everything else depends on what it is.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "abstract": true,
      "slots": [
        "at_id",
        "at_type",
        "name",
        "description"
      ],
      "slot_usage": {},
      "class_uri": "http://w3id.org/lambda/rocrate/CrateEntity",
      "@type": "ClassDefinition"
    },
    {
      "name": "MetadataDescriptor",
      "definition_uri": "http://w3id.org/lambda/rocrate/MetadataDescriptor",
      "description": "The self-description of the metadata file. `@id` is `ro-crate-metadata.json`, `conformsTo` names the RO-Crate version, and `about` points at the root data entity.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:CreativeWork"
      ],
      "is_a": "CrateEntity",
      "slots": [
        "at_type",
        "name",
        "description",
        "MetadataDescriptor_conforms_to",
        "MetadataDescriptor_about",
        "MetadataDescriptor_at_id"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/CreativeWork",
      "@type": "ClassDefinition"
    },
    {
      "name": "CrateRoot",
      "definition_uri": "http://w3id.org/lambda/rocrate/CrateRoot",
      "description": "The root data entity: one crate, one manifest, one search row. Carries the identity, access and provenance summary a reader needs to judge the dataset without opening it, plus the `hasPart` manifest of what is inside.\nTyped `[\"Dataset\", \"lambda:Dataset\"]`. Crates written against the SSRL 0.2 vocabulary type this `[\"Dataset\", \"lambda:Experiment\"]`; readers MUST accept that spelling and SHOULD treat it as deprecated.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:Dataset"
      ],
      "exact_mappings": [
        "lambda:Dataset"
      ],
      "close_mappings": [
        "lambda:Study"
      ],
      "is_a": "CrateEntity",
      "slots": [
        "at_type",
        "CrateRoot_conforms_to",
        "date_published",
        "date_modified",
        "date_created",
        "license",
        "author",
        "publisher",
        "identifier",
        "keywords",
        "citation",
        "url",
        "conditions_of_access",
        "content_size",
        "measurement_technique",
        "CrateRoot_has_part",
        "facility",
        "facility_name",
        "facility_ror",
        "instrument_name",
        "technique",
        "collection_date",
        "sample_code",
        "protein_name",
        "organism",
        "proposal_id",
        "schema_set",
        "sufficiency",
        "designated",
        "missing",
        "derived",
        "package_tier",
        "generated_at",
        "result_summary",
        "vocab_entry",
        "id_recipe_version",
        "sample_name",
        "protein_name_camel",
        "uniprot_id",
        "pdb_code",
        "enzyme_class",
        "resolution_angstrom",
        "CrateRoot_at_id",
        "CrateRoot_name",
        "CrateRoot_description"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/Dataset",
      "@type": "ClassDefinition"
    },
    {
      "name": "CrateFile",
      "definition_uri": "http://w3id.org/lambda/rocrate/CrateFile",
      "description": "One file in the manifest. Integrity is the point of a manifest, so a file entity carries a locator, a size and a checksum; where the source did not publish one, its absence is *declared* on the root (see `missing`) and never silently omitted.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:MediaObject"
      ],
      "exact_mappings": [
        "lambda:DataFile"
      ],
      "is_a": "CrateEntity",
      "slots": [
        "at_type",
        "description",
        "CrateFile_encoding_format",
        "CrateFile_content_size",
        "CrateFile_sha256",
        "mime_type",
        "additional_type",
        "date_modified",
        "file_format",
        "data_type",
        "processing_level",
        "storage_uri",
        "file_role",
        "conforms_to",
        "designated_flag",
        "estimator",
        "allow_empty",
        "was_derived_from",
        "was_generated_by",
        "provenance",
        "CrateFile_at_id",
        "CrateFile_name"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/MediaObject",
      "@type": "ClassDefinition"
    },
    {
      "name": "CrateDatasetPart",
      "definition_uri": "http://w3id.org/lambda/rocrate/CrateDatasetPart",
      "description": "A part of the manifest that is itself a dataset rather than a single file - a raw frame series, a processing result, a sub-collection. **This is the entity that points at fuller metadata.**\nA part MUST resolve **at least one** of three pointer mechanisms, or declare in `missing` why it resolves none. More than one is fine and often useful; what is not acceptable is a part that names a body of data and then says nothing about where its description lives.\n1. **nested crate** - `conformsTo` a LAMBDA profile URI plus either a `hasPart` member ending\n   in `ro-crate-metadata.json`, or an absolute `@id` naming a remote crate;\n2. **schema record** - `lambdarc:schemaRecord` referencing a file that holds a full\n   `lambda-ber-schema` document, with `conformsTo`, `lambdarc:schemaVersion` and a checksum;\n3. **remote registration** - `identifier` (DOI or archive accession) plus `url`.\nIndividual members of a bulk series are never enumerated: a frame series is one part with a count and a size, not N file entities.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:Dataset"
      ],
      "close_mappings": [
        "lambda:RawUnit",
        "lambda:DerivedProduct"
      ],
      "is_a": "CrateEntity",
      "slots": [
        "at_type",
        "description",
        "has_part",
        "conforms_to",
        "schema_record",
        "schema_version",
        "identifier",
        "url",
        "distribution",
        "content_size",
        "sha256",
        "encoding_format",
        "additional_type",
        "part_count",
        "raw_included",
        "designated_flag",
        "missing",
        "raw_unit_id",
        "product_id",
        "CrateDatasetPart_at_id",
        "CrateDatasetPart_name"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/Dataset",
      "@type": "ClassDefinition"
    },
    {
      "name": "SampleEntity",
      "definition_uri": "http://w3id.org/lambda/rocrate/SampleEntity",
      "description": "The specimen the crate is about. Only the searchable identity layer belongs here; molecular composition, buffer and storage detail live in the fuller record this crate points at.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:BioChemEntity"
      ],
      "exact_mappings": [
        "lambda:Sample"
      ],
      "is_a": "CrateEntity",
      "slots": [
        "at_type",
        "name",
        "description",
        "SampleEntity_sample_code",
        "sample_type",
        "protein_name",
        "organism",
        "sequence",
        "seguid",
        "uniprot_id",
        "expression_system",
        "concentration",
        "enzyme_class",
        "missing",
        "sample_name",
        "protein_name_camel",
        "sample_composition",
        "SampleEntity_at_id"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/BioChemEntity",
      "@type": "ClassDefinition"
    },
    {
      "name": "InstrumentEntity",
      "definition_uri": "http://w3id.org/lambda/rocrate/InstrumentEntity",
      "description": "The equipment that produced the data. Instrument *capabilities* belong here; the values actually measured belong on the experiment run or the result summary.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:IndividualProduct"
      ],
      "exact_mappings": [
        "lambda:Instrument"
      ],
      "is_a": "CrateEntity",
      "slots": [
        "at_type",
        "name",
        "description",
        "InstrumentEntity_instrument_code",
        "instrument_category",
        "beamline_id",
        "facility_name",
        "facility_ror",
        "manufacturer",
        "model",
        "detector",
        "vocab_entry",
        "InstrumentEntity_at_id"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/IndividualProduct",
      "@type": "ClassDefinition"
    },
    {
      "name": "ExperimentRunAction",
      "definition_uri": "http://w3id.org/lambda/rocrate/ExperimentRunAction",
      "description": "A data-collection session, typed `[\"Action\", \"lambda:ExperimentRun\"]`. `object` names the sample, `result` names what was collected, `instrument` names the equipment.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:Action"
      ],
      "exact_mappings": [
        "lambda:ExperimentRun"
      ],
      "is_a": "CrateEntity",
      "slots": [
        "at_type",
        "name",
        "description",
        "ExperimentRunAction_experiment_code",
        "ExperimentRunAction_technique",
        "experiment_date",
        "collection_mode",
        "beamline_id",
        "object",
        "result",
        "instrument",
        "agent",
        "start_time",
        "end_time",
        "prov_used",
        "prov_generated",
        "was_informed_by",
        "qualified_association",
        "started_at_time",
        "ended_at_time",
        "run_parameters",
        "raw_data_location",
        "processing_status",
        "missing",
        "ExperimentRunAction_at_id"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/Action",
      "@type": "ClassDefinition"
    },
    {
      "name": "WorkflowRunAction",
      "definition_uri": "http://w3id.org/lambda/rocrate/WorkflowRunAction",
      "description": "A computational run that produced derived data, typed `[\"CreateAction\", \"lambda:WorkflowRun\"]`. `object` names the inputs, `result` the outputs, `instrument` the software. The SSRL 0.2 crates already use `CreateAction` for this and need no alias.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:CreateAction"
      ],
      "exact_mappings": [
        "lambda:WorkflowRun"
      ],
      "is_a": "CrateEntity",
      "slots": [
        "at_type",
        "name",
        "description",
        "workflow_code",
        "workflow_type",
        "software_name",
        "software_version",
        "object",
        "result",
        "instrument",
        "agent",
        "start_time",
        "end_time",
        "prov_used",
        "prov_generated",
        "was_informed_by",
        "qualified_association",
        "started_at_time",
        "ended_at_time",
        "run_parameters",
        "processing_level",
        "result_summary",
        "designated",
        "estimator",
        "missing",
        "workflow_run_id",
        "run_definition",
        "WorkflowRunAction_at_id"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/CreateAction",
      "@type": "ClassDefinition"
    },
    {
      "name": "PersonEntity",
      "definition_uri": "http://w3id.org/lambda/rocrate/PersonEntity",
      "description": "A person - PI, author, operator, analyst, or the decider of a designation. `@id` SHOULD be an ORCID, which is also what `lambda:orcid` carries in the projected record.\n`role` states the capacity in which the person is attached to *this* crate's work, drawn from the schema's `PersonRoleEnum`. In the projected record that capacity lives on an association (`StudyPersonAssociation` and friends) rather than on the person, because a person commonly holds several roles across one dataset and only one record of them should exist.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:Person"
      ],
      "exact_mappings": [
        "lambda:Person"
      ],
      "is_a": "CrateEntity",
      "slots": [
        "at_type",
        "name",
        "description",
        "orcid",
        "full_name",
        "given_name",
        "family_name",
        "email",
        "affiliation",
        "affiliation_ror",
        "role",
        "author_position",
        "corresponding",
        "missing",
        "PersonEntity_at_id"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/Person",
      "@type": "ClassDefinition"
    },
    {
      "name": "OrganizationEntity",
      "definition_uri": "http://w3id.org/lambda/rocrate/OrganizationEntity",
      "description": "A facility, laboratory, institution or funding body. `@id` SHOULD be a ROR identifier.\nAn organization appears once in the graph and is referred to by `@id` from everywhere else \u2014 the root's `publisher`, an instrument's facility, a person's affiliation. That is the whole point of a contextual entity, and it is what the schema's `Organization` class now mirrors.\n`role` states the capacity in which the organization is attached to this crate's work. As with `PersonEntity`, that capacity lives on an association in the projected record (`StudyOrganizationAssociation`, `PersonOrganizationAssociation`), not on the organization.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:Organization"
      ],
      "exact_mappings": [
        "lambda:Organization"
      ],
      "is_a": "CrateEntity",
      "slots": [
        "at_type",
        "description",
        "url",
        "identifier",
        "ror",
        "acronym",
        "organization_type",
        "facility_code",
        "facility_type",
        "parent_organization",
        "location",
        "country",
        "is_doe_facility",
        "doe_office",
        "organization_role",
        "award_number",
        "missing",
        "OrganizationEntity_at_id",
        "OrganizationEntity_name"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/Organization",
      "@type": "ClassDefinition"
    },
    {
      "name": "SoftwareApplicationEntity",
      "definition_uri": "http://w3id.org/lambda/rocrate/SoftwareApplicationEntity",
      "description": "Software used by a workflow run, named so a reader can reproduce the processing.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:SoftwareApplication"
      ],
      "is_a": "CrateEntity",
      "slots": [
        "at_type",
        "description",
        "version",
        "software_version_schemaorg",
        "url",
        "SoftwareApplicationEntity_at_id",
        "SoftwareApplicationEntity_name"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/SoftwareApplication",
      "@type": "ClassDefinition"
    },
    {
      "name": "DefinedTermEntity",
      "definition_uri": "http://w3id.org/lambda/rocrate/DefinedTermEntity",
      "description": "A controlled-vocabulary term used by reference - a facility, a technique. Carrying facility and technique as `DefinedTerm` entities rather than bare strings is what lets a federated index join across crates; the SSRL 0.2 crates already do this.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:DefinedTerm"
      ],
      "is_a": "CrateEntity",
      "slots": [
        "at_type",
        "description",
        "term_code",
        "in_defined_term_set",
        "url",
        "DefinedTermEntity_at_id",
        "DefinedTermEntity_name"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/DefinedTerm",
      "@type": "ClassDefinition"
    },
    {
      "name": "PropertyValueEntity",
      "definition_uri": "http://w3id.org/lambda/rocrate/PropertyValueEntity",
      "description": "A typed identifier or measurement, used for `identifier` entries so that a UUID, a DOI and a facility-local accession can coexist without ambiguity about which is which.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:PropertyValue"
      ],
      "is_a": "CrateEntity",
      "slots": [
        "at_id",
        "at_type",
        "name",
        "description",
        "property_id",
        "property_value",
        "unit_text",
        "unit_code"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/PropertyValue",
      "@type": "ClassDefinition"
    },
    {
      "name": "RelatedWork",
      "definition_uri": "http://w3id.org/lambda/rocrate/RelatedWork",
      "description": "Related published work - a PDB or SASBDB entry, a paper, a complementary dataset in another technique's crate. Linked, never inlined: a crystal structure belongs in its own MX crate.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "sdo:CreativeWork"
      ],
      "is_a": "CrateEntity",
      "slots": [
        "at_id",
        "at_type",
        "name",
        "description",
        "url",
        "identifier",
        "pdb_code",
        "resolution_angstrom",
        "conforms_to"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/CreativeWork",
      "@type": "ClassDefinition"
    },
    {
      "name": "MissingValueDeclaration",
      "definition_uri": "http://w3id.org/lambda/rocrate/MissingValueDeclaration",
      "description": "A **declared absence**. The profile's central honesty rule: a value that the pipeline could not obtain is recorded as missing, with a reason and the sufficiency tier it blocks. It is never silently omitted, and never faked with an empty stand-in.\nGeneralized from the LAMBDA SAXS profile so that every technique extension binds to one vocabulary of absence instead of inventing its own.",
      "comments": [
        "`blocks` is required in practice for every reason except `not-applicable`, which by definition blocks nothing - a field that does not apply to the technique is not a gap. The conformance checker enforces that conditional; JSON Schema cannot, because the condition is on a sibling value."
      ],
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "slots": [
        "MissingValueDeclaration_field",
        "MissingValueDeclaration_reason",
        "blocks",
        "note"
      ],
      "slot_usage": {},
      "class_uri": "http://w3id.org/lambda/rocrate/MissingValueDeclaration",
      "@type": "ClassDefinition"
    },
    {
      "name": "SufficiencyReport",
      "definition_uri": "http://w3id.org/lambda/rocrate/SufficiencyReport",
      "description": "Which sufficiency tiers this crate meets. Makes the tiering machine-readable so a federated search can *gate* filters rather than silently returning crates that cannot answer them: a \"crates I can reprocess\" query requires `s2AcquisitionComplete`, and a crate that published only processed results correctly drops out instead of appearing and then disappointing.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "slots": [
        "s1_findable",
        "s2_core_complete",
        "s2_acquisition_complete",
        "s3_interpretable"
      ],
      "slot_usage": {},
      "class_uri": "http://w3id.org/lambda/rocrate/SufficiencyReport",
      "@type": "ClassDefinition"
    },
    {
      "name": "Designation",
      "definition_uri": "http://w3id.org/lambda/rocrate/Designation",
      "description": "One designated result, with the provenance of the choice published. Where several defensible results exist, naming which one is *the* result - and by what rule, and who or what decided - is what makes the crate's summary numbers mean something.\nTyped `[\"lambdarc:Designation\", \"prov:Activity\"]`, because that is what a designation *is*: an activity that used some inputs, generated a designated output, and was carried out by an agent acting under a plan. Modelling it as PROV rather than as flat `decidedBy` / `decidedAt` slots means the agent, the plan it followed, and who it acted on behalf of are all first-class and readable by any PROV-aware tool - and it removes the need for a `mode` flag, since a `prov:SoftwareAgent` and a `prov:Person` are already different things.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "prov:Activity"
      ],
      "slots": [
        "at_type",
        "prov_used",
        "Designation_prov_generated",
        "selection",
        "species",
        "Designation_qualified_association",
        "started_at_time",
        "ended_at_time"
      ],
      "slot_usage": {},
      "class_uri": "http://www.w3.org/ns/prov#Activity",
      "@type": "ClassDefinition"
    },
    {
      "name": "Association",
      "definition_uri": "http://w3id.org/lambda/rocrate/Association",
      "description": "Who or what carried out an activity, and under which published plan. The `prov:hadPlan` link is the part that matters for conformance: an agent acting under a versioned, resolvable rule is provenance, and an unattributed choice is not.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "prov:Association"
      ],
      "slots": [
        "at_type",
        "Association_prov_agent",
        "had_plan"
      ],
      "slot_usage": {},
      "class_uri": "http://www.w3.org/ns/prov#Association",
      "@type": "ClassDefinition"
    },
    {
      "name": "Agent",
      "definition_uri": "http://w3id.org/lambda/rocrate/Agent",
      "description": "A person, piece of software or organization that acted. Typed more specifically as `prov:Person`, `prov:SoftwareAgent` or `prov:Organization` where known - which is what tells a reader whether a human or a tool made a choice.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "prov:Agent"
      ],
      "slots": [
        "at_id",
        "at_type",
        "name",
        "version",
        "acted_on_behalf_of"
      ],
      "slot_usage": {},
      "class_uri": "http://www.w3.org/ns/prov#Agent",
      "@type": "ClassDefinition"
    },
    {
      "name": "Derivation",
      "definition_uri": "http://w3id.org/lambda/rocrate/Derivation",
      "description": "Where a single reported value came from: which artefact it was read out of, and which field within it. Attaches to the value rather than to the crate, so a reader tracing one number does not have to work out which of several source files it came from.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "prov:Derivation"
      ],
      "slots": [
        "at_type",
        "prov_entity",
        "source_field"
      ],
      "slot_usage": {},
      "class_uri": "http://www.w3.org/ns/prov#Derivation",
      "@type": "ClassDefinition"
    },
    {
      "name": "EstimatorDescriptor",
      "definition_uri": "http://w3id.org/lambda/rocrate/EstimatorDescriptor",
      "description": "What produced a derived number, and how far it may be trusted. Any qualifying statistic in a crate travels with one of these: two numbers computed under different definitions are different quantities, however alike their labels look.\nThe producing software is named with `prov:wasAttributedTo` pointing at a `prov:SoftwareAgent` rather than as bare `software` / `version` strings, so the same agent can be referenced by every estimate it produced instead of being retyped beside each one.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "slots": [
        "was_attributed_to",
        "software",
        "version",
        "source_field",
        "EstimatorDescriptor_definition",
        "EstimatorDescriptor_admissibility"
      ],
      "slot_usage": {},
      "class_uri": "http://w3id.org/lambda/rocrate/EstimatorDescriptor",
      "@type": "ClassDefinition"
    },
    {
      "name": "VocabularyGap",
      "definition_uri": "http://w3id.org/lambda/rocrate/VocabularyGap",
      "description": "A value the source really carries that the schema's controlled vocabulary cannot express yet.\nSilently coercing such a value to the nearest permissible term is the worst option: it looks like data and is wrong, and nothing downstream can tell. Dropping it is not much better. This records the local value against the enum it belongs in, so the crate stays honest and the gap becomes a change request with evidence attached rather than an anecdote.\nAdopted from Peter Zwart's SAXS drafts, where a decommissioned beamline (`DORIS3_X33`) had no `BeamlineEnum` term and the crate said so.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "slots": [
        "module",
        "VocabularyGap_enum_name",
        "VocabularyGap_key",
        "version",
        "note"
      ],
      "slot_usage": {},
      "class_uri": "http://w3id.org/lambda/rocrate/VocabularyGap",
      "@type": "ClassDefinition"
    },
    {
      "name": "SchemaSetEntry",
      "definition_uri": "http://w3id.org/lambda/rocrate/SchemaSetEntry",
      "description": "Pins exactly which schema and profile versions a crate was built against, with a hash, so a reader can tell whether a surprising field is a bug or a version difference.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "slots": [
        "SchemaSetEntry_module",
        "SchemaSetEntry_version",
        "sha256"
      ],
      "slot_usage": {},
      "class_uri": "http://w3id.org/lambda/rocrate/SchemaSetEntry",
      "@type": "ClassDefinition"
    },
    {
      "name": "NamedThing",
      "definition_uri": "http://w3id.org/lambda/NamedThing",
      "description": "A named thing",
      "from_schema": "http://w3id.org/lambda/",
      "abstract": true,
      "slots": [
        "namedThing__id",
        "namedThing__title",
        "namedThing__description"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "id",
          "description": "Globally unique identifier as an IRI or CURIE for machine processing and external references. Used for linking data across systems and semantic web integration.",
          "identifier": true,
          "range": "uriorcurie",
          "@type": "SlotDefinition"
        },
        {
          "name": "title",
          "description": "A human-readable name or title for this entity",
          "slot_uri": "dcterms:title",
          "@type": "SlotDefinition"
        },
        {
          "name": "description",
          "description": "A detailed textual description of this entity",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://w3id.org/lambda/NamedThing",
      "@type": "ClassDefinition"
    },
    {
      "name": "AttributeGroup",
      "definition_uri": "http://w3id.org/lambda/AttributeGroup",
      "description": "A grouping of related data attributes that form a logical unit",
      "from_schema": "http://w3id.org/lambda/",
      "abstract": true,
      "slots": [
        "attributeGroup__description"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "description",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://w3id.org/lambda/AttributeGroup",
      "@type": "ClassDefinition"
    },
    {
      "name": "Dataset",
      "definition_uri": "http://w3id.org/lambda/Dataset",
      "description": "Root container holding flat entity collections and association tables. Follows relational database design patterns for structural biology data.",
      "from_schema": "http://w3id.org/lambda/",
      "related_mappings": [
        "IHMCIF:_ihm_entry_collection",
        "IHMCIF:_ihm_dataset_group"
      ],
      "is_a": "NamedThing",
      "slots": [
        "namedThing__id",
        "namedThing__title",
        "namedThing__description",
        "dataset__keywords",
        "dataset__studies",
        "dataset__persons",
        "dataset__organizations",
        "dataset__instruments",
        "dataset__protein_constructs",
        "dataset__samples",
        "dataset__sample_preparations",
        "dataset__experiment_runs",
        "dataset__workflow_runs",
        "dataset__data_files",
        "dataset__images",
        "dataset__study_sample_associations",
        "dataset__study_experiment_associations",
        "dataset__study_workflow_associations",
        "dataset__experiment_sample_associations",
        "dataset__experiment_instrument_associations",
        "dataset__workflow_experiment_associations",
        "dataset__workflow_input_associations",
        "dataset__workflow_output_associations",
        "dataset__study_person_associations",
        "dataset__experiment_person_associations",
        "dataset__workflow_person_associations",
        "dataset__study_organization_associations",
        "dataset__person_organization_associations"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "keywords",
          "description": "Keywords or tags describing the dataset for search and categorization",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "studies",
          "description": "All studies in this dataset",
          "range": "Study",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "persons",
          "description": "All people referenced anywhere in this dataset",
          "range": "Person",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "organizations",
          "description": "All organizations referenced anywhere in this dataset",
          "range": "Organization",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "instruments",
          "description": "All instruments used across studies",
          "range": "Instrument",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "protein_constructs",
          "description": "All protein constructs",
          "range": "ProteinConstruct",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "samples",
          "description": "All samples across all studies",
          "range": "Sample",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "sample_preparations",
          "description": "All sample preparations",
          "range": "SamplePreparation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "experiment_runs",
          "description": "All experiment runs (data collection sessions)",
          "range": "ExperimentRun",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "workflow_runs",
          "description": "All workflow runs (computational processing)",
          "range": "WorkflowRun",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "data_files",
          "description": "All data files",
          "range": "DataFile",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "images",
          "description": "All images",
          "range": "Image",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "study_sample_associations",
          "description": "Links between studies and samples (M:N)",
          "range": "StudySampleAssociation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "study_experiment_associations",
          "description": "Links between studies and experiments (M:N)",
          "range": "StudyExperimentAssociation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "study_workflow_associations",
          "description": "Links between studies and workflows (M:N)",
          "range": "StudyWorkflowAssociation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "experiment_sample_associations",
          "description": "Links between experiments and samples (M:N with role)",
          "range": "ExperimentSampleAssociation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "experiment_instrument_associations",
          "description": "Links between experiments and instruments (M:N)",
          "range": "ExperimentInstrumentAssociation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "workflow_experiment_associations",
          "description": "Links between workflows and source experiments (M:N)",
          "range": "WorkflowExperimentAssociation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "workflow_input_associations",
          "description": "Links between workflows and input files",
          "range": "WorkflowInputAssociation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "workflow_output_associations",
          "description": "Links between workflows and output files",
          "range": "WorkflowOutputAssociation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "study_person_associations",
          "description": "Links between studies and people (M:N with role) - where authorship lives",
          "range": "StudyPersonAssociation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "experiment_person_associations",
          "description": "Links between experiment runs and people (M:N with role)",
          "range": "ExperimentPersonAssociation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "workflow_person_associations",
          "description": "Links between workflow runs and people (M:N with role)",
          "range": "WorkflowPersonAssociation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "study_organization_associations",
          "description": "Links between studies and organizations (M:N with role, award number)",
          "range": "StudyOrganizationAssociation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "person_organization_associations",
          "description": "Links between people and organizations (M:N with role and dates)",
          "range": "PersonOrganizationAssociation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://w3id.org/lambda/Dataset",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "Study",
      "definition_uri": "http://w3id.org/lambda/Study",
      "description": "A logical grouping of related experiments investigating a research question. In the relational model, Study is lightweight - all relationships are via association tables.",
      "from_schema": "http://w3id.org/lambda/",
      "related_mappings": [
        "IHMCIF:_ihm_entry_collection",
        "IHMCIF:_ihm_entry_collection_mapping"
      ],
      "is_a": "NamedThing",
      "slots": [
        "namedThing__id",
        "namedThing__title",
        "namedThing__description",
        "study__proposal_id",
        "study__keywords"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "proposal_id",
          "description": "Facility proposal or project identifier associated with this study (e.g., a DOE or facility allocation ID)",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "keywords",
          "description": "Keywords or tags describing the study for search and categorization",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://w3id.org/lambda/Study",
      "@type": "ClassDefinition"
    },
    {
      "name": "Person",
      "definition_uri": "http://w3id.org/lambda/Person",
      "description": "A person involved in producing, processing or publishing data - a principal investigator, beamline operator, data analyst or curator. In the relational model, Person is lightweight: which study, experiment or workflow a person is attached to, and in what capacity, is carried by the person association tables in Dataset, so one person record serves every role they hold across a dataset.",
      "comments": [
        "No slot is required beyond the inherited id. An ORCID alone is a complete identification of a person, and a source that publishes only a name is equally common - so neither can be insisted upon. Where a name is genuinely unavailable, record that fact rather than substituting the identifier for it."
      ],
      "from_schema": "http://w3id.org/lambda/",
      "exact_mappings": [
        "prov:Agent"
      ],
      "is_a": "NamedThing",
      "slots": [
        "namedThing__id",
        "namedThing__title",
        "namedThing__description",
        "person__orcid",
        "person__full_name",
        "person__given_name",
        "person__family_name",
        "person__email",
        "person__affiliation",
        "person__affiliation_ror",
        "person__person_local_id"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "orcid",
          "description": "ORCID identifier for the person",
          "comments": [
            "Persistent identifier for the individual; the preferred way to identify a person",
            "Example: https://orcid.org/0000-0002-1885-1511"
          ],
          "range": "uriorcurie",
          "pattern": "^https://orcid\\.org/\\d{4}-\\d{4}-\\d{4}-\\d{3}[0-9X]$",
          "@type": "SlotDefinition"
        },
        {
          "name": "full_name",
          "description": "Full formal name of the person, as they write it in publications",
          "comments": [
            "Overlaps the inherited `title`, deliberately but not redundantly. `title` is the display label every NamedThing carries and is what a listing shows (\"Clyde Smith\"); `full_name` is the formal name a citation needs (\"Clyde A. Smith\"). They are equal often enough that a consumer reading only one is usually fine, so record `title` whenever `full_name` is known - a Person with a formal name and no display label is awkward for every UI that treats NamedThing uniformly.",
            "Where the two would be identical, carrying only `title` is correct and `full_name` adds nothing."
          ],
          "close_mappings": [
            "lambda:title"
          ],
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "given_name",
          "description": "Given (personal) name, where the name has been parsed into parts",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "family_name",
          "description": "Family name, where the name has been parsed into parts",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "email",
          "description": "Contact email address",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "affiliation",
          "description": "Institution the person is affiliated with",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "affiliation_ror",
          "description": "Research Organization Registry (ROR) identifier for the affiliated institution",
          "comments": [
            "Free-text convenience, retained for sources that publish only an affiliation string. Where the institution can be resolved, prefer an Organization record linked by PersonOrganizationAssociation, which can carry more than one affiliation and date them."
          ],
          "range": "uriorcurie",
          "pattern": "^https://ror\\.org/\\w+$",
          "@type": "SlotDefinition"
        },
        {
          "name": "person_local_id",
          "description": "Facility-local user or badge identifier, where one exists",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://w3id.org/lambda/Person",
      "@type": "ClassDefinition"
    },
    {
      "name": "Organization",
      "definition_uri": "http://w3id.org/lambda/Organization",
      "description": "An institution, facility, laboratory or funding body - a national laboratory, a university, a light source, an agency that funded the work.\nThis is the structured home for organizational identity that the schema otherwise carries as unvalidated free text in three places: the annotations on FacilityEnum permissible values (`parent_organization`, `parent_ror`, `location`, `country`, `doe_office`, `website`, `wikidata_id`), Instrument's `facility_name` / `facility_ror` pair, and Person's `affiliation` / `affiliation_ror` pair. FacilityEnum remains the controlled vocabulary that says *which* facility something is; Organization is the record that says what that facility is, where, and who runs it - and lets a parent institution be stated once rather than restated by every entity that refers to it.",
      "comments": [
        "As with Person, nothing beyond the inherited id is required: a ROR alone identifies an organization completely, and a source that gives only a name is common."
      ],
      "from_schema": "http://w3id.org/lambda/",
      "exact_mappings": [
        "prov:Organization"
      ],
      "is_a": "NamedThing",
      "slots": [
        "namedThing__id",
        "namedThing__title",
        "namedThing__description",
        "organization__ror",
        "organization__acronym",
        "organization__organization_type",
        "organization__facility_code",
        "organization__facility_type",
        "organization__parent_organization_id",
        "organization__location",
        "organization__country",
        "organization__website",
        "organization__wikidata_id",
        "organization__is_doe_facility",
        "organization__doe_office"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "ror",
          "description": "Research Organization Registry (ROR) identifier for the organization",
          "comments": [
            "The preferred way to identify an organization",
            "Every FacilityEnum permissible value already carries its ROR as the term's meaning",
            "Example: https://ror.org/02jbv0t02 (Lawrence Berkeley National Laboratory)"
          ],
          "range": "uriorcurie",
          "pattern": "^https://ror\\.org/\\w+$",
          "@type": "SlotDefinition"
        },
        {
          "name": "acronym",
          "description": "Short name or acronym, e.g. 'LBNL', 'SSRL', 'PNNL'",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "organization_type",
          "description": "What kind of organization this is",
          "range": "OrganizationTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "facility_code",
          "description": "The FacilityEnum term this organization corresponds to, where it is one of the facilities the schema already names. Ties the record to the search vocabulary.",
          "range": "FacilityEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "facility_type",
          "description": "For a research facility, the kind of facility it is",
          "range": "FacilityTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "parent_organization_id",
          "description": "The organization this one belongs to - a light source's national laboratory, a department's university. Self-referential, as Sample.parent_sample_id is.",
          "range": "Organization",
          "@type": "SlotDefinition"
        },
        {
          "name": "location",
          "description": "Free-text location, e.g. 'Berkeley, California, USA'",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "country",
          "description": "Country the organization is located in",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "website",
          "description": "Organization or facility website",
          "range": "uriorcurie",
          "@type": "SlotDefinition"
        },
        {
          "name": "wikidata_id",
          "description": "Wikidata entity identifier, where one exists",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "is_doe_facility",
          "description": "Whether this is a US Department of Energy facility",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "doe_office",
          "description": "Sponsoring DOE office, e.g. 'Office of Science'",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://w3id.org/lambda/Organization",
      "@type": "ClassDefinition"
    },
