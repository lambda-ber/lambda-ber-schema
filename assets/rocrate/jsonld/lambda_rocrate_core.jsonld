    {
      "name": "Designation_qualified_association",
      "definition_uri": "http://w3id.org/lambda/rocrate/qualified_association",
      "description": "Who carried out an activity and under which plan. Qualified rather than a bare `prov:wasAssociatedWith` precisely so the plan can travel with the agent.\nMultivalued, because PROV does not make this functional and real activities have more than one responsible party: a collection session has an operator *and* a local contact, and a processing run may be attributed to both a person and the policy they ran under. Forcing a single association would silently discard whichever agent the builder happened to write second.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://www.w3.org/ns/prov#qualifiedAssociation"
      ],
      "is_a": "qualified_association",
      "domain": "Designation",
