          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "fsc_value",
          "description": "FSC values corresponding to each resolution",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://w3id.org/lambda/FSCCurve",
      "@type": "ClassDefinition"
    },
