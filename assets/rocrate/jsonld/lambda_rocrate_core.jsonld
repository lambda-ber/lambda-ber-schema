      "mappings": [
        "http://w3id.org/lambda/rocrate/provenance"
      ],
      "slot_uri": "http://w3id.org/lambda/rocrate/provenance",
      "owner": "CrateFile",
      "domain_of": [
        "CrateFile"
      ],
      "range": "Derivation",
      "inlined": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "vocab_entry",
      "definition_uri": "http://w3id.org/lambda/rocrate/vocab_entry",
      "description": "Declared gaps in a controlled vocabulary. The enum equivalent of declared absence: where a real value has no permissible value to carry it, say so rather than silently coercing it to the nearest wrong term or dropping it.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://w3id.org/lambda/rocrate/vocabEntry"
      ],
      "close_mappings": [
        "https://lambda-ber.github.io/lambda-ber-schema/profile/saxs/0.4.0/terms/vocabEntry"
      ],
      "slot_uri": "http://w3id.org/lambda/rocrate/vocabEntry",
      "alias": "vocabEntry",
      "owner": "InstrumentEntity",
      "domain_of": [
        "CrateRoot",
        "InstrumentEntity"
      ],
      "range": "VocabularyGap",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "field",
      "definition_uri": "http://w3id.org/lambda/rocrate/field",
      "description": "The field or artefact that is absent, named as it would have appeared.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
        "http://w3id.org/lambda/rocrate/field"
      ],
      "slot_uri": "http://w3id.org/lambda/rocrate/field",
      "owner": "MissingValueDeclaration",
      "domain_of": [
        "MissingValueDeclaration"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "reason",
      "definition_uri": "http://w3id.org/lambda/rocrate/reason",
      "description": "Why it is absent.",
      "from_schema": "http://w3id.org/lambda/rocrate/core",
      "mappings": [
